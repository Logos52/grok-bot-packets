<script>(function(){
try{
var d=document.documentElement,p={};
try{
  var raw=localStorage.getItem('ted-prefs');
  if(raw){var q=JSON.parse(raw);if(q&&typeof q==='object')p=q;}
}catch(e){}
var params=new URLSearchParams(location.search);
var GM={en:'en',vi:'vi'},RM={py:'pinyin',zy:'zhuyin',hv:'hanviet'},SM={trad:'trad',simp:'simp'};
function urlv(k,m){var v=params.get(k);return (v!=null&&m[v])?m[v]:null;}
function viLang(){
  try{
    var ls=(navigator.languages&&navigator.languages.length)?navigator.languages:[navigator.language||''];
    for(var i=0;i<ls.length;i++){if(/^vi/i.test(ls[i]))return true;}
  }catch(e){}
  return false;
}
d.dataset.gloss=urlv('g',GM)||p.g||(viLang()?'vi':'en');
d.dataset.reading=urlv('r',RM)||p.r||'pinyin';
var locked=d.getAttribute('data-script-locked')==='1';
d.dataset.script=urlv('s',SM)||(locked?(d.dataset.script||'trad'):(p.s||d.dataset.script||'trad'));
d.dataset.theme=p.theme||'light';
}catch(e){}
})();</script>
