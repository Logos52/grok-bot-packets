<script>
(function(){
  function tsuReadTheme(){
  try{
    var raw=localStorage.getItem("tsumugu.core.prefs");
    if(raw){var p=JSON.parse(raw);if(p&& (p.theme==="dark"||p.theme==="light"))return p.theme;}
    var m=localStorage.getItem("tsumugu.prefs.v1");
    if(m){var q=JSON.parse(m);if(q&&(q.theme==="dark"||q.theme==="light"))return q.theme;}
    var t=localStorage.getItem("tsu-theme");
    if(t==="dark"||t==="light")return t;
  }catch(e){}
  return "light";
}
  function tsuWriteTheme(theme){
  try{
    localStorage.setItem("tsu-theme",theme);
    var raw=localStorage.getItem("tsumugu.core.prefs");
    var p=raw?JSON.parse(raw):{};
    if(!p||typeof p!=="object")p={};
    p.theme=theme;
    localStorage.setItem("tsumugu.core.prefs",JSON.stringify(p));
    var mraw=localStorage.getItem("tsumugu.prefs.v1");
    var m=mraw?JSON.parse(mraw):{v:1};
    if(!m||typeof m!=="object")m={v:1};
    m.theme=theme;
    m.updatedAt=new Date().toISOString();
    localStorage.setItem("tsumugu.prefs.v1",JSON.stringify(m));
  }catch(e){}
}
  var root=document.documentElement, btn=document.getElementById("themeBtn");
  if(!btn) return;
  // Re-apply in case FOUC missed (e.g. cached shell without script).
  root.setAttribute("data-theme", tsuReadTheme());
  function sync(){ btn.textContent = root.getAttribute("data-theme")==="dark" ? "\u2600" : "\u263e"; }
  sync();
  btn.addEventListener("click",function(){
    var next = root.getAttribute("data-theme")==="dark" ? "light" : "dark";
    root.setAttribute("data-theme",next);
    tsuWriteTheme(next);
    sync();
  });
})();
</script>
