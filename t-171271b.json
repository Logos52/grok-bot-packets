eaders_count":1,"score":0.4,"yours":false,"topic_id":171271,"topic_slug":"unable-to-reset-or-reconnect-0-47-0-grokbot","display_username":"Catme1008","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":137775,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/unable-to-reset-or-reconnect-0-47-0-grokbot/171271/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":491162,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-14T19:12:04.494Z","cooked":"\u003cp\u003eHey, thanks for the report. What you’re describing isn’t related to your phone or network. The Grok Bot machine stopped responding, and our system automatically started recreating it. The replacement came up fine, but the transfer from the old machine got stuck. That’s why reconnect won’t go through, and Reset says the machine is busy with another action.\u003c/p\u003e\n\u003cp\u003eYour bots, files, and logins are safe, nothing will be lost. There’s no point in spamming Reset, Recover, or reinstalling, it won’t speed things up.\u003c/p\u003e\n\u003cp\u003eSome time has passed since your report, and these situations usually resolve on their own. Please open Grok Bot again and check if it connects now. If you still see the same error, send me the exact time you tried (with your time zone), and I’ll pass it on.\u003c/p\u003e","post_number":7