  }, {
    "tStartMs": 251651,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "do this over\nthe course of two decades"
    } ]
  }, {
    "tStartMs": 253353,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "is only one half\nof a very interesting story."
    } ]
  }, {
    "tStartMs": 256222,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "The other half?"
    } ]
  }, {
    "tStartMs": 257390,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Did you know rare"
    } ]
  }, {
    "tStartMs": 258825,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "earths aren't actually rare?"
    } ]
  }, {
    "tStartMs": 260460,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "China\ndid not build its monopoly"
    } ]
  }, {
    "tStartMs": 262428,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "because it's the only one\nthat has these rare earths."
    } ]
  }, {
    "tStartMs": 264664,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "China built its monopoly"
    } ]
  }, {
    "tStartMs": 265898,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "by doing the thing\nno one else wanted to."
    } ]
  }, {
    "tStartMs": 268301,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "Separating them\nfrom the dirt and rocks"
