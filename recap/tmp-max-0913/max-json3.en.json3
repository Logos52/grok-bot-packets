      "utf8": "They just can't\npull the half"
    } ]
  }, {
    "tStartMs": 963829,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "finished metal out of China\nthe way they used to."
    } ]
  }, {
    "tStartMs": 965831,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "So they hire a Chinese plant\nto make the magnet."
    } ]
  }, {
    "tStartMs": 968267,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "They hand over the drawings,\nthe quantities,"
    } ]
  }, {
    "tStartMs": 970069,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "the exact recipe,\nall the hard one."
    } ]
  }, {
    "tStartMs": 972271,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Know how that used to live\ninside"
    } ]
  }, {
    "tStartMs": 973672,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "a company in Detroit\nor Tokyo"
    } ]
  }, {
    "tStartMs": 975474,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "walks into a factory\nin China."
    } ]
  }, {
    "tStartMs": 977076,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "They didn't buy the secrets\nthe foreign company"
    } ]
  }, {
    "tStartMs": 979111,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "actually paid\nto hand them over."
    } ]
  }, {
    "tStartMs": 980713,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "Think about an iPhone."
    } ]
  }, {
    "tStartMs": 981814,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "Roughly $9 of raw materials."
    } ]
  }, {
    "tStartMs": 983916,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "The finished phone sells\nfor something"
    } ]
  }, {
    "tStartMs": 985384,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "like 120 times that."
    } ]
  }, {
    "tStartMs": 987019,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "The money is\nnot in the rock."
    } ]
  }, {
    "tStartMs": 988988,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "The money is in\nthe finished thing."
    } ]
  }, {
    "tStartMs": 990789,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "China closes the door\nto force its economy"
    } ]
  }, {
    "tStartMs": 993625,
    "dDurationMs": 1369,
    "segs": [ {
      "utf8": "to climb up the value"
    } ]
  }, {
    "tStartMs": 994994,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "from rock metal"
    } ]
  }, {
    "tStartMs": 996228,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "magnet to the product"
    } ]
  }, {
    "tStartMs": 997696,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "people actually buy."
    } ]
  }, {
    "tStartMs": 999098,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "Step four\nopen the door again."
    } ]
  }, {
    "tStartMs": 1001300,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Lawsuits and trade fights"
    } ]
  }, {
    "tStartMs": 1002701,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "against these kinds of moves\nChina makes."
    } ]
  }, {
    "tStartMs": 1004670,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "They always come,\nand they always take 3"
    } ]
  }, {
    "tStartMs": 1007006,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "to 5 years\nand China usually loses."
    } ]
  }, {
    "tStartMs": 1009108,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "They don't need to win\nthe court case."
    } ]
  }, {
    "tStartMs": 1010876,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "The key part is the time."
    } ]
  }, {
    "tStartMs": 1012077,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "It takes 3 to 5 years."
    } ]
  }, {
    "tStartMs": 1013912,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "China can set a watch by it."
    } ]
  }, {
    "tStartMs": 1015681,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "By the time those years"
    } ]
  }, {
    "tStartMs": 1016982,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "pass, much has changed."
    } ]
  }, {
    "tStartMs": 1018584,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "A lot of foreign competitors\nare bleeding by the end,"
    } ]
  }, {
    "tStartMs": 1020619,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "smothered by high prices"
    } ]
  }, {
    "tStartMs": 1021820,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "and new cheap competition."
    } ]
  }, {
    "tStartMs": 1023455,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "Meanwhile, Chinese plants\nhave absorbed"
    } ]
  }, {
    "tStartMs": 1025557,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "a huge amount of skills,\nknow how and data."
    } ]
  }, {
    "tStartMs": 1027626,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "But the high prices also did\nsomething"
    } ]
  }, {
    "tStartMs": 1029895,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "China does not want long\nterm."
    } ]
  }, {
    "tStartMs": 1031597,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "They tempted new mines\nand refiners"
    } ]
  }, {
    "tStartMs": 1033265,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "to open in Canada,\nAustralia, the US."
    } ]
  }, {
    "tStartMs": 1035467,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "So when the door swings\nwide open"
    } ]
  }, {
    "tStartMs": 1037503,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "supply pours onto the world."
    } ]
  }, {
    "tStartMs": 1038937,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "That price is so low\nthe new guys can't dig rock"
    } ]
  }, {
    "tStartMs": 1041573,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "for less than China's\nselling finished material."
    } ]
  }, {
    "tStartMs": 1043776,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "Company after company"
    } ]
  }, {
    "tStartMs": 1044977,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "goes under inside"
    } ]
  }, {
    "tStartMs": 1046378,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "China,\nwhat started as dozens"
    } ]
  }, {
    "tStartMs": 1047813,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "or hundreds of companies,\nthey all get"
    } ]
  }, {
    "tStartMs": 1049481,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "folded and merged\ninto a couple"
    } ]
  }, {
    "tStartMs": 1050783,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "of giant state run"
    } ]
  }, {
    "tStartMs": 1052051,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "champions for rare earths."
    } ]
  }, {
    "tStartMs": 1053619,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "That's China Northern Rare\nEarth"
    } ]
  }, {
    "tStartMs": 1054820,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "Group and China\nRare Earth Group."
    } ]
  }, {
    "tStartMs": 1056355,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "So China ends up\nwith two giant state"
    } ]
  }, {
    "tStartMs": 1058457,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "champions on rare earths,"
    } ]
  }, {
    "tStartMs": 1060426,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "which sounds like\nthe end of the story."
    } ]
  }, {
    "tStartMs": 1061860,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "It is not."
    } ]
  }, {
    "tStartMs": 1062861,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "We are at the part\nwhere the story"
    } ]
  }, {
    "tStartMs": 1064663,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "gets smaller and stranger,\nbecause the piece of this"
    } ]
  }, {
    "tStartMs": 1067099,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "monopoly\nthat actually keeps people"
    } ]
  }, {
    "tStartMs": 1068667,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "in the military up at night"
    } ]
  }, {
    "tStartMs": 1069935,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "is not rare earths."
    } ]
  }, {
    "tStartMs": 1071270,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "As a category, it is a\nthin slice of the category,"
    } ]
  }, {
    "tStartMs": 1073839,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "a metal that does not\nshow up in the big,"
    } ]
  }, {
    "tStartMs": 1075340,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "shiny rare earth headline,\nthe way"
    } ]
  }, {
    "tStartMs": 1076708,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "neodymium does"
    } ]
  }, {
    "tStartMs": 1077943,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "a metal tied to a particular\nkind of dirty"
    } ]
  }, {
    "tStartMs": 1080312,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "ground in southern China."
    } ]
  }, {
    "tStartMs": 1081480,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "Sticky red clay country,"
    } ]
  }, {
    "tStartMs": 1082948,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "a much different thing\nfrom digging"
    } ]
  }, {
    "tStartMs": 1084483,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "or out of the ground\nin the north."
    } ]
  }, {
    "tStartMs": 1086118,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "Before\nI give you the name, now"
    } ]
  }, {
    "tStartMs": 1087519,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "picture the job\nit has to do."
    } ]
  }, {
    "tStartMs": 1089054,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "A cruise missile\nleaves a ship, it drops low."
    } ]
  }, {
    "tStartMs": 1091390,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "It flies\nfor hundreds of miles,"
    } ]
  }, {
    "tStartMs": 1092791,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "maybe thousands of miles,\nreading the terrain,"
    } ]
  }, {
    "tStartMs": 1094993,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "twitching\nits fins a degree at a time"
    } ]
  }, {
    "tStartMs": 1096562,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "so it can put itself\nthrough a window"
    } ]
  }, {
    "tStartMs": 1097896,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "or into a bunker\nwithout a pilot on board."
    } ]
  }, {
    "tStartMs": 1100265,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "Those little twitches\nare magnets, fighting"
    } ]
  }, {
    "tStartMs": 1102101,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "electricity and a tiny motor"
    } ]
  }, {
    "tStartMs": 1103502,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "at the base of each fin."
    } ]
  }, {
    "tStartMs": 1104736,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "And those magnets\nonly keep their strength"
    } ]
  }, {
    "tStartMs": 1106672,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "in these real world\nconditions."
    } ]
  }, {
    "tStartMs": 1108373,
    "dDurationMs": 768,
    "segs": [ {
      "utf8": "Heat, stress."
    } ]
  }, {
    "tStartMs": 1109141,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "Time if the recipe used to\nmake them includes this one"
    } ]
  }, {
    "tStartMs": 1112111,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "hard to get ingredient"
    } ]
  }, {
    "tStartMs": 1114880,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "overnight."
    } ]
  }, {
    "tStartMs": 1115814,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "And for the second day,\nthe American ship"
    } ]
  }, {
    "tStartMs": 1118717,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "launched their Tomahawk\ncruise missiles."
    } ]
  }, {
    "tStartMs": 1120819,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "100 of these were fired\nin the first 24 hours"
    } ]
  }, {
    "tStartMs": 1123188,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "of the Gulf\nWar, striking command"
    } ]
  }, {
    "tStartMs": 1124723,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "centers, air\ndefenses, and power stations"
    } ]
  }, {
    "tStartMs": 1126658,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "all across Iraq"
    } ]
  }, {
    "tStartMs": 1127693,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "well before any soldiers\nwere on the ground,"
    } ]
  }, {
    "tStartMs": 1129495,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "hitting the most heavily\ndefended targets in Iraq"
    } ]
  }, {
    "tStartMs": 1131497,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "without risking anyone\nthat night is the reason"
    } ]
  }, {
    "tStartMs": 1133732,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "the Tomahawk became\nthe missile"
    } ]
  }, {
    "tStartMs": 1134933,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "you see on the news."
    } ]
  }, {
    "tStartMs": 1135734,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "Most information\nabout them is classified,"
    } ]
  }, {
    "tStartMs": 1138237,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "but we know for sure"
    } ]
  }, {
    "tStartMs": 1139471,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "that to steer itself\nto the target,"
    } ]
  }, {
    "tStartMs": 1141106,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "each one needs\nat least 12 magnets."
    } ]
  }, {
    "tStartMs": 1143041,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "You will find them right\nat the base of each"
    } ]
  }, {
    "tStartMs": 1144576,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "fin, positioned inside\na coil of copper."
    } ]
  }, {
    "tStartMs": 1146612,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "Anytime\nthe computer on board says"
    } ]
  }, {
    "tStartMs": 1148147,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "we need to adjust course,\nelectricity flows"
    } ]
  }, {
    "tStartMs": 1150215,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "into the wire,\naround the magnets,"
    } ]
  }, {
    "tStartMs": 1151750,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "the rod they're connected to"
    } ]
  }, {
    "tStartMs": 1153018,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "turns\nand then holds its position."
    } ]
  }, {
    "tStartMs": 1155020,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "The rod isn't mechanically\nlocked into place."
    } ]
  }, {
    "tStartMs": 1157055,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "It's kept in that position"
    } ]
  }, {
    "tStartMs": 1158357,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "by keeping electricity"
    } ]
  }, {
    "tStartMs": 1159558,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "flowing through the wire."
    } ]
  }, {
    "tStartMs": 1163162,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "Energy can't be"
    } ]
  }, {
    "tStartMs": 1164096,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "created\nand it can't be destroyed."
    } ]
  }, {
    "tStartMs": 1165597,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "It can only be converted\nor transferred."
    } ]
  }, {
    "tStartMs": 1167533,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "This according to the first\nlaw of thermodynamics."
    } ]
  }, {
    "tStartMs": 1170102,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "So the electricity\nflowing in to hold that fin"
    } ]
  }, {
    "tStartMs": 1172471,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "in its new position, since\nit isn't moving anything,"
    } ]
  }, {
    "tStartMs": 1175073,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "it generates\nheat, a lot of it."
    } ]
  }, {
    "tStartMs": 1176909,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "And if there's one thing\nthat magnets"
    } ]
  }, {
    "tStartMs": 1178277,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "don't like, it is heat."
    } ]
  }, {
    "tStartMs": 1179745,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "As a magnet gets hotter,\nit loses power, get too hot,"
    } ]
  }, {
    "tStartMs": 1182414,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "and it can permanently\ndestroy the magnetic pole."
    } ]
  }, {
    "tStartMs": 1184950,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "So just like this motor,"
    } ]
  }, {
    "tStartMs": 1186552,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "we can get the same effect"
    } ]
  }, {
    "tStartMs": 1187753,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "with less powerful\nbut heavier magnets."
    } ]
  }, {
    "tStartMs": 1189922,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "These are ceramic magnets."
    } ]
  }, {
    "tStartMs": 1191456,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "They have no rare\nearths in them,"
    } ]
  }, {
    "tStartMs": 1193258,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "so for three times"
    } ]
  }, {
    "tStartMs": 1194493,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "the weight and three times"
    } ]
  }, {
    "tStartMs": 1195861,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "the size, we get"
    } ]
  }, {
    "tStartMs": 1197062,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "the same amount of power"
    } ]
  }, {
    "tStartMs": 1198330,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "as these neodymium magnets."
    } ]
  }, {
    "tStartMs": 1204136,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "You could"
    } ]
  }, {
    "tStartMs": 1204536,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "fight heat the same way."
    } ]
  }, {
    "tStartMs": 1205737,
    "dDurationMs": 334,
    "segs": [ {
      "utf8": "Okay."
    } ]
  }, {
    "tStartMs": 1206071,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "Loses about 50% power"
    } ]
  }, {
    "tStartMs": 1207506,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "after flying for an hour."
    } ]
  }, {
    "tStartMs": 1208774,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "We'll just double the size\nof the magnet."
    } ]
  }, {
    "tStartMs": 1210475,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "But in something\nso intricate"
    } ]
  }, {
    "tStartMs": 1211910,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "as a Tomahawk missile,\nwhere would you put it?"
    } ]
  }, {
    "tStartMs": 1213912,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "And even if you did"
    } ]
  }, {
    "tStartMs": 1215113,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "decide to do that,\nyou'd have to do all sorts"
    } ]
  }, {
    "tStartMs": 1216982,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "of new testing\ncertification."
    } ]
  }, {
    "tStartMs": 1218650,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "The process alone would be"
    } ]
  }, {
    "tStartMs": 1219985,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "a major hassle"
    } ]
  }, {
    "tStartMs": 1221186,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "to end up\nwith a worse missile."
    } ]
  }, {
    "tStartMs": 1222754,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "And this is just\none type of missile"
    } ]
  }, {
    "tStartMs": 1224556,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "the US military uses."
    } ]
  }, {
    "tStartMs": 1226058,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "It would be better instead\nif there was some magic"
    } ]
  }, {
    "tStartMs": 1228227,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "ingredient that made them\nheat resistant."
    } ]
  }, {
    "tStartMs": 1230395,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "Something like samarium."
    } ]
  }, {
    "tStartMs": 1232231,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "Sure enough, that's\nwhat the US military uses"
    } ]
  }, {
    "tStartMs": 1234600,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "for magnets, cutting"
    } ]
  }, {
    "tStartMs": 1235801,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "that temperature problem\nby 95%."
    } ]
  }, {
    "tStartMs": 1238103,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "And sure enough,\nthat is the rare earth"
    } ]
  }, {
    "tStartMs": 1239771,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "China has not a 94%\nmonopoly on,"
    } ]
  }, {
    "tStartMs": 1241640,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "but a 99% monopoly\non taking about a third"
    } ]
  }, {
    "tStartMs": 1244142,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "more steps, costing 12 times"
    } ]
  }, {
    "tStartMs": 1245510,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "more to refine\nthan neodymium,"
    } ]
  }, {
    "tStartMs": 1246945,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "and found in fewer places\nin the ground."
    } ]
  }, {
    "tStartMs": 1248714,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "When China fully banned"
    } ]
  }, {
    "tStartMs": 1250082,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "exports of samarium\nin response"
    } ]
  }, {
    "tStartMs": 1251516,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "to tariffs being put up,"
    } ]
  }, {
    "tStartMs": 1252317,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "they knew exactly how it was\nbeing used."
    } ]
  }, {
    "tStartMs": 1254019,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "And I quote this reflects"
    } ]
  }, {
    "tStartMs": 1255520,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "China's consistent stance"
    } ]
  }, {
    "tStartMs": 1256788,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "on upholding world peace"
    } ]
  }, {
    "tStartMs": 1257990,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "and regional stability."
    } ]
  }, {
    "tStartMs": 1259491,
    "dDurationMs": 968,
    "segs": [ {
      "utf8": "You would not ban this stuff"
    } ]
  }, {
    "tStartMs": 1260459,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "and then mention peace\nif it was a military thing"
    } ]
  }, {
    "tStartMs": 1262494,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "to which a lot of people\naround the world answered,"
    } ]
  }, {
    "tStartMs": 1265097,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "this is unacceptable."
    } ]
  }, {
    "tStartMs": 1266732,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "I think it's time\nfor a Manhattan Project"
    } ]
  }, {
    "tStartMs": 1268900,
    "dDurationMs": 1736,
    "segs": [ {
      "utf8": "like effort to end our rare"
    } ]
  }, {
    "tStartMs": 1270669,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "earth dependency on China."
    } ]
  }, {
    "tStartMs": 1272304,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "Yet the United States\nremains dangerously"
    } ]
  }, {
    "tStartMs": 1274039,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "dependent\non foreign countries,"
    } ]
  }, {
    "tStartMs": 1275274,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "including China,\nfor this critical mineral."
    } ]
  }, {
    "tStartMs": 1277175,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "This is not a\ntheoretical risk."
    } ]
  }, {
    "tStartMs": 1278810,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "It is a clear and present"
    } ]
  }, {
    "tStartMs": 1280012,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "danger\nto our national security."
    } ]
  }, {
    "tStartMs": 1281580,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "The thing is, a lot of\npeople knew this already."
    } ]
  }, {
    "tStartMs": 1283715,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "It just wasn't your mom\nor the bartender"
    } ]
  }, {
    "tStartMs": 1285584,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "guy from work\nthat you grab a beer with."
    } ]
  }, {
    "tStartMs": 1286985,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "Sometimes\nfor at least two decades"
    } ]
  }, {
    "tStartMs": 1288620,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "in the halls of the Pentagon\nsubcommittees in Congress,"
    } ]
  }, {
    "tStartMs": 1290956,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "people would say,\nthis is a problem."
    } ]
  }, {
    "tStartMs": 1292691,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "China is doing this"
    } ]
  }, {
    "tStartMs": 1293492,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "so they can cut us off\nin the future."
    } ]
  }, {
    "tStartMs": 1295060,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "It's not that people thought"
    } ]
  }, {
    "tStartMs": 1296495,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "the people making\nthese claims were wrong"
    } ]
  }, {
    "tStartMs": 1298196,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "or didn't know what\nthey were talking about."
    } ]
  }, {
    "tStartMs": 1299665,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "It just wasn't clear that\nChina ever would."
    } ]
  }, {
    "tStartMs": 1301466,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "So for years,"
    } ]
  }, {
    "tStartMs": 1302200,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "it could only ever hang"
    } ]
  }, {
    "tStartMs": 1303502,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "around as one of those\nsuspicions of"
    } ]
  }, {
    "tStartMs": 1305103,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "what if that could happen?"
    } ]
  }, {
    "tStartMs": 1306538,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "Like that one friend,"
    } ]
  }, {
    "tStartMs": 1308140,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "we have way less oil"
    } ]
  }, {
    "tStartMs": 1309174,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "than they tell us this year."
    } ]
  }, {
    "tStartMs": 1310876,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "Maybe two three at tops."
    } ]
  }, {
    "tStartMs": 1312477,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "The wells are going dry."
    } ]
  }, {
    "tStartMs": 1313478,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "It's going\nfull mad Max the story"
    } ]
  }, {
    "tStartMs": 1315714,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "and said it really wasn't\neven a story."
    } ]
  }, {
    "tStartMs": 1317215,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "It was just an observation\nof what appeared"
    } ]
  }, {
    "tStartMs": 1319117,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "to be the game on the field."
    } ]
  }, {
    "tStartMs": 1320385,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "China got the pollution\nand the"
    } ]
  }, {
    "tStartMs": 1321586,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "manufacturing businesses\nthat went with it."
    } ]
  }, {
    "tStartMs": 1323755,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "The West got clean industry,\nand accepting that trade"
    } ]
  }, {
    "tStartMs": 1326291,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "off meant\nlosing some manufacturing"
    } ]
  }, {
    "tStartMs": 1328226,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "and becoming dependent\nfor a critical material."
    } ]
  }, {
    "tStartMs": 1330495,
    "dDurationMs": 768,
    "segs": [ {
      "utf8": "It was plausible."
    } ]
  }, {
    "tStartMs": 1331263,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Felt like a clean trade."
    } ]
  }, {
    "tStartMs": 1332264,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "Both parties win some,\nboth parties lose some."
    } ]
  }, {
    "tStartMs": 1334132,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "Everyone aware\nthat, yes, China"
    } ]
  }, {
    "tStartMs": 1335901,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "could deliver some pain\nif they wanted to."
    } ]
  }, {
    "tStartMs": 1337669,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "But the first rule of being\na monopoly is"
    } ]
  }, {
    "tStartMs": 1340372,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "you do not talk about"
    } ]
  }, {
    "tStartMs": 1341773,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "being a monopoly."
    } ]
  }, {
    "tStartMs": 1343141,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "Do not publicly admit"
    } ]
  }, {
    "tStartMs": 1344276,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "you are a monopoly in words\nor in actions."
    } ]
  }, {
    "tStartMs": 1346411,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "De beers monopoly."
    } ]
  }, {
    "tStartMs": 1347713,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "Luxottica,\nthe company that makes"
    } ]
  }, {
    "tStartMs": 1349081,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "95% of all glasses."
    } ]
  }, {
    "tStartMs": 1350615,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "Sun and regular monopoly\nASML, the company"
    } ]
  }, {
    "tStartMs": 1353352,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "that makes the machines\nthat make semiconductors"
    } ]
  }, {
    "tStartMs": 1355320,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "monopoly Bloomberg"
    } ]
  }, {
    "tStartMs": 1356722,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "terminal all monopolies\nwhich okay,"
    } ]
  }, {
    "tStartMs": 1358757,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "everyone\nis not overjoyed about,"
    } ]
  }, {
    "tStartMs": 1360092,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "but we're all relatively\nfine with because"
    } ]
  }, {
    "tStartMs": 1361893,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "none of these companies\nhave ever crossed the line."
    } ]
  }, {
    "tStartMs": 1364563,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "The line that signals\nthe game has shifted from,"
    } ]
  }, {
    "tStartMs": 1366932,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "we're just trying to make"
    } ]
  }, {
    "tStartMs": 1367699,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "some extra money\nwith the control"
    } ]
  }, {
    "tStartMs": 1369067,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "we have over\nthis thing, too."
    } ]
  }, {
    "tStartMs": 1370435,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "We're trying to force you"
    } ]
  }, {
    "tStartMs": 1371536,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "to do something\nwith the control."
    } ]
  }, {
    "tStartMs": 1372904,
    "dDurationMs": 768,
    "segs": [ {
      "utf8": "We have."
    } ]
  }, {
    "tStartMs": 1373672,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "The line\nChina crossed on April"
    } ]
  }, {
    "tStartMs": 1375407,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "4th, 2025."
    } ]
  }, {
    "tStartMs": 1377142,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "Yes, actually,"
    } ]
  }, {
    "tStartMs": 1378243,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "all those people\nin the Pentagon"
    } ]
  }, {
    "tStartMs": 1379511,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "and the subcommittees"
    } ]
  }, {
    "tStartMs": 1380312,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "and the people who made\nYouTube videos"
    } ]
  }, {
    "tStartMs": 1381713,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "ten years ago saying this is\nwhy we were doing it."
    } ]
  }, {
    "tStartMs": 1384182,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "You didn't listen to."
    } ]
  }, {
    "tStartMs": 1385317,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "They were right."
    } ]
  }, {
    "tStartMs": 1386184,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "We do have\nmonopoly on Earth."
    } ]
  }, {
    "tStartMs": 1387652,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "We know you need them,\nand now you can't have them"
    } ]
  }, {
    "tStartMs": 1389755,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "unless you do this thing\nwe want you to do."
    } ]
  }, {
    "tStartMs": 1392057,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "That feels very different\nthan the mildly annoyed"
    } ]
  }, {
    "tStartMs": 1394459,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "feeling from knowing you're\npaying $200 for Ray-Bans."
    } ]
  }, {
    "tStartMs": 1396595,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "That cost $7 to make"
    } ]
  }, {
    "tStartMs": 1397863,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "for two reasons one,\nusing it to force people"
    } ]
  }, {
    "tStartMs": 1400699,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "to act in a certain way that\nmakes people feel trapped."
    } ]
  }, {
    "tStartMs": 1403468,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "Crossing\nthe line makes the customer"
    } ]
  }, {
    "tStartMs": 1405170,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "feel like they were kidnaped\nand is now a hostage,"
    } ]
  }, {
    "tStartMs": 1407372,
    "dDurationMs": 968,
    "segs": [ {
      "utf8": "especially if it's something"
    } ]
  }, {
    "tStartMs": 1408340,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "required\nfor the world to work."
    } ]
  }, {
    "tStartMs": 1409674,
    "dDurationMs": 1102,
    "segs": [ {
      "utf8": "It just doesn't sit well."
    } ]
  }, {
    "tStartMs": 1410776,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "You get this\nkind of reaction."
    } ]
  }, {
    "tStartMs": 1412344,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "China's sweeping\nexport controls"
    } ]
  }, {
    "tStartMs": 1413912,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "this year were a significant\nwake up call."
    } ]
  }, {
    "tStartMs": 1416415,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "They disrupted supply\nchains, triggered"
    } ]
  }, {
    "tStartMs": 1418417,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "factory shutdowns\nin the United States."
    } ]
  }, {
    "tStartMs": 1420318,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "It wasn't\njust a handful of years ago"
    } ]
  }, {
    "tStartMs": 1422521,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "that policymakers recognized"
    } ]
  }, {
    "tStartMs": 1424856,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "that we have a problem,"
    } ]
  }, {
    "tStartMs": 1426091,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "our dependency on China"
    } ]
  }, {
    "tStartMs": 1428193,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "for critical minerals,\nfor more importantly,"
    } ]
  }, {
    "tStartMs": 1430962,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "number two,"
    } ]
  }, {
    "tStartMs": 1431696,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "the people who said\nit was a deliberate strategy"
    } ]
  }, {
    "tStartMs": 1433899,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "to exert\ncontrol in the world are now"
    } ]
  }, {
    "tStartMs": 1435400,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "proven correct."
    } ]
  }, {
    "tStartMs": 1436234,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "The people who didn't\nlisten to them"
    } ]
  }, {
    "tStartMs": 1437469,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "before\nstart listening intently."
    } ]
  }, {
    "tStartMs": 1438837,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "And the happy"
    } ]
  }, {
    "tStartMs": 1439438,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "story of a clean trade\nbetween two countries."
    } ]
  }, {
    "tStartMs": 1441339,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "It evaporates, the retelling\nof which is replaced"
    } ]
  }, {
    "tStartMs": 1443508,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "by cold analysis\nof every other situation"
    } ]
  }, {
    "tStartMs": 1445944,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "where the pattern showed up"
    } ]
  }, {
    "tStartMs": 1447412,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "solar, cars, aluminum."
    } ]
  }, {
    "tStartMs": 1448814,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Every motive"
    } ]
  }, {
    "tStartMs": 1449514,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "that was assumed\nis now questioned,"
    } ]
  }, {
    "tStartMs": 1451149,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "even if it came\nfrom being provoked."
    } ]
  }, {
    "tStartMs": 1453518,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "The US started cutting China"
    } ]
  }, {
    "tStartMs": 1454953,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "off from the best\nsemiconductors"
    } ]
  }, {
    "tStartMs": 1456555,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "at about 2016"
    } ]
  }, {
    "tStartMs": 1457756,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "and really clamped down\nin 2019,"
    } ]
  }, {
    "tStartMs": 1459691,
    "dDurationMs": 3137,
    "segs": [ {
      "utf8": "upped it again in 2020 and\nthen big tariffs in 2025."
    } ]
  }, {
    "tStartMs": 1462861,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "So yes, the US\ndid provoke China"
    } ]
  }, {
    "tStartMs": 1464896,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "with this stuff,\nno question about that."
    } ]
  }, {
    "tStartMs": 1466531,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "But the whole period\nof the US"
    } ]
  }, {
    "tStartMs": 1467933,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "chips industry\nbefore this started,"
    } ]
  }, {
    "tStartMs": 1469835,
    "dDurationMs": 2268,
    "segs": [ {
      "utf8": "the right word\nwould be organic."
    } ]
  }, {
    "tStartMs": 1472137,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "Hundreds of firms competing,\nthe government"
    } ]
  }, {
    "tStartMs": 1474105,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "not intervening to prevent\nforeign firms from winning."
    } ]
  }, {
    "tStartMs": 1476541,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "No government\nbackstop Intel was crushed."
    } ]
  }, {
    "tStartMs": 1479144,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "Over the last two decades\nin the US,"
    } ]
  }, {
    "tStartMs": 1480612,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "chip industry\nas a whole was hollowed out"
    } ]
  }, {
    "tStartMs": 1482948,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "by Japan and Taiwan\nin the 90s and 2000."
    } ]
  }, {
    "tStartMs": 1485450,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "The US government\ndidn't intervene."
    } ]
  }, {
    "tStartMs": 1487118,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "It didn't\nbuild it up on purpose,"
    } ]
  }, {
    "tStartMs": 1488920,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "so then it could take it\naway."
    } ]
  }, {
    "tStartMs": 1490455,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "That is why,\nto many observers,"
    } ]
  }, {
    "tStartMs": 1492157,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "the rare earth situation\nfrom China feels different,"
    } ]
  }, {
    "tStartMs": 1494659,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "that it feels like\nthis whole time"
    } ]
  }, {
    "tStartMs": 1496228,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "the Chinese government\nwas executing a plan"
    } ]
  }, {
    "tStartMs": 1498230,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "drawn up on a whiteboard"
    } ]
  }, {
    "tStartMs": 1499498,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "to control\na critical industry"
    } ]
  }, {
    "tStartMs": 1500866,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "so that once under"
    } ]
  }, {
    "tStartMs": 1501800,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "their control,\nthey could take it away"
    } ]
  }, {
    "tStartMs": 1503535,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "if they wanted to, that it\nwas definitely not organic."
    } ]
  }, {
    "tStartMs": 1506338,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "It was planned control\nof all the trade moves"
    } ]
  }, {
    "tStartMs": 1508974,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "between the US and China\nover the past decade."
    } ]
  }, {
    "tStartMs": 1511276,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "The rare earths\none was the most extreme"
    } ]
  }, {
    "tStartMs": 1513378,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "because publicly revealing"
    } ]
  }, {
    "tStartMs": 1515080,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "your monopoly has zero long\nterm upside."
    } ]
  }, {
    "tStartMs": 1517883,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "It's usually reserved for"
    } ]
  }, {
    "tStartMs": 1519184,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "when war is breaking out,"
    } ]
  }, {
    "tStartMs": 1520385,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "because you want to play\nthe card"
    } ]
  }, {
    "tStartMs": 1521987,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "as a last resort only"
    } ]
  }, {
    "tStartMs": 1523355,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "when it really matters."
    } ]
  }, {
    "tStartMs": 1524589,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "Otherwise,\nyou will encourage"
    } ]
  }, {
    "tStartMs": 1526157,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "everyone to immediately\nstart"
    } ]
  }, {
    "tStartMs": 1527359,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "solving the problem,\nwhich is exactly what"
    } ]
  }, {
    "tStartMs": 1529861,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "the world is doing\nright now."
    } ]
  }, {
    "tStartMs": 1531263,
    "dDurationMs": 2535,
    "segs": [ {
      "utf8": "Japan, Australia,\nand particularly the US"
    } ]
  }, {
    "tStartMs": 1533798,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "have made the moves required\nto break the monopoly."
    } ]
  }, {
    "tStartMs": 1536268,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "The Pentagon has made deals\nwith companies guaranteeing"
    } ]
  }, {
    "tStartMs": 1538637,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "they'll pay $110 per"
    } ]
  }, {
    "tStartMs": 1540338,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "kilogram of rare earths,\nwell above the market price."
    } ]
  }, {
    "tStartMs": 1542841,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "That way,\nChina can't flood the market"
    } ]
  }, {
    "tStartMs": 1544709,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "and wash out US\ncompanies again."
    } ]
  }, {
    "tStartMs": 1546545,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Things like this have\nhappened in the US before."
    } ]
  }, {
    "tStartMs": 1548580,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "The aluminum industry\naround World"
    } ]
  }, {
    "tStartMs": 1549981,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "War two being one,"
    } ]
  }, {
    "tStartMs": 1551316,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "the US needed a lot\nof aluminum for planes."
    } ]
  }, {
    "tStartMs": 1553251,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "This was\nthe start of the plane era"
    } ]
  }, {
    "tStartMs": 1554920,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "and that capacity\njust wasn't there yet."
    } ]
  }, {
    "tStartMs": 1556588,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "But this one for rare\nearths, it's"
    } ]
  }, {
    "tStartMs": 1558156,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "a little different."
    } ]
  }, {
    "tStartMs": 1558857,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "Not only are they\nguaranteeing the price,"
    } ]
  }, {
    "tStartMs": 1560659,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "they're also guaranteeing\nan amount."
    } ]
  }, {
    "tStartMs": 1562227,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "They'll buy an arrangement\ncalled take or pay."
    } ]
  }, {
    "tStartMs": 1564195,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "But if the market\nprice is over $110,"
    } ]
  }, {
    "tStartMs": 1566431,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "the government gets 30%"
    } ]
  }, {
    "tStartMs": 1567732,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "of the difference between\n100 and $10 and the higher"
    } ]
  }, {
    "tStartMs": 1570068,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "price for whatever else"
    } ]
  }, {
    "tStartMs": 1571536,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "they sell to whoever else."
    } ]
  }, {
    "tStartMs": 1572837,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "So there's upside\nin this deal"
    } ]
  }, {
    "tStartMs": 1574239,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "that is guaranteed\nfor ten years."
    } ]
  }, {
    "tStartMs": 1575774,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "This is all happening\nlargely."
    } ]
  }, {
    "tStartMs": 1577342,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "And of course it is\nby extending"
    } ]
  }, {
    "tStartMs": 1578777,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "the saga of Mountain Pass,\nwhich is what this deal is"
    } ]
  }, {
    "tStartMs": 1580912,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "aimed\nat, the miners back online,"
    } ]
  }, {
    "tStartMs": 1582681,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "not only mining,"
    } ]
  }, {
    "tStartMs": 1583348,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "but now\nprocessing and refining"
    } ]
  }, {
    "tStartMs": 1584783,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "rare earths\nand building an advanced"
    } ]
  }, {
    "tStartMs": 1586151,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "processing facility\nin Texas."
    } ]
  }, {
    "tStartMs": 1587852,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "These are the moves\nthat you would need"
    } ]
  }, {
    "tStartMs": 1589020,
    "dDurationMs": 1569,
    "segs": [ {
      "utf8": "to make to get the industry\nrolling again."
    } ]
  }, {
    "tStartMs": 1590622,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Will it work?"
    } ]
  }, {
    "tStartMs": 1591456,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "We'll see."
    } ]
  }, {
    "tStartMs": 1592057,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "It's an uncommon arrangement"
    } ]
  }, {
    "tStartMs": 1593391,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": "in the US,\nbut it's not unprecedented."
    } ]
  }, {
    "tStartMs": 1595794,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "Oh, and one last thing."
    } ]
  }, {
    "tStartMs": 1596828,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "If you look down\nright over here,"
    } ]
  }, {
    "tStartMs": 1598830,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "there's a subscribe button."
    } ]
  }, {
    "tStartMs": 1600131,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "That button is the portal"
    } ]
  }, {
    "tStartMs": 1601299,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "to not just\nour library videos,"
    } ]
  }, {
    "tStartMs": 1602901,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "but to us being able\nto make more videos,"
    } ]
  }, {
    "tStartMs": 1604703,
    "dDurationMs": 2068,
    "segs": [ {
      "utf8": "bigger videos, events,\nall sorts of stuff."
    } ]
  }, {
    "tStartMs": 1606838,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "The more subscribers\nthe channel has,"
    } ]
  }, {
    "tStartMs": 1608306,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "the more projects\nI can greenlight."
    } ]
  }, {
    "tStartMs": 1609641,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "And there's a giant list\nI would love to"
    } ]
  }, {
    "tStartMs": 1612010,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "give the thumbs up to\nif you choose to subscribe."
    } ]
  }, {
    "tStartMs": 1614412,
    "dDurationMs": 768,
    "segs": [ {
      "utf8": "Truly. Thank you."
    } ]
  }, {
    "tStartMs": 1615180,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "It really is a big help."
    } ]
  }, {
    "tStartMs": 1616481,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "Even if you didn't\nand you just watched."
    } ]
  }, {
    "tStartMs": 1618083,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "Thank you for watching."
    } ]
  }, {
    "tStartMs": 1619184,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "And that's it."
    } ]
  }, {
    "tStartMs": 1619751,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Ladies and gentlemen,\nI will see you"
    } ]
  }, {
