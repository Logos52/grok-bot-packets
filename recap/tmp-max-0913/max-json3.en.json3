  }, {
    "tStartMs": 308841,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "military needed uranium,\nwhich it has,"
    } ]
  }, {
    "tStartMs": 310777,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "but not nearly as abundant\nas its rare earths."
    } ]
  }, {
    "tStartMs": 313379,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "If you've only heard about\none rare earth mine"
    } ]
  }, {
    "tStartMs": 315748,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "in the United States, it's\nalmost certainly this one"
    } ]
  }, {
    "tStartMs": 317850,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "in and out of the news\nevery decade for the past"
    } ]
  }, {
    "tStartMs": 319819,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "50 years,\nan incredible ongoing saga"
    } ]
  }, {
    "tStartMs": 322455,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "go to any other rare earth\nmine in the world."
    } ]
  }, {
    "tStartMs": 324357,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "None of them will give you\nas much in rare earths"
    } ]
  }, {
    "tStartMs": 326059,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "per bucket pulled out of\nthe ground in Mountain Pass."
    } ]
  }, {
    "tStartMs": 328161,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "Take one scoop\nout of this mine"
    } ]
  }, {
    "tStartMs": 329595,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "and you'll find 90%"
    } ]
  }, {
    "tStartMs": 330863,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "is just ordinary rock."
    } ]
  }, {
    "tStartMs": 332231,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "The rest is rare earths"
    } ]
  }, {
    "tStartMs": 333866,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "cerium, lanthanum,"
    } ]
  }, {
    "tStartMs": 335201,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "neodymium for sale."
    } ]
  }, {
    "tStartMs": 336936,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "But there is almost"
    } ]
  }, {
    "tStartMs": 338471,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "nothing in one scoop\nthat is useful"
    } ]
  }, {
    "tStartMs": 340573,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "except the neodymium"
    } ]
  }, {
    "tStartMs": 341841,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "and the Demian."
    } ]
  }, {
    "tStartMs": 343176,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "The other rare earths come\nup in every rare earth mine"
    } ]
  }, {
    "tStartMs": 345345,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "to have their uses,\nbut are almost"
    } ]
  }, {
    "tStartMs": 346779,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "given away for free."
    } ]
  }, {
    "tStartMs": 349215,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "The neodymium, though"
    } ]
  }, {
    "tStartMs": 350616,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "this is a neodymium magnet"
    } ]
  }, {
    "tStartMs": 352352,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "about 1.5in across,"
    } ]
  }, {
    "tStartMs": 353753,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "has about 12 pounds of pull."
    } ]
  }, {
    "tStartMs": 355455,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "This is pure neodymium."
    } ]
  }, {
    "tStartMs": 356789,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "It would take\nthis much neodymium"
    } ]
  }, {
    "tStartMs": 358558,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "to make this magnet"
    } ]
  }, {
    "tStartMs": 359826,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "that one scoop\nwe just looked at."
    } ]
  }, {
    "tStartMs": 361394,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "About 200 pounds of earth"
    } ]
  }, {
    "tStartMs": 362962,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "can make just nine of these,"
    } ]
  }, {
    "tStartMs": 364330,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "but if we split it down"
    } ]
  }, {
    "tStartMs": 365698,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "even further to something"
    } ]
  }, {
    "tStartMs": 367033,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "a bit more common,\nsomething like AirPods."
    } ]
  }, {
    "tStartMs": 370036,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "This whole product is\nmagnets."
    } ]
  }, {
    "tStartMs": 371871,
    "dDurationMs": 1768,
    "segs": [ {
      "utf8": "First you have the class\nand the back"
    } ]
  }, {
    "tStartMs": 373673,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "charger probably don't truly"
    } ]
  }, {
    "tStartMs": 375041,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "need magnets\nfor those two things."
    } ]
  }, {
    "tStartMs": 376376,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "They're nice to have,\nbut the actual earbuds"
    } ]
  }, {
    "tStartMs": 378678,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "inside each one\nthere are two magnets."
    } ]
  }, {
    "tStartMs": 381080,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "The one up here is\nwhat makes the sound"
    } ]
  }, {
    "tStartMs": 382682,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "you hear no magnet,\nno sound."
    } ]
  }, {
    "tStartMs": 384917,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "That scoop that made nine of\nthose other magnets"
    } ]
  }, {
    "tStartMs": 387253,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "could make about 250"
    } ]
  }, {
    "tStartMs": 388721,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "sets of AirPods."
    } ]
  }, {
    "tStartMs": 389856,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "Most rare\nearth mines won't get half"
    } ]
  }, {
    "tStartMs": 391491,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "of what Mountain Pass gets."
    } ]
  }, {
    "tStartMs": 393059,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "Remember the division inside"
    } ]
  }, {
    "tStartMs": 394460,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "a General Motors\nthat co-invented"
    } ]
  }, {
    "tStartMs": 395962,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "the neodymium magnet\nback in 1983?"
    } ]
  }, {
    "tStartMs": 398331,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "Well, this mine\nmountain pass was the mine"
    } ]
  }, {
    "tStartMs": 400266,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "that was supplying them\nwith rare earths."
    } ]
  }, {
    "tStartMs": 401834,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "When they did it,\nand they were still"
    } ]
  }, {
    "tStartMs": 403269,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "the one supplying them\nwith rare earths."
    } ]
  }, {
    "tStartMs": 404737,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "When the division\nwas spun out of and sold"
    } ]
  }, {
    "tStartMs": 407140,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "to a pair\nof Chinese companies"
    } ]
  }, {
    "tStartMs": 408541,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "in 1995"
    } ]
  }, {
    "tStartMs": 410676,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "for two years,\na company called Sexton"
    } ]
  }, {
    "tStartMs": 412712,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "had tried to convince GM"
    } ]
  }, {
    "tStartMs": 413946,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "to sell to them\nall the patents,"
    } ]
  }, {
    "tStartMs": 415314,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "the knowledge, the tooling,\nprocesses, factories."
    } ]
  }, {
    "tStartMs": 417450,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "For two years,\nGM had the luxury"
    } ]
  }, {
    "tStartMs": 419185,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "of declining the offer\nuntil the market turned."
    } ]
  }, {
    "tStartMs": 421421,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "GM got into financial\nissues, finally announcing"
    } ]
  }, {
    "tStartMs": 423823,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "they would sell off\nsome non-core businesses."
    } ]
  }, {
    "tStartMs": 425858,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "Sexton showed up and bought"
    } ]
  }, {
    "tStartMs": 427160,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "the company called\nMagna Quench,"
    } ]
  }, {
    "tStartMs": 428795,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "but it's not entirely clear\ntoday is"
    } ]
  }, {
    "tStartMs": 430830,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "if anyone at the time knew"
    } ]
  }, {
    "tStartMs": 432231,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "who was behind Sexton\nthese kinds of purchases"
    } ]
  }, {
    "tStartMs": 434667,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "a foreign country\nbuying a company,"
    } ]
  }, {
    "tStartMs": 436402,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "it goes through\nfederal review."
    } ]
  }, {
    "tStartMs": 437870,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "They check this stuff out."
    } ]
  }, {
    "tStartMs": 438938,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "Some country couldn't\ncome in and just buy Boeing,"
    } ]
  }, {
    "tStartMs": 441507,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "even if they offered an\noutrageous amount of money."
    } ]
  }, {
    "tStartMs": 443576,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "It's just\ntoo important of a company."
    } ]
  }, {
    "tStartMs": 445144,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "So the question remains\nunresolved."
    } ]
  }, {
    "tStartMs": 447013,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "Documents are scarce."
    } ]
  }, {
    "tStartMs": 448080,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "The purchase appears\nto have been rushed through."
    } ]
  }, {
    "tStartMs": 450082,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "This was right at the time"
    } ]
  }, {
    "tStartMs": 451117,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "the free Trade area\nwas kicking in."
    } ]
  }, {
    "tStartMs": 452518,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "Its fishy\nbecause Magna Quench"
    } ]
  }, {
    "tStartMs": 454620,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "was a critical\nsupplier of magnets"
    } ]
  }, {
    "tStartMs": 456556,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "to dozens of companies"
    } ]
  }, {
    "tStartMs": 457857,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "in the US military."
    } ]
  }, {
    "tStartMs": 459358,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "So whoever\nsigned off on it, did."
    } ]
  }, {
    "tStartMs": 461093,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "They know that\ntwo Chinese companies"
    } ]
  }, {
    "tStartMs": 462628,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "owned 62% of Sexton,\nand that the owners of those"
    } ]
  }, {
    "tStartMs": 465498,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "two companies were both\nson in"
    } ]
  }, {
    "tStartMs": 466699,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "law's of Deng Xiaoping?"
    } ]
  }, {
    "tStartMs": 468100,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "Deng Xiaoping was the ruler\nof China for 12 years."
    } ]
  }, {
    "tStartMs": 470403,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "He came two years after Mao"
    } ]
  }, {
