  }, {
    "tStartMs": 242675,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "when the neodymium magnet\nwas invented in 1983."
    } ]
  }, {
    "tStartMs": 245545,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "Did China do this\nintentionally?"
    } ]
  }, {
    "tStartMs": 246813,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "They did move by move,"
    } ]
  }, {
    "tStartMs": 248181,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "pulling the entire industry\ninto their control."
    } ]
  }, {
    "tStartMs": 250383,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "But how they managed to"
