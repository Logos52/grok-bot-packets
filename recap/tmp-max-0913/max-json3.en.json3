  }, {
    "tStartMs": 290957,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "those are a bit harder\nto find."
    } ]
  }, {
    "tStartMs": 292792,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "Looking at this, we can see\nthat when people say"
    } ]
  }, {
    "tStartMs": 295395,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "where earths aren't rare,\nthey're telling the truth."
    } ]
  }, {
    "tStartMs": 297530,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "And this is perhaps\nthe most famous"
    } ]
  }, {
    "tStartMs": 299732,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "of all the rare earth mines\nmountain pass"
    } ]
  }, {
    "tStartMs": 301934,
    "dDurationMs": 1369,
    "segs": [ {
      "utf8": "found\nin Southern California,"
    } ]
  }, {
    "tStartMs": 303336,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "about two hours\nfrom Las Vegas,"
    } ]
  }, {
    "tStartMs": 305038,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "one of the best rare earth\nmines that has ever existed."
    } ]
  }, {
    "tStartMs": 307540,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "Discovered because the U.S."
