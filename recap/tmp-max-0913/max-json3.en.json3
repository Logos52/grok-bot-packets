  }, {
    "tStartMs": 231331,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "shrink the electric world."
    } ]
  }, {
    "tStartMs": 232865,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "That is why for every dollar"
    } ]
  }, {
    "tStartMs": 234400,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "that flows through the rare\nearth industry,"
    } ]
  }, {
    "tStartMs": 236002,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "$0.96 of it\nends up in magnets,"
