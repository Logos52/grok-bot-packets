  "events": [ {
    "tStartMs": 533,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "A simple\ncoil of copper wire."
    } ]
  }, {
    "tStartMs": 2302,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "One battery."
    } ]
  }, {
    "tStartMs": 3236,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "One magnet."
    } ]
  }, {
    "tStartMs": 4738,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "This is the world's\nsimplest motor."
    } ]
  }, {
    "tStartMs": 6773,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "It will spin\nuntil this battery runs out"
    } ]
  }, {
    "tStartMs": 8875,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "quietly, smoothly, while"
    } ]
  }, {
    "tStartMs": 10110,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "generating very little heat."
    } ]
  }, {
    "tStartMs": 11778,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "What's widely misunderstood\nis that"
    } ]
  }, {
    "tStartMs": 13780,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "this is why rare"
    } ]
  }, {
    "tStartMs": 15148,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "earth\nminerals are so critical."
    } ]
  }, {
    "tStartMs": 16683,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "They are how we create\nmagnets."
    } ]
  }, {
    "tStartMs": 19352,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "Take a hunk of metal."
    } ]
  }, {
    "tStartMs": 20453,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "Melt it down."
    } ]
  }, {
    "tStartMs": 21354,
    "dDurationMs": 2036,
    "segs": [ {
      "utf8": "Add one of the magnet rare\nearth metals to it."
    } ]
  }, {
    "tStartMs": 23423,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "Let it cool and you perform\nsomething close to magic."
    } ]
  }, {
    "tStartMs": 25825,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "You've transformed it into"
    } ]
  }, {
    "tStartMs": 26993,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "a permanent magnet."
    } ]
  }, {
    "tStartMs": 28194,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "Irreplaceable."
    } ]
  }, {
    "tStartMs": 28895,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "Because there's nothing on\nEarth"
    } ]
  }, {
    "tStartMs": 29996,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "that generates as much force"
    } ]
  }, {
    "tStartMs": 31264,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "as magnets, yet waste\nso little."
    } ]
  }, {
    "tStartMs": 32932,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "AirPods have six magnets"
    } ]
  }, {
    "tStartMs": 34300,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "iPhone 14, laptop\nat least a dozen."
    } ]
  }, {
    "tStartMs": 36936,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "The reason\nelectric cars work"
    } ]
  }, {
    "tStartMs": 38338,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "is because there's 12\npounds of it in the motor."
    } ]
  }, {
    "tStartMs": 40507,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "There are at least 12 rare\nearth"
    } ]
  }, {
    "tStartMs": 42142,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "magnets in every missile\nthe U.S."
    } ]
  }, {
    "tStartMs": 43476,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "military uses."
    } ]
  }, {
    "tStartMs": 44344,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "That's how they steer."
    } ]
  }, {
    "tStartMs": 45345,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "So if you wanted\nto hurt a country"
    } ]
  }, {
    "tStartMs": 46880,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "to put their businesses\nin a bad"
    } ]
  }, {
    "tStartMs": 48314,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "spot, hurt their military."
    } ]
  }, {
    "tStartMs": 49783,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "Then these are the rare\nearth minerals"
    } ]
  }, {
    "tStartMs": 51518,
    "dDurationMs": 2435,
    "segs": [ {
      "utf8": "to make sure they can't\nget their hands on something"
    } ]
  }, {
    "tStartMs": 53953,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "only one country can do,\nbecause one country controls"
    } ]
  }, {
    "tStartMs": 56456,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "94% of all magnet\nrare earths."
    } ]
  }, {
    "tStartMs": 58691,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "When people say China has"
    } ]
  }, {
    "tStartMs": 60393,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "monopoly on rare earths,"
    } ]
  }, {
    "tStartMs": 61995,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "this is what they're\ntalking about"
    } ]
  }, {
    "tStartMs": 63296,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "and what the world is\nnow scrambling to overcome."
    } ]
  }, {
    "tStartMs": 67667,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "This video is"
    } ]
  }, {
    "tStartMs": 68701,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "sponsored by Zotac."
    } ]
  }, {
    "tStartMs": 69903,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "More on them later."
    } ]
  }, {
    "tStartMs": 71671,
    "dDurationMs": 768,
    "segs": [ {
      "utf8": "A magnet already"
    } ]
  }, {
    "tStartMs": 72439,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "has a field around it,\nan invisible"
    } ]
  }, {
    "tStartMs": 74074,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "bubble of push and pull."
    } ]
  }, {
    "tStartMs": 75275,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": "A plain copper\nwire does not,"
    } ]
  }, {
    "tStartMs": 77210,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "but send electricity\nthrough that wire."
    } ]
  }, {
    "tStartMs": 79312,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "And for as long as\nthe current is flowing,"
    } ]
  }, {
    "tStartMs": 80914,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "the wire grows\na field of its own."
    } ]
  }, {
    "tStartMs": 82749,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "It becomes a temporary\nmagnet."
    } ]
  }, {
    "tStartMs": 84584,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "The fancy word for\nthis is electromagnetism."
    } ]
  }, {
    "tStartMs": 86920,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "Now you have two magnets"
    } ]
  }, {
    "tStartMs": 88054,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "in one tiny arena."
    } ]
  }, {
    "tStartMs": 89255,
    "dDurationMs": 968,
    "segs": [ {
      "utf8": "One is permanent."
    } ]
  }, {
    "tStartMs": 90223,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "One only lives while\nthe battery is connected."
    } ]
  }, {
    "tStartMs": 92358,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "And magnets\nthat share a space"
    } ]
  }, {
    "tStartMs": 94060,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "do what magnets always do."
    } ]
  }, {
    "tStartMs": 95361,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "They try to force the other\nto move."
    } ]
  }, {
    "tStartMs": 97063,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "That forced movement"
    } ]
  }, {
    "tStartMs": 98264,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "in a simple setup like this,"
    } ]
  }, {
    "tStartMs": 99499,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "where they're held in place\nbut allowed to spin."
    } ]
  }, {
    "tStartMs": 101401,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "That movement is rotation."
    } ]
  }, {
    "tStartMs": 102635,
    "dDurationMs": 1936,
    "segs": [ {
      "utf8": "That rotation is a motor\ncrank."
    } ]
  }, {
    "tStartMs": 104637,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "The current,\nthe copper wire becomes"
    } ]
  }, {
    "tStartMs": 105939,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "a stronger, temporary\nmagnet."
    } ]
  }, {
    "tStartMs": 107307,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Faster. Shove."
    } ]
  }, {
    "tStartMs": 108308,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Park a second magnet across\nfrom the first,"
    } ]
  }, {
    "tStartMs": 110143,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "and the coil becomes trapped"
    } ]
  }, {
    "tStartMs": 111478,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "in a tug of war,"
    } ]
  }, {
    "tStartMs": 112712,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "which is pretty fun\nto play with"
    } ]
  }, {
    "tStartMs": 114214,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "and can change the objective"
    } ]
  }, {
    "tStartMs": 115415,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "from spin to point\nin a specific direction."
    } ]
  }, {
    "tStartMs": 117851,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "The entire modern\nelectric world"
    } ]
  }, {
    "tStartMs": 119519,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "is this interaction, shrunk"
    } ]
  }, {
    "tStartMs": 120787,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "and repeated\na thousand times."
    } ]
  }, {
    "tStartMs": 122155,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "Electricity creates a field."
    } ]
  }, {
    "tStartMs": 123756,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "The field fights\na real magnet."
    } ]
  }, {
    "tStartMs": 125391,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "Something useful moves."
    } ]
  }, {
    "tStartMs": 127894,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "They were heavy,"
    } ]
  }, {
    "tStartMs": 128628,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "not particularly strong,\nhad problems"
    } ]
  }, {
    "tStartMs": 130530,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "with high temperatures,\nbut got the job done."
    } ]
  }, {
    "tStartMs": 132398,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "When we first figured out\nhow to make magnets."
    } ]
  }, {
    "tStartMs": 134400,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "Virtually\nevery magnet was made out"
    } ]
  }, {
    "tStartMs": 135802,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "of iron or aluminum."
    } ]
  }, {
    "tStartMs": 137003,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "This type of magnet actually\nhelped win World War Two."
    } ]
  }, {
    "tStartMs": 139339,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "They were the foundation\nof the radar system"
    } ]
  }, {
    "tStartMs": 141174,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "that allowed Allied planes\nto see German U-boats."
    } ]
  }, {
    "tStartMs": 143576,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "So fittingly,\nit was two Air Force"
    } ]
  }, {
    "tStartMs": 145278,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "engineers who put cobalt\nand samarium together."
    } ]
  }, {
    "tStartMs": 147413,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "25 years after the war,"
    } ]
  }, {
    "tStartMs": 148915,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "the world's first rare\nearth magnet was born."
    } ]
  }, {
    "tStartMs": 150717,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "It was lighter, stronger\nand critically handled"
    } ]
  }, {
    "tStartMs": 152986,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "extreme temperatures\nvery well, but"
    } ]
  }, {
    "tStartMs": 154621,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "it started out expensive"
    } ]
  }, {
    "tStartMs": 155989,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "and then got more expensive"
    } ]
  }, {
    "tStartMs": 157223,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "as the Congo\nfell into a huge civil war."
    } ]
  }, {
    "tStartMs": 159659,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "This is the place where\n95% of cobalt came from."
    } ]
  }, {
    "tStartMs": 162362,
    "dDurationMs": 3069,
    "segs": [ {
      "utf8": "Still, the majority of it\ncomes from their prices rose"
    } ]
  }, {
    "tStartMs": 165431,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "and they rose a lot, up"
    } ]
  }, {
    "tStartMs": 166699,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "400% in less than a year."
    } ]
  }, {
    "tStartMs": 168234,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "So again, quite naturally,"
    } ]
  }, {
    "tStartMs": 169636,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "trying to escape these\nhigh prices, wanting"
    } ]
  }, {
    "tStartMs": 171738,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "more magnets, desperately"
    } ]
  }, {
    "tStartMs": 172972,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "wanting them to be cheaper."
    } ]
  }, {
    "tStartMs": 174374,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "Five years later,\ntwo companies who really saw"
    } ]
  }, {
    "tStartMs": 176910,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "the promise of magnets\nin everyday"
    } ]
  }, {
    "tStartMs": 178378,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "life, General Motors\nand the company"
    } ]
  }, {
    "tStartMs": 180280,
    "dDurationMs": 1434,
    "segs": [ {
      "utf8": "that would become Hitachi\nMetals,"
    } ]
  }, {
    "tStartMs": 181748,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "get on stage at a conference"
    } ]
  }, {
    "tStartMs": 183016,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "and reveal the neodymium"
    } ]
  }, {
    "tStartMs": 184417,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "iron boron magnet."
    } ]
  }, {
    "tStartMs": 185618,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "Now, this part"
    } ]
  }, {
    "tStartMs": 186352,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "of General Motors\nthat invented"
    } ]
  }, {
    "tStartMs": 187754,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "a version of these magnets."
    } ]
  }, {
    "tStartMs": 188755,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "As you'll see shortly,\nthis is not the end of"
    } ]
  }, {
    "tStartMs": 190690,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "their story."
    } ]
  }, {
    "tStartMs": 191224,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "They will go on\nto become central in that."
    } ]
  }, {
    "tStartMs": 193259,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "How did China manage"
    } ]
  }, {
    "tStartMs": 194294,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "to build a monopoly\naround this stuff?"
    } ]
  }, {
    "tStartMs": 195695,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "Question."
    } ]
  }, {
    "tStartMs": 196262,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "Anyway, these new magnets\nwere smaller,"
    } ]
  }, {
    "tStartMs": 198464,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "much cheaper, three times"
    } ]
  }, {
    "tStartMs": 199832,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "cheaper, more powerful."
    } ]
  }, {
    "tStartMs": 201034,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "This was the magnet\nthat would change the world."
    } ]
  }, {
    "tStartMs": 203269,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "GM used it immediately to"
    } ]
  }, {
    "tStartMs": 204537,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "cut the size of the starter\nmotor in all of its cars"
    } ]
  }, {
    "tStartMs": 206973,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "in half everything"
    } ]
  }, {
    "tStartMs": 208341,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "that would have been better\nwith a magnet or impossible"
    } ]
  }, {
    "tStartMs": 210443,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "without one started\ngetting one."
    } ]
  }, {
    "tStartMs": 212011,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "Power windows, power locks,\nwindshield wipers,"
    } ]
  }, {
    "tStartMs": 214080,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "cordless tools\nthat didn't feel like boat"
    } ]
  }, {
    "tStartMs": 215515,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "anchors, hard drives\nthat could finally fit"
    } ]
  }, {
    "tStartMs": 217717,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "serious storage\ninto a laptop,"
    } ]
  }, {
    "tStartMs": 219252,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "your phone, speakers,\nrefrigerators,"
    } ]
  }, {
    "tStartMs": 220954,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "the motors\nthat make electric cars"
    } ]
  }, {
    "tStartMs": 222455,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "a reality\ninstead of theoretical."
    } ]
  }, {
    "tStartMs": 224257,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "Try to escape\nrare earth magnets and you"
    } ]
  }, {
    "tStartMs": 226059,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "pay for it in size, weight,"
    } ]
  }, {
    "tStartMs": 227393,
    "dDurationMs": 1302,
    "segs": [ {
      "utf8": "efficiency, or price."
    } ]
  }, {
    "tStartMs": 228761,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "It's not a nice to have."
