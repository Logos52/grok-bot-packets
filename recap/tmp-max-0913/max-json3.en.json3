    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "because there is no private\nland."
    } ]
  }, {
    "tStartMs": 885818,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "The party owns it."
    } ]
  }, {
    "tStartMs": 886785,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "So you don't start a company\nthe way someone in Texas"
