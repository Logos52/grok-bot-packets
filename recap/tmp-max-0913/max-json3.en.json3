  }, {
    "tStartMs": 270403,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "there founded."
    } ]
  }, {
    "tStartMs": 272038,
    "dDurationMs": 734,
    "segs": [ {
      "utf8": "Every circle on"
    } ]
  }, {
    "tStartMs": 272772,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "this map is a rare earth\ndeposit,"
