  }, {
    "tStartMs": 238037,
    "dDurationMs": 1735,
    "segs": [ {
      "utf8": "almost all of it\nflowing into China,"
    } ]
  }, {
    "tStartMs": 239839,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "a country that was making"
