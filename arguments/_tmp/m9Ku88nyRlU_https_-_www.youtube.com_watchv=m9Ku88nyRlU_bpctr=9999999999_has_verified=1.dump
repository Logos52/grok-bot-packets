eColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgttOUt1ODhueVJsVSDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"85,336"},"label":{"simpleText":"Views"},"accessibilityText":"85,336 views","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963696,"raisedBackground":4294963696,"additiveBackground":566840389,"textPrimary":4281862663,"textSecondary":4286459690,"invertedBackground":4287569945,"overlayBackground":3426224647},"darkThemeColorPalette":{"baseBackground":4280091394,"raisedBackground":4281862663,"additiveBackground":734612549,"textPrimary":4294697183,"textSecondary":4293306019,"invertedBackground":4293100156,"overlayBackground":3426224647},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2020"},"label":{"simpleText":"Dec 10"},"accessibilityText":"Dec 10, 2020","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963696,"raisedBackground":4294963696,"additiveBackground":566840389,"textPrimary":4281862663,"textSecondary":4286459690,"invertedBackground":4287569945,"overlayBackground":3426224647},"darkThemeColorPalette":{"baseBackground":4280091394,"raisedBackground":4281862663,"additiveBackground":734612549,"textPrimary":4294697183,"textSecondary":4293306019,"invertedBackground":4293100156,"overlayBackground":3426224647},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBgQ040EGAYiEwiKw6fO7PyWAxX5fMIBHXlkJ5vKAQTmPtD5","commandMetadata":{"webCommandMetadata":{"url":"/@Design.Theory","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCdgUN8rX3SEb9L7FDub3I6A","canonicalBaseUrl":"/@Design.Theory"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_mmFSS2cAd4LdRJh9ciaIzjALeecdyyWXrIosmniOodbHs=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Show more"}},"simpleText":"...more"},"showLessText":{"simpleText":"Show less"},"attributedDescriptionBodyText":{"content":"Make a killer portfolio and land your dream design job. Enroll in my online industrial design course, Form Fundamentals. https://bit.ly/335vsqO .\n\nApple has finally released an over-ear headphone design: the AirPods Max. The industrial design innovations in comfort are especially interesting. With that said, I don't think this design is perfect, by any means. In this video, I'll talk about what Apple's industrial design team did really well, and maybe some areas that could be improved in the next generation of the design.\n\nJoin my mailing list to get notified of special announcements: https://www.studioello.com/mail\nJoin my discord channel and talk to me:   / discord  \nFollow me on Instagram:   / mauriellodesign  \nFollow me on LinkedIn:   / mauriellojohn  \nCheck out my Behance: https://www.behance.net/mauriellodesign\n\nWant to learn more about my work? Check out my portfolio: https://www.studioello.com\nWant to work with me on a design project? Contact me here: https://www.studioello.com/about-1\n\nJohn Mauriello has been working professionally as an industrial designer since 2010. He is an Adjunct Professor of industrial design at California College of the Arts.","commandRuns":[{"startIndex":121,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBgQ040EGAYiEwiKw6fO7PyWAxX5fMIBHXlkJ5tI1YzJz7zeq-mbAcoBBOY-0Pk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUZZTVljR2dFREdEclZnazdNXzd3akROS0NidHxBTl9pYzRmZGRfSGlwbndWeVlKTjkzTlpFaUNKWXJMdy1YQUM1VTg1T3Y3RUlYU1d6dUZ2bWZMdnlLLWZiUlhPcmVvUUxsNWFCRl83cTZ0aHVoa0hTbWlQaEd1eUJoR3lzS2Jy\u0026q=https%3A%2F%2Fbit.ly%2F335vsqO\u0026v=m9Ku88nyRlU","webPageType":