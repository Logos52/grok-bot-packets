{"post_stream":{"posts":[{"id":481236,"name":"Bello","username":"Bello","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/b/34f0e0/{size}.png","created_at":"2026-09-02T15:16:00.997Z","cooked":"\u003ch3\u003e\u003ca name=\"p-481236-feature-request-for-productservice-1\" class=\"anchor\" href=\"#p-481236-feature-request-for-productservice-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003eFeature request for product/service\u003c/h3\u003e\n\u003cp\u003e– Other –\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-481236-describe-the-request-2\" class=\"anchor\" href=\"#p-481236-describe-the-request-2\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDescribe the request\u003c/h3\u003e\n\u003cp\u003ePlease add a Plaid connector for Grok Bot.\u003c/p\u003e\n\u003cp\u003eI already linked my Scotia bank accounts and credit cards to Grok (xAI) via Plaid as a read-only feed. That connection does not reach Grok Bot or my finance agent. I want the same Plaid read-only bridge available in Grok Bot so it can use live transactions without opening the bank or dropping CSVs into Drive.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":6,"updated_at":"2026-09-04T10:21:08.223Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":188,"reads":11,"readers_count":10,"score":987.2,"yours":false,"topic_id":170359,"topic_slug":"add-a-plaid-connector-for-grok-bot-read-only-bank-feed","display_username":"Bello","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":false,"admin":false,"staff":false,"user_id":135764,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/add-a-plaid-connector-for-grok-bot-read-only-bank-feed/170359/1","reactions":[{"id":"heart","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":true},{"id":483119,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-04T10:20:55.097Z","cooked":"\u003cp\u003eHey, thanks for the feature request.\u003c/p\u003e\n\u003cp\u003eRight now, Grok Bot doesn’t have a first-party Plaid connector, and the Plaid connection from the Grok app doesn’t carry over to Grok Bot. They’re separate integrations. I passed this on to the team as a feature request. I can’t share a timeline yet, but if there’s an update, I’ll reply in the thread.\u003c/p\u003e\n\u003cp\u003eFor now, connectors in Grok Bot are added via the Marketplace: Settings \u0026gt; Plugins. If your financial service is in the catalog, you can add it there and authorize it in your browser. More details here: \u003ca href=\"https://cursor.com/help/grok-bot/connect-plugins\" class=\"inline-onebox\"\u003eConnect plugins | Cursor Docs\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eIf you find a suitable read-only connector for your accounts in the Marketplace, let me know how it goes.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":6,"updated_at":"2026-09-04T10:20:55.097Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":7,"reads":11,"readers_count":10,"score":87.2,"yours":false,"topic_id":170359,"topic_slug":"add-a-plaid-connector-for-grok-bot-read-only-bank-feed","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://cursor.com/help/grok-bot/connect-plugins","internal":false,"reflection":false,"title":"Connect plugins | Cursor Docs","clicks":9}],"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/add-a-plaid-connector-for-grok-bot-read-only-bank-feed/170359/5","reactions":[{"id":"heart","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":500665,"name":"Hugo","username":"_Hugo","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/_/919ad9/{size}.png","created_at":"2026-09-25T02:01:54.814Z","cooked":"\u003cp\u003eJust want to add my voice to this feature request. Grok Bot integration with Plaid would be really useful to pull read-only financial information from banks and other institutions.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":6,"updated_at":"2026-09-25T02:01:54.814Z","reply_count":0,"reply_to_post_number":5,"quote_count":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":0.8,"yours":false,"topic_id":170359,"topic_slug":"add-a-plaid-connector-for-grok-bot-read-only-bank-feed","display_username":"Hugo","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_te