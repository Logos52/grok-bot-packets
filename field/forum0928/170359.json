n_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":500829,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-25T09:20:06.714Z","cooked":"\u003cp\u003eHey, thanks for the support, \u003ca class=\"mention\" href=\"/u/_hugo\"\u003e@_Hugo\u003c/a\u003e and \u003ca class=\"mention\" href=\"/u/alvin_leung\"\u003e@Alvin_Leung\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eGrok Bot doesn’t have a first-party Plaid connector yet, and the connection from the Grok app doesn’t carry over to Grok Bot. They’re separate integrations. I’ve passed the request to the team and it’s on their radar. I can’t share a timeline, but if there’s an update, I’ll reply here.\u003c/p\u003e\n\u003cp\u003eFor now, connectors in Grok Bot are added via the Marketplace: Settings \u0026gt; Plugins. If you find a suitable read-only connector for your accounts in the catalog, or a third-party read-only finance MCP, you can connect it to the finance agent today. More details: \u003ca href=\"https://cursor.com/help/grok-bot/connect-plugins\" class=\"inline-onebox\"\u003eConnect plugins | Cursor Docs\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eIf you try a connector, let me know how it goes.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":6,"updated_at":"2026-09-25T09:20:06.714Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":3,"readers_count":2,"score":10.6,"yours":false,"topic_id":170359,"topic_slug":"add-a-plaid-connector-for-grok-bot-read-only-bank-feed","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hid