 stopping hitting Reset.\u003c/p\u003e\n\u003cp\u003eWhat you’re describing is happening on the Agent Computer side, not in your setup. Reset and Update can’t finish because the computer is stuck in an in-between state on the backend, and it can’t be fixed from the client. We’ll need to do a manual recovery on our side.\u003c/p\u003e\n\u003cp\u003eGood news, your bots, chats, and files are safe. While recovery is in progress, please don’t click Reset or Update, don’t reinstall the app, and don’t log out. That can make recovery harder.\u003c/p\u003e\n\u003cp\u003eWe’re tracking this issue. I’ve asked the team to recover the computer on our side. I’ll reply here as soon as I have an update.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":6,"updated_at":"2026-09-05T08:05:26.232Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":4,"reads":15,"readers_count":14,"score":58.0,"yours":false,"topic_id":170661,"topic_slug":"grok-bot-0-43-0-bot-failed-to-respond-reset-agent-computer-stuck-in-partial-state","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-0-43-0-bot-failed-to-respond-reset-agent-computer-stuck-in-partial-state/170661/5","reactions":[{"id":"+1","type":"emoji","count":1},{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main