{"post_stream":{"posts":[{"id":491146,"name":"","username":"mwjt42","avatar_template":"/user_avatar/forum.cursor.com/mwjt42/{size}/7270_2.png","created_at":"2026-09-14T18:47:50.360Z","cooked":"\u003ch3\u003e\u003ca name=\"p-491146-feature-request-for-productservice-1\" class=\"anchor\" href=\"#p-491146-feature-request-for-productservice-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003eFeature request for product/service\u003c/h3\u003e\n\u003cp\u003e– Other –\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-491146-describe-the-request-2\" class=\"anchor\" href=\"#p-491146-describe-the-request-2\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDescribe the request\u003c/h3\u003e\n\u003cp\u003eHi, a QoL improvement would be that if I’m working with the bots on desktop, and seeing replies, that my phones don’t keep going off during those sessions!\u003c/p\u003e\n\u003cp\u003eThanks\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":4,"updated_at":"2026-09-14T18:47:57.022Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":5,"reads":2,"readers_count":1,"score":25.4,"yours":false,"topic_id":171654,"topic_slug":"feature-request-grok-bot-disable-phone-notifications-when-using-desktop","display_username":"","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":989,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/feature-request-grok-bot-disable-phone-notifications-when-using-desktop/171654/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":true},{"id":491182,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-14T19:23:04.666Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/mwjt42\"\u003e@mwjt42\u003c/a\u003e, thanks for the suggestion!\u003c/p\u003e\n\u003cp\u003eSome of this is already in place: while the Grok Bot desktop window is in front and focused, replies from any of your Bots should not ping your phone. Where it still falls through today is when the desktop app is open but not the focused window (for example on a second monitor while you work in another app), or when you switch away in the few seconds after a reply lands.\u003c/p\u003e\n\u003cp\u003eSmarter cross-device quieting, closer to how Slack handles it, is something the team is actively looking at. No timeline to share yet.\u003c/p\u003e\n\u003cp\u003eCould you tell us which case you are hitting: is the Grok Bot window focused when the phone buzzes, or is it in the background? And is it every Bot, or just some?\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":4,"updated_at":"2026-09-14T19:23:04.666Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":3,"readers_count":2,"score":0.6,"yours":false,"topic_id":171654,"topic_slug":"feature-request-grok-bot-disable-phone-notifications-when-using-desktop","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/feature-request-grok-bot-disable-phone-notifications-when-using-desktop/171654/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":491209,"name":"","username":"mwjt42","avatar_template":"/user_avatar/forum.cursor.com/mwjt42/{size}/7270_2.png","created_at":"2026-09-14T19:56:35.477Z","cooked":"\u003cp\u003eThanks for the quick response.\u003c/p\u003e\n\u003cp\u003eIt’s doesn’t seem to be working at all on my set up.\u003c/p\u003e\n\u003cp\u003eWith the Desktop window focused (Windows), both my Android phones ping, on all bots. Because I have it on 2 phones it’s doubly annoying!\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":4,"updated_at":"2026-09-14T19:56:35.477Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":3,"readers_count":2,"score":0.6,"yours":false,"topic_id":171654,"topic_slug":"feature-request-grok-bot-disable-phone-notifications-when-using-desktop","display_username":"","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":989,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/feature-request-grok-bot-disable-phone-notifications-when-using-desktop/171654/6","reactions":[],"current_user_reaction":null,"reacti