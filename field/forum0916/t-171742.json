ursor app (Agent, Composer, Tab, cloud agents), so Grok Bot activity does not move them. You can see the Grok Bot meter inside the Grok Bot app itself.\u003c/p\u003e\n\u003cp\u003eTwo exceptions worth knowing about:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eIf you ask Grok Bot to launch a Cursor cloud agent, that agent runs in Cursor and counts toward your Cursor plan like any other cloud agent.\u003c/li\u003e\n\u003cli\u003eOnce the weekly Grok Bot allowance reaches 100%, further Grok Bot usage can spill into on-demand usage if you have on-demand enabled. If you want a hard stop instead, set the on-demand limit to $0 under Dashboard, Billing.\u003c/li\u003e\n\u003c/ol\u003e","post_number":5,"post_type":1,"posts_count":2,"updated_at":"2026-09-15T13:16:16.249Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":9,"readers_count":8,"score":16.8,"yours":false,"topic_id":171742,"topic_slug":"does-grok-bot-consume-cursor-quota","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/does-grok-bot-consume-cursor-quota/171742/5","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":true,"topic_accepted_