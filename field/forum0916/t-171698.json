9:0\"\u003e\u003c/span\u003e No - Cursor works, but with this issue\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/details\u003e\n\u003cp\u003eThe more details you provide, the easier it is for us to reproduce and fix the issue. Thanks!\u003c/p\u003e","post_number":2,"post_type":1,"posts_count":3,"updated_at":"2026-09-15T04:46:45.619Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":9,"readers_count":8,"score":1.8,"yours":false,"topic_id":171698,"topic_slug":"grokbot-failing-to-respond","display_username":"system","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"http://cursor.com/agents","internal":false,"reflection":false,"clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":-1,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grokbot-failing-to-respond/171698/2","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":491530,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-15T08:06:50.501Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/stoplion123\"\u003e@stoplion123\u003c/a\u003e, thanks for the report, and sorry about that.\u003c/p\u003e\n\u003cp\u003eBoth messages came from the same thing: the cloud computer that runs your Bots got stuck on our side. It kept telling our servers it was healthy, so it was never replaced automatically, but every real request to it was failing. That is why the phone said it couldn’t reach your computer and why Crombo stopped answering.\u003c/p\u003e\n\u003cp\u003eThe Reset you ran from the desktop app a couple of minutes after posting did the right thing. A fresh computer came up with your Bots and files preserved, and Crombo replied successfully about five minutes later, so it should be working now.\u003c/p\u003e\n\u003cp\u003eOn the phone, if it still shows “Can’t reach your computer”, swipe the Grok Bot app closed and reopen it once so it picks up the new computer.\u003c/p\u003e\n\u003cp\u003eLet us know if it’s working again!\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":3,"updated_at":"2026-09-15T08:06:50.501Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":0.8,"yours":false,"topic_id":171698,"topic_slug":"grokbot-failing-to-respond","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grokbot-failing-to-respond/171698/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[491420,491421,491530]},"timeline_lookup":[[1,1]],"suggested_topics":[],"tags":[{"id":416,"name":"grok-bot","slug