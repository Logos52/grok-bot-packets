154,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":"latest","description":"Original Poster, Most Recent Poster","user":{"id":136238,"username":"oscar_mei","name":"oscar mei","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/o/3da27b/{size}.png","trust_level":0}},{"extras":null,"description":"Recent Poster","user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":497266,"name":"Kevin Neilson","username":"kevinn","avatar_template":"/user_avatar/forum.cursor.com/kevinn/{size}/101206_2.png","created_at":"2026-09-21T18:08:49.588Z","cooked":"\u003cp\u003eHi \u003ca class=\"mention\" href=\"/u/nhog\"\u003e@nhog\u003c/a\u003e thanks for the report, and sorry about this.\u003c/p\u003e\n\u003cp\u003eWhat you saw is the automatic update of your Grok Bot’s computer. It builds a fresh computer and copies your data over, and that copy step has been getting stuck for some people over the last couple of days. Your existing computer, bots and files are untouched while it runs, so nothing was lost.\u003c/p\u003e\n\u003cp\u003eOn our side the update for your account gave up at about 2:22 PM your time (roughly 20 minutes after your screenshot), the dialog should have cleared, and your bots should be back on the computer you had before. The team has since rolled out a change for the stuck copy step, so a future update should go through normally.\u003c/p\u003e\n\u003cp\u003eTwo things worth knowing:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003ePlease don’t press Reset if it happens again. It isn’t needed and it wipes the computer. Giving the update about an hour to finish or give up on its own is the safe move.\u003c/li\u003e\n\u003cli\u003eThe Grok Bot mobile app keeps working during an update, since only the desktop is covered by that dialog.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eCould you confirm your bots are responding again? If the dialog comes back or a bot is still stuck, reply here and I’ll take another look.\u003c/p\u003e","post_number":6,"topic_id":172535,"url":"/t/grokbot-unavailable-hung-on-updating-grok-bot-s-computer-at-43/172535/6","accepter_name":"Neto Hog","accepter_username":"nhog"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":105146,"username":"kevinn","name":"Kevin Neilson","avatar_template":"/user_avatar/forum.cursor.com/kevinn/{size}/101206_2.png","post_count":4,"primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_color":"","flair_bg_color":"","flair_group_id":42,"admin":true,"moderator":true,"trust_level":3},{"id":139324,"username":"Raymond_Bell","name":"Raymond Bell","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/r/278dde/{size}.png","post_count":2,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":1},{"id":139470,"username":"toneill","name":"TO","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/t/bc8723/{size}.png","post_count":1,"primary_group_name":null,"flair_name":null,