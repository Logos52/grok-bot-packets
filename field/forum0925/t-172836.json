rum.cursor.com/system/{size}/99069_2.png","admin":true,"moderator":true,"trust_level":4}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":499557,"name":"Kevin Neilson","username":"kevinn","avatar_template":"/user_avatar/forum.cursor.com/kevinn/{size}/101206_2.png","created_at":"2026-09-24T00:44:37.252Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/david.j\"\u003e@David.J\u003c/a\u003e, thanks for the report!\u003c/p\u003e\n\u003cp\u003eThe screen view moved rather than went away. In 0.58.0, the separate computer button in the top right was folded into the Bot’s name at the top center of the chat. To get back to it:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eOpen the Bot’s chat.\u003c/li\u003e\n\u003cli\u003eClick the Bot’s name at the top center of the window. A panel opens on the right showing the Bot’s settings.\u003c/li\u003e\n\u003cli\u003eClick the back arrow (“Back to details”) at the top left of that panel.\u003c/li\u003e\n\u003cli\u003eThe live screen preview is at the top of the panel. Click it to open the full computer view.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eYou can also toggle that panel with \u003cem\u003e\u003cstrong\u003eCmd+Shift+I\u003c/strong\u003e\u003c/em\u003e.\u003c/p\u003e","post_number":6,"topic_id":172836,"url":"/t/bots-screen-view-disappeared/172836/6","accepter_name":"","accepter_username":"David.J"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":138401,"username":"David.J","name":"","avatar_template":"/user_avatar/forum.cursor.com/david