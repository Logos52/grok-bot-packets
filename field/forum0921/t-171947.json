{"post_stream":{"posts":[{"id":493398,"name":"Luke Adams","username":"Luke_Adams","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/l/a698b9/{size}.png","created_at":"2026-09-17T02:33:46.569Z","cooked":"\u003cp\u003eMy bots are currently stuck and I dont know what to do\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-17T02:33:55.604Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":8,"reads":4,"readers_count":3,"score":40.8,"yours":false,"topic_id":171947,"topic_slug":"my-bots-are-stuck","display_username":"Luke Adams","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":138286,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/my-bots-are-stuck/171947/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":495659,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-19T11:08:12.537Z","cooked":"\u003cp\u003eHey Luke. I checked and everything looks fine with the bots and Agent Computer, so it’s not them. It looks like your Grok Bot trial usage is fully used up, so every message after that gets rejected before the bot can reply. Right now the chat doesn’t show this, it just looks like everything is stuck.\u003c/p\u003e\n\u003cp\u003eYou can confirm it like this: in Grok Bot, open Settings \u0026gt; Usage.