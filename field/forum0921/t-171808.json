_like_count": 0, "has_accepted_answer": false, "posters": [{"extras": null, "description": "Original Poster", "user": {"id": 137055, "username": "robobobo", "name": "", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/r/c68b51/{size}.png", "trust_level": 1}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 137241, "username": "glittle", "name": "Glen Little", "avatar_template": "/user_avatar/forum.cursor.com/glittle/{size}/120521_2.png", "trust_level": 0}}, {"extras": null, "description": "Frequent Poster", "user": {"id": 137238, "username": "RoamPT", "name": "", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/r/b19c9b/{size}.png", "trust_level": 0}}, {"extras": null, "description": "Recent Poster", "user": {"id": 103596, "username": "mohitjain", "name": "Mohit", "avatar_template": "/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png", "flair_name": "CursorStaff", "flair_url": "https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png", "flair_group_id": 42, "primary_group_name": "CursorStaff", "admin": true, "moderator": true, "trust_level": 4}}, {"extras": "latest", "description": "Most Recent Poster", "user": {"id": 137424, "username": "bradandhaze", "name": "Bradandhaze", "avatar_template": "/user_avatar/forum.cursor.com/bradandhaze/{size}/120645_2.png", "trust_level": 0}}]}, {"fancy_title": "Grok Bot doesn&rsquo;t log in to the computer", "id": 171384, "title": "Grok Bot doesn't log in to the computer", "slug": "grok-bot-doesnt-log-in-to-the-computer", "posts_count": 3, "reply_count": 1, "highest_post_number": 9, "image_url": null, "created_at": "2026-09-11T19:05:24.718Z", "last_posted_at": "2026-09-11T23:02:16.266Z", "bumped": true, "bumped_at": "2026-09-11T23:02:16.266Z", "archetype": "regular", "unseen": false, "pinned": false, "unpinned": null, "excerpt": "ya lo resolvi, era el antivirus", "visible": true, "closed": true, "archived": false, "bookmarked": null, "liked": null, "thumbnails": null, "visibility_reason_id": 4, "tags": [{"id": 416, "name": "grok-bot", "slug": "grok-bot"}], "tags_descriptions": {}, "like_count": 0, "views": 47, "category_id": 6, "featured_link": null, "op_like_count": 0, "has_accepted_answer": true, "posters": [{"extras": "latest", "description": "Original Poster, Most Recent Poster, Accepted Answer", "user": {"id": 137370, "username": "Esteban1", "name": "Esteban", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/e/e19adc/{size}.png", "trust_level": 0}}, {"extras": null, "description": "Recent Poster", "user": {"id": -1, "username": "system", "name": "system", "avatar_template": "/user_avatar/forum.cursor.com/system/{size}/99069_2.png", "admin": true, "moderator": true, "trust_level": 4}}]}], "summarizable": false, "has_cached_summary": false, "valid_reactions": ["heart", "+1", "crossed_fingers", "clap", "laughing", "open_mouth", "confetti_ball", "hugs", "heavy_plus_sign", "heart_eyes", "sunglasses", "cursor"], "accepted_answers": [{"id": 492292, "name": "Dean Rie", "username": "deanrie", "avatar_template": "/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png", "created_at": "2026-09-16T05:02:13.630Z", "cooked": "<p>Hey, thanks for the detailed report and especially for testing on Ubuntu and your phone. That comparison is the key clue. I see both screenshots, the splash screen saying \u201chaving trouble connecting\u201d and the main UI saying \u201cCan\u2019t reach your computer\u201d.</p>\n<p>On our side, the Grok Bot computer has been up and running the whole time. Your phone and Ubuntu on the same hardware can reach it fine, but the Windows app stopped sending requests to us. \u201cReset failed\u201d here means the request never left your PC, so it\u2019s best not to click Recover or Reset right now. Your Bots are safe.</p>\n<p>Everything points to something on Windows intercepting HTTPS. Grok Bot uses its own certificate store, so any product that re-signs encrypted traffic, like Kaspersky\u2019s \u201cEncrypted connections scanning\u201d, breaks it. Cursor, browsers, and curl keep working because they trust the Windows system certificate store. This also explains why Ubuntu on the same hardware and network is fine. One important detail is that fully disabling the antivirus often still leaves the scanning driver active, so just \u201cturning off Kaspersky\u201d might not help.</p>\n<p>Can you check this and tell me what you see?</p>\n<ol>\n<li>In Edge or Chrome on Windows, open <a href=\"https://api2.cursor.sh\">https://api2.cursor.sh</a>. A blank page or an error is OK.</li>\n<li>Click the lock icon in the address bar, then Connection is secure, then the certificate icon.</li>\n<li>Check the Issued by field. It should be <code>Amazon RSA 2048 M01</code>. If it says Kaspersky or anything else, that\u2019s the interception.</li>\n<li>If yes, open Kaspersky, Settings, Security settings, Network settings, Encrypted connections scanning, and choose Do not scan encrypted connections. Another option is to add Grok Bot under Threats and Exclusions as a trusted application with Do not scan encrypted traffic.</li>\n<li>Fully quit Grok Bot, right click the tray icon, Quit, then confirm in Task Manager there are no Grok Bot processes left. Start it again and give it a couple minutes.</li>\n</ol>\n<p>If the issuer already shows Amazon and the problem still happens, please attach this file: <code>%APPDATA%\\Grok Bot\\desktop-structured-log-spill.v1.json</code>. Paste <code>%APPDATA%</code> into the Explorer address bar. It contains the app\u2019s own connection errors from the last about 18 hours, which we can\u2019t see from our side.</p>\n<p>About IPv6, our servers only publish IPv4 addresses, so IPv6 can\u2019t be the cause by itself. The difference between the splash screen and the sidebar depends on whether the app had a saved list of Bots to display, not on the network.</p>", "post_number": 5, "topic_id": 171808, "url": "/t/grok-bot-stuck-in-partial-state-reset-failed-network-dns-already-tested/171808/5", "accepter_name": "Max Maldonado", "accepter_username": "Max_Maldonado"}], "has_accepted_answer": true, "can_create_shared_issue": false, "shared_issue_visible": false, "can_vote": false, "vote_count": 0, "user_voted": false, "discourse_zendesk_plugin_zendesk_id": null, "discourse_zendesk_plugin_zendesk_url": "https://your-url.zendesk.com/agent/tickets/", "details": {"can_edit": false, "notification_level": 1, "participants": [{"id": 138017, "username": "Max_Maldonado", "name": "Max Maldonado", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/m/a587f6/{size}.png", "post_count": 2, "primary_group_name": null, "flair_name": null, "flair_url": null, "flair_color": null, "flair_bg_color": null, "flair_group_id": null, "trust_level": 0}, {"id": 750, "username": "deanrie", "name": "Dean Rie", "avatar_template": "/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png", "post_count": 1, "primary_group_name": "CursorStaff", "flair_name": "CursorStaff", "flair_url": "https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png", "flair_color": "", "flair_bg_color": "", "flair_group_id": 42, "admin": true, "moderator": true, "trust_level": 4}], "created_by": {"id": 138017, "username": "Max_Maldonado", "name": "Max Maldonado", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/m/a587f6/{size}.png"}, "last_poster": {"id": 138017, "username": "Max_Maldonado", "name": "Max Maldonado", "avatar_template": "https://avatars.discourse-cdn.com/v4/letter/m/a587f6/{size}.png"}, "links": [{"url": "https://api2.cursor.sh", "title": null, "internal": false, "attachment": false, "reflection": false, "clicks": 3, "user_id": 750, "domain": "api2.cursor.sh", "root_domain": "cursor.sh"}]}, "bookmarks": []}