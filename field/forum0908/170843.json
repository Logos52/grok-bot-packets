/cursor1/optimized/3X/a/e/ae0b0fb8949783ae2640b4dca7a5b97ac406e2c6_2_1294x1000.png 2x\" data-dominant-color=\"EFEEEF\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003eimage\u003c/span\u003e\u003cspan class=\"informations\"\u003e1848×1426 218 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":4,"updated_at":"2026-09-07T04:09:37.932Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":5,"readers_count":4,"score":6.0,"yours":false,"topic_id":170843,"topic_slug":"grokbot-can-not-send-msgs-agents-virtual-machine-is-still-visible","display_username":"zyzhou","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":136531,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grokbot-can-not-send-msgs-agents-virtual-machine-is-still-visible/170843/5","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":true,"topic_accepted_answer":true},{"id":484838,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-07T04:30:08.871Z","cooked":"\u003cp\u003eHey, glad it’s working. And yes, you understood correctly. It wasn’t your Mac or the Android app, and it wasn’t the update to 0.44.0. Some Grok Bot computers, including yours, temporarily lost connection to our servers, so sending failed on all devices even though the computer screen was still visible. This is on our side, and we’re tracking it.\u003c/p\u003e\n\u003cp\u003eOne note about Reset. It rebuilds the computer from the last saved snapshot, so the most recent changes made right before the issue might not be restored. If you notice anything missing in the history or bot settings, let us know and we’ll take a look.\u003c/p\u003e\n\u003cp\u003eIf you hit the same freeze again, please message us here first before doing a Reset. In most cases the connection comes back on our side by itself, without any data loss.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":4,"updated_at":"2026-09-07T04:30:08.871Z","reply_count":1,"reply_to_post_number":5,"quote_count":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":5.8,"yours":false,"topic_id":170843,"topic_slug":"grokbot-can-not-send-msgs-agents-virtual-machine-is-still-visible","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","reply_to_user":{"id":136531,"username":"zyzhou-saffron","name":"zyzhou","avatar_template":"/user_avatar/forum.cursor.com/zyzhou-saffron/{size}/120094_2.png"},"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grokbot-can-not-send-msgs-agents-virtual-machine-is-still-visible/170843/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":485145,"name":"Philippe Wong","username":"Philippe_Wong","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/p/e19adc/{size}.png","created_at":"2026-09-07T10:03:10.741Z","cooked":"\u003cp\u003eHi Dean Rie, I’m experiencing the same issue and it is still ongoing.\u003c/p\u003e\n\u003cp\u003eEvery one of my Grok Bots fails with “Bot failed to respond,” including a simple health check that uses no tools, connectors, search, memory, or files.\u003c/p\u003e\n\u003cp\u003eDetails:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\n\u003cp\u003eGrok Bot for macOS, version 0.44.0, Stable track\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eApp is fully up to date\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eFully quitting with Cmd+Q and reopening did not resolve it\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eBot roster and conversation history remain visible\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eApproximate start: September 7, 2026, around 5:29 PM MYT (UTC+8)\u003c/p\u003e\n\u003c/li\u003e\n\u003cli\u003e\n\u003cp\u003eRequest ID: \u003ccode\u003e7c3fcc19-f7c9-4f21-afa5-9adc5a599ca3\u003c/code\u003e\u003c/p\u003e\n\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eI tried “Update Grok’s Computer” but not Reset because the workspace contains important recent files and I want to avoid losing changes. After selecting that, I seem to have “Backup not ready” as a new status that’s been stuck that way for a while.\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://us1.discourse-cdn.com/cursor1/original/3X/f/f/ffecbd9aad29376931ccd70323da2a1c7306e6b2.png\" data-download-href=\"/uploads/short-url/Aw0Y6yXJFElCTsVywROZKXFPVdg.png?dl=1\" title=\"Screenshot 2026-09-07 at 5.59.52 PM\" rel=\"noopener nofollow ugc\"\u003e\u003cimg src=\"https://us1.discourse-cdn.com/cursor1/optimized/3X/f/f/ffecbd9aad29376931ccd70323da2a1c7306e6b2_2_690x109.png\" alt=\"Screenshot 2026-09-07 at 5.59.52 PM\" data-base62-sha1=\"Aw0Y6yXJFElCTsVywROZKXFPVdg\" width=\"690\" height=\"109\" srcset=\"https://us1.discourse-cdn.com/cursor1/optimized/3X/f/f/ffecbd9aad29376931ccd70323da2a1c7306e6b2_2_690x109.png, https://us1.discourse-cdn.com/cursor1/optimized/3X/f/f/ffecbd9aad29376931ccd70323da2a1c7306e6b2_2_1035x163.png 1.5x, https://us1.discourse-cdn.com/cursor1/optimized/3X/f/f/ffecbd9aad29376931ccd70323da2a1c7306e6b2_2_1380x218.png 2x\" data-dominant-color=\"F1ECED\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003eScreenshot 2026-09-07 at 5.59.52 PM\u003c/span\u003e\u003cspan class=\"informations\"\u003e1764×280 25.2 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e\n\u003cp\u003eGiven that this appears to be the server-side connection issue you described, could you please check?\u003c/p\u003e\n\u003cp\u003ePlease let me know if you need my account email or any additional diagnostic information privately. Thank you.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":4,"updated_at":"2026-09-07T10:03:10.741Z","reply_count":0,"reply_to_post_number":6,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":170843,"topic_slug":"grokbot-can-not-send-msgs-agents-virtual-machine-is-still-visible","display_username":"Philippe Wo