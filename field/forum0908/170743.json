angs on startup\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-484328-does-this-stop-you-from-using-cursor-7\" class=\"anchor\" href=\"#p-484328-does-this-stop-you-from-using-cursor-7\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDoes this stop you from using Cursor\u003c/h3\u003e\n\u003cp\u003eYes - Cursor is unusable\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":4,"updated_at":"2026-09-06T03:06:16.351Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":10,"reads":5,"readers_count":4,"score":51.0,"yours":false,"topic_id":170743,"topic_slug":"stuck-on-black-screen-with-white-dot-after-setting-up-grok-bots-computer","display_username":"Ronald Naners","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":136387,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/stuck-on-black-screen-with-white-dot-after-setting-up-grok-bots-computer/170743/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":485097,"name":"Mohit","username":"mohitjain","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png","created_at":"2026-09-07T09:10:08.554Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/ronald_naners\"\u003e@Ronald_Naners\u003c/a\u003e,\u003c/p\u003e\n\u003cp\u003eThis one’s on our side, not anything with your network or your installs. The cloud computer that runs your bots became unresponsive on our end, so the app was left waiting for it on every device, which is why both your PC and your iPhone showed the same loading screen.\u003c/p\u003e\n\u003cp\u003eWe’ve restored it. Your bots and conversations are kept in a synced backup, so they should come back with it.\u003c/p\u003e\n\u003cp\u003eTo reconnect: fully quit Grok Bot (right-click the tray icon and choose Quit rather than just closing the window), reopen it, and give it a minute. On your iPhone, close the app fully and reopen it.\u003c/p\u003e\n\u003cp\u003eIf it still gets stuck after that, reply here and we’ll take another look.\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":4,"updated_at":"2026-09-07T09:10:08.554Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":2,"reads":5,"readers_count":4,"score":16.0,"yours":false,"topic_id":170743,"topic_slug":"stuck-on-black-screen-with-white-dot-after-setting-up-grok-bots-computer","display_username":"Mohit","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":103596,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/stuck-on-black-screen-with-white-dot-after-setting-up-grok-bots-computer/170743/10","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":485446,"name":"Param Mehta","username":"Parammehta","avatar_templat