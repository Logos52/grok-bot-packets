d/3X/5/d/5d693508b507875abc4215274251a6c929373807_2_800x634.png"},{"max_width":750,"max_height":750,"width":750,"height":595,"url":"https://us1.discourse-cdn.com/cursor1/optimized/3X/5/d/5d693508b507875abc4215274251a6c929373807_2_750x595.png"},{"max_width":600,"max_height":600,"width":600,"height":476,"url":"https://us1.discourse-cdn.com/cursor1/optimized/3X/5/d/5d693508b507875abc4215274251a6c929373807_2_600x476.png"},{"max_width":500,"max_height":500,"width":500,"height":396,"url":"https://us1.discourse-cdn.com/cursor1/optimized/3X/5/d/5d693508b507875abc4215274251a6c929373807_2_500x396.png"},{"max_width":400,"max_height":400,"width":400,"height":317,"url":"https://us1.discourse-cdn.com/cursor1/optimized/3X/5/d/5d693508b507875abc4215274251a6c929373807_2_400x317.png"},{"max_width":300,"max_height":300,"width":300,"height":238,"url":"https://us1.discourse-cdn.com/cursor1/optimized/3X/5/d/5d693508b507875abc4215274251a6c929373807_2_300x238.png"},{"max_width":200,"max_height":200,"width":200,"height":158,"url":"https://us1.discourse-cdn.com/cursor1/optimized/3X/5/d/5d693508b507875abc4215274251a6c929373807_2_200x158.png"}],"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"},{"id":408,"name":"networking","slug":"networking"}],"tags_descriptions":{},"like_count":0,"views":81,"category_id":8,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":null,"description":"Original Poster","user":{"id":136807,"username":"prashant_kumar1","name":"prashant kumar","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/p/9fc348/{size}.png","trust_level":0}},{"extras":"latest","description":"Most Recent Poster","user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":490138,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-13T15:56:27.270Z","cooked":"\u003cp\u003eHey, thanks for the detailed report. Good news first: your Agent Computer is alive on our side, and all Bots are still there. Nothing is lost.\u003c/p\u003e\n\u003cp\u003eWhat’s happening: the app can reach our servers fine, but your network can’t resolve the address (DNS) that the app uses to connect specifically to the Agent Computer. This check happens on your network side, so reinstalling, Reset, signing out and back in, and Privacy Mode wouldn’t change anything. Rebuilding the computer on the backend won’t help either: a new computer gets an address in the same zone that your resolver can’t resolve. So for now, don’t press Reset or Recover. Each click just rebuilds the computer for no reason.\u003c/p\u003e\n\u003cp\u003eWhat to try:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eFully close Grok Bot right click the tray icon near the clock, then Quit.\u003c/li\u003e\n\u003cli\u003eWindows Settings \u0026gt; Network and internet \u0026gt; pick your connection Wi-Fi or Ethernet.\u003c/li\u003e\n\u003cli\u003eNext to DNS server assignment click Edit \u0026gt; Manual \u0026gt; enable IPv4 \u0026gt; Preferred DNS: \u003ccode\u003e1.1.1.1\u003c/code\u003e, Alternate DNS: \u003ccode\u003e8.8.8.8\u003c/code\u003e \u0026gt; Save.\u003c/li\u003e\n\u003cli\u003eCheck Settings \u0026gt; Apps \u0026gt; Installed apps. If Grok Bot is installed twice, uninstall the older one and keep only the latest version.\u003c/li\u003e\n\u003cli\u003eLaunch Grok Bot again and give it 15 to 20 minutes.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eQuick double-check: connect your PC to your phone hotspot on a different carrier not Jio and open Grok Bot. If it connects there, the issue is your usual network DNS.\u003c/p\u003e\n\u003cp\u003eLet me know how it goes. If it still doesn’t connect after step 5, tell me and we’ll dig deeper.\u003c/p\u003e","post_number":5,"topic_id":171514,"url":"/t/grok-bot-stuck-on-reconnecting-for-2-weeks-anmol-ratan/171514/5","accepter_name":"Anmol Ratan","accepter_username":"Anmol_Ratan"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":137597,"username":"Anmol_Ratan","name":"Anmol Ratan","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3e96dc/{size}.png","post_count":2,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":0},{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","post_count":1,"primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_color":"","flair_bg_color":"","flair_group_id":42,"admin":true,"moderator":true,"trust_level":4}],"created_by":{"id":137597,"username":"Anmol_Ratan","name":"Anmol Ratan","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3e96dc/{size}.png"},"last_poster":{"id":137597,"username":"Anmol_Ratan","name":"Anmol Ratan","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/3e96dc/{size}.png"}},"bookmarks":[]}