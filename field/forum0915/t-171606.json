1,"username":"system","name":"system","avatar_template":"/user_avatar/forum.cursor.com/system/{size}/99069_2.png","admin":true,"moderator":true,"trust_level":4}},{"extras":null,"description":"Recent Poster","user":{"id":103596,"username":"mohitjain","name":"Mohit","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}}]},{"fancy_title":"Checks completed skips Cursor-agent PRs → forced long cloud-agent polls","id":167712,"title":"Checks completed skips Cursor-agent PRs → forced long cloud-agent polls","slug":"checks-completed-skips-cursor-agent-prs-forced-long-cloud-agent-polls","posts_count":7,"reply_count":6,"highest_post_number":12,"image_url":null,"created_at":"2026-08-07T16:11:22.430Z","last_posted_at":"2026-08-14T12:44:40.419Z","bumped":true,"bumped_at":"2026-08-14T12:44:40.419Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"Where does the bug appear (feature/product)?\nCloud Agent (GitHub, Slack, Web, Linear) \nDescribe the Bug\nGitHub “Checks completed” automations do not fire for PRs created/pushed by the Cursor cloud agent (app/cursor / cur\u0026hellip;","visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"thumbnails":null,"tags":[{"id":312,"name":"cloud-agents","slug":"cloud-agents"},{"id":314,"name":"github","slug":"github"},{"id":376,"name":"automations","slug":"automations"}],"tags_descriptions":{},"like_count":2,"views":112,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":"latest","description":"Original Poster, Most Recent Poster","user":{"id":128756,"username":"Ronnie_Kilsbo","name":"Ronnie Kilsbo","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/r/df705f/{size}.png","trust_level":2}},{"extras":null,"description":"Recent Poster","user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":490875,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-14T13:40:56.802Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/alex0\"\u003e@Alex0\u003c/a\u003e, thanks for the report, and welcome to Grok Bot!\u003c/p\u003e\n\u003cp\u003eThis is not related to your plan. Pro and Pro+ both include routines, so the downgrade is not what you are hitting.\u003c/p\u003e\n\u003cp\u003eWhat you are seeing is a known issue on our side: newer Bots keep their routines on the server, and for those Bots the desktop app currently shows the routine panel in read-only mode and does not display the Webhook URL, key, or Authorization header for a webhook routine. The links the Bot gives you open that same panel, which is why there is nothing to copy. Recreating the routine or creating another Bot will not change this. We are tracking it and I have added your report.\u003c/p\u003e\n\u003cp\u003eUnfortunately, there is no way to get the webhook URL for these Bots yet. In the meantime, two triggers do work normally: ask the Bot to run the routine on a schedule (for example “run this every morning at 9”), or connect Slack and have it trigger when you send a message in a channel.\u003c/p\u003e\n\u003cp\u003eFor the on/off and delete controls: with these newer Bots you manage routines through chat. Tell the Bot “pause the Weather webhook test routine” or “delete the Weather webhook test routine” and it will do it for you.\u003c/p\u003e","post_number":5,"topic_id":171606,"url":"/t/grok-bot-cannot-use-routines-on-pro-cursor-plan/171606/5","accepter_name":"","accepter_username":"Alex0"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":87436,"username":"Colin","name":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","post_count":1,"primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_color":"","flair_bg_color":"","flair_group_id":42,"admin":true,"moderator":true,"trust_level":3},{"id":123887,"username":"Alex0","name":"","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/9de0a6/{size}.png","post_count":1,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":1}],"created_by":{"id":123887,"username":"Alex0","name":"","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/9de0a6/{size}.png"},"last_poster":{"id":87436,"username":"Colin","name":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png"}},"bookmarks":[]}