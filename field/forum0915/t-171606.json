on\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://us1.discourse-cdn.com/cursor1/original/3X/d/f/df7ef21e1e97bc9c5523f0152074065b66b44683.png\" data-download-href=\"/uploads/short-url/vT8sgL0wzIALeG1d4DbTxdzuP5x.png?dl=1\" title=\"image\" rel=\"noopener nofollow ugc\"\u003e\u003cimg src=\"https://us1.discourse-cdn.com/cursor1/optimized/3X/d/f/df7ef21e1e97bc9c5523f0152074065b66b44683_2_690x344.png\" alt=\"image\" data-base62-sha1=\"vT8sgL0wzIALeG1d4DbTxdzuP5x\" width=\"690\" height=\"344\" srcset=\"https://us1.discourse-cdn.com/cursor1/optimized/3X/d/f/df7ef21e1e97bc9c5523f0152074065b66b44683_2_690x344.png, https://us1.discourse-cdn.com/cursor1/optimized/3X/d/f/df7ef21e1e97bc9c5523f0152074065b66b44683_2_1035x516.png 1.5x, https://us1.discourse-cdn.com/cursor1/optimized/3X/d/f/df7ef21e1e97bc9c5523f0152074065b66b44683_2_1380x688.png 2x\" data-dominant-color=\"171718\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003eimage\u003c/span\u003e\u003cspan class=\"informations\"\u003e1541×769 45 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-14T15:25:55.066Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":5,"reads":8,"readers_count":7,"score":26.6,"yours":false,"topic_id":171606,"topic_slug":"grok-bot-cannot-use-routines-on-pro-cursor-plan","display_username":"","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":3,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":123887,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-cannot-use-routines-on-pro-cursor-plan/171606/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true,"can_vote":false},{"id":490875,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-14T13:40:56.802Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/alex0\"\u003e@Alex0\u003c/a\u003e, thanks for the report, and welcome to Grok Bot!\u003c/p\u003e\n\u003cp\u003eThis is not related to your plan. Pro and Pro+ both include routines, so the downgrade is not what you are hitting.\u003c/p\u003e\n\u003cp\u003eWhat you are seeing is a known issue on our side: newer Bots keep their routines on the server, and for those Bots the desktop app currently shows the routine panel in read-only mode and does not display the Webhook URL, key, or Authorization header for a webhook routine. The links the Bot gives you open that same panel, which is why there is nothing to copy. Recreating the routine or creating another Bot will not change this. We are tracking it and I have added your report.\u003c/p\u003e\n\u003cp\u003eUnfortunately, there is no way to get the webhook URL for these Bots yet. In the meantime, two triggers do work normally: ask the Bot to run the routine on a schedule (for example “run this every morning at 9”), or connect Slack and have it trigger when you send a message in a channel.\u003c/p\u003e\n\u003cp\u003eFor the on/off and delete controls: with these newer Bots you manage routines through chat. Tell the Bot “pause the Weather webhook test routine” or “delete the Weather webhook test routine” and it will do it for you.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":2,"updated_at":"2026-09-14T13:40:56.802Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":7,"readers_count":6,"score":41.4,"yours":false,"topic_id":171606,"topic_slug":"grok-bot-cannot-use-routines-on-pro-cursor-plan","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-cannot-use-routines-on-pro-cursor-plan/171606/5","reactions":[{"id":"+1","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":true,"topic_accepted_answer":true}],"stream":[490795,490875]},"timeline_lookup":[[1,1],[2,0]],"suggested_topics":[],"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"}],"tags_descriptions":{},"fancy_title":"Grok Bot cannot use routines on Pro+ Cursor plan","id":171606,"title":"Grok Bot cannot use routines on Pro+ Cursor plan","posts_count":2,"created_at":"2026-