e":"tws-nab","name":"TWS Nab","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/t/53a042/{size}.png","trust_level":1}},{"extras":null,"description":"Recent Poster","user":{"id":-1,"username":"system","name":"system","avatar_template":"/user_avatar/forum.cursor.com/system/{size}/99069_2.png","admin":true,"moderator":true,"trust_level":4}},{"extras":null,"description":"Recent Poster","user":{"id":103596,"username":"mohitjain","name":"Mohit","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":490936,"name":"Jean Pierre Soto Chirinos","username":"Jean_Pierre_Soto_Ch1","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/a3d4f5/{size}.png","created_at":"2026-09-14T14:52:53.038Z","cooked":"\u003cp\u003e\u003cstrong\u003eUpdate / resolved\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThe issue was caused by \u003cstrong\u003eKaspersky HTTPS scanning\u003c/strong\u003e (SSL/TLS inspection), not by Grok Bot or my Cursor account.\u003c/p\u003e\n\u003cp\u003eKaspersky intercepts HTTPS traffic and injects its own certificate into the chain. Network Debugger then reports:\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003eAPI TLS: TLS certificate untrusted: SELF_SIGNED_CERT_IN_CHAIN\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003eAfter that, Auth, Updates, Feature flags, Origin API, Telemetry, Voice realtime, and \u003ccode\u003e*.cursorvm.com\u003c/code\u003e all failed. DNS still worked because it isn’t HTTPS.\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eFix:\u003c/strong\u003e disable Kaspersky HTTPS/SSL scanning (or exclude Cursor / Grok Bot), or briefly use another network without that interception. After that, Grok Bot reconnects normally.\u003c/p\u003e\n\u003cp\u003eHope this helps anyone hitting the same \u003ccode\u003eSELF_SIGNED_CERT_IN_CHAIN\u003c/code\u003e error.\u003c/p\u003e","post_number":5,"topic_id":171609,"url":"/t/unable-to-reconnect-grok-bot-self-signed-cert-in-chain-and-multiple-connection-failures/171609/5","accepter_name":"Jean Pierre Soto Chirinos","accepter_username":"Jean_Pierre_Soto_Ch1"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":133734,"username":"Jean_Pierre_Soto_Ch1","name":"Jean Pierre Soto Chirinos","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/a3d4f5/{size}.png","post_count":2,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":1}],"created_by":{"id":133734,"username":"Jean_Pierre_Soto_Ch1","name":"Jean Pierre Soto Chirinos","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/a3d4f5/{size}.png"},"last_poster":{"id":133734,"username":"Jean_Pierre_Soto_Ch1","name":"Jean Pierre Soto Chirinos","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/a3d4f5/{size}.png"}},"bookmarks":[]}