ar (feature/product)?\nGrok Bot \nDescribe the Bug\nGrok Bot 0.39.0 on Apple-silicon macOS reports “local machine isn’t connected.” \nPrivacy Mode is explicitly enabled, and I have already restarted, u\u0026hellip;","visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"thumbnails":null,"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"},{"id":408,"name":"networking","slug":"networking"}],"tags_descriptions":{},"like_count":1,"views":51,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":"latest","description":"Original Poster, Most Recent Poster","user":{"id":136193,"username":"AaronW","name":"Aaron","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/b3f665/{size}.png","trust_level":0}},{"extras":null,"description":"Recent Poster","user":{"id":105146,"username":"kevinn","name":"Kevin Neilson","avatar_template":"/user_avatar/forum.cursor.com/kevinn/{size}/101206_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":3}}]},{"fancy_title":"I can\u0026rsquo;t not access my local computer file with grok bot","id":170608,"title":"I can't not access my local computer file with grok bot","slug":"i-cant-not-access-my-local-computer-file-with-grok-bot","posts_count":2,"reply_count":0,"highest_post_number":2,"image_url":null,"created_at":"2026-09-04T15:22:56.477Z","last_posted_at":"2026-09-04T15:23:08.025Z","bumped":true,"bumped_at":"2026-09-04T15:23:08.025Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"offline on 0.39.0 — daemon restart loop + http_502) \nGrok Bot 0.39.0 stable, darwin, Europe/London. Chat works. Local machine always “not connected”. Reboot + full quit/relaunch already tried. Logs show sand-local-exec-d\u0026hellip;","visible":true,"closed":false