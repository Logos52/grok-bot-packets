{"post_stream":{"posts":[{"id":496685,"name":"Jared Ingold","username":"jaredingold","avatar_template":"/user_avatar/forum.cursor.com/jaredingold/{size}/14896_2.png","created_at":"2026-09-21T08:00:48.552Z","cooked":"\u003cp\u003eI’m a long time cursor user and I blew through my tokens after using grok bot… i think I just figured out why… the shared plugins and mcp servers are getting loaded on every coding session.  We need a way to split them… also we need the clients to dynamically load tools, like chatGPT does instead of eagerly loading all of them.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-21T18:11:24.957Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":9,"reads":2,"readers_count":1,"score":45.4,"yours":false,"topic_id":172478,"topic_slug":"grok-bot-shared-plugins-and-mcp-servers-are-wasting-tokens-in-cursor-code","display_username":"Jared Ingold","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":3,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":15770,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-shared-plugins-and-mcp-servers-are-wasting-tokens-in-cursor-code/172478/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":496713,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-21T08:36:45.109Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/jaredingold\"\u003e@jaredingold\u003c/a\u003e, thanks for the report!\u003c/p\u003e\n\u003cp\u003eTwo things are going on here, so let me separate them.\u003c/p\u003e\n\u003cp\u003eConnectors and plugins are account-level, so anything you connect in Grok Bot also appears in Cursor (and in Cloud Agents), and the other way round. That part is intentional today.\u003c/p\u003e\n\u003cp\u003eThe good news is that \u003cstrong\u003eCursor does not load every connector’s full tool definitions into each request.\u003c/strong\u003e The agent only sees a short list of connector names and tool names, and fetches a tool’s full definition when it decides to use it. You can check this yourself: open a chat, click the context meter at the bottom of the input, and look at the “MCP \u0026amp; dynamic tools” slice. With 19 connectors it should be a small, fixed slice, not what is eating your allowance.\u003c/p\u003e\n\u003cp\u003eWhat did use it up: your included allowance for individually selected models in the current cycle (which ends Sep 23) is fully used, so since around Sep 18 your Cursor requests have been billed as on-demand usage, and this morning you hit the on-demand limit you had set.\u003c/p\u003e\n\u003cp\u003eGrok Bot conversations themselves draw from the separate weekly Grok Bot allowance, but Cloud Agents that Grok Bot launches for coding work count against your Cursor plan, and \u003cstrong\u003ethose have been running daily since Sep 15\u003c/strong\u003e.\u003c/p\u003e\n\u003cp\u003eIf you want fewer connectors visible in Cursor right now, you can disable individual ones under Cursor Settings \u0026gt; MCP (and plugins under Plugins). Just be aware that this is account-wide, so they turn off in Grok Bot as well. A per-app split (Grok Bot only vs Cursor only) is a request the team already has!\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":2,"updated_at":"2026-09-21T08:37:28.799Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":172478,"topic_slug":"grok-bot-shared-plugins-and-mcp-servers-are-wasting-tokens-in-cursor-code","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-shared-plugins-and-mcp-servers-are-wasting-tokens-in-cursor-code/172478/5","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[496685,496713]},"timeline_lookup":[[1,1]],"suggested_topics":[],"tags":[{"id":47,"name":"mcp","slug":"mcp"},{"id":416,"name":"grok-bot","slug":"grok-bot"},{"id":372,"name":"plugins","slug":"plugins"}],"tags_descriptions":{},"fancy_title":"Grok Bot shared Plugins and MCP Servers are wasting tokens in Cursor Code","id":172478,"title":"Grok Bot shared Plugins and MCP Servers are wasting tokens in Cursor Code","posts_count":2,"created_at":"2026-09-21T08:00:48.524Z","views":25,"reply_count":0,"like_count":0,"last_posted_at":"2026-09-21T08:36:45.109Z","visible":true,"closed":false,"archived":false,"has_summary":false,"archetype":"regular","slug":"grok-bot-shared-plugins-and-mcp-servers-are-wasting-tokens-in-cursor-code","category_id":8,"word_count":340,"deleted_at":null,"user_