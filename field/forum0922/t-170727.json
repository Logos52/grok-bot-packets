":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://forum.cursor.com/t/grok-bot-0-44-0-on-macos-shell-executable-binding-rejection-persists-approval-card-never-appears/170819/13","internal":true,"reflection":false,"title":"Grok Bot 0.44.0 on macOS: Shell executable-binding rejection persists; approval card never appears","clicks":0}],"read":true,"user_title":null,"reply_to_user":{"id":136491,"username":"Effective_Autism","name":"Effective Autism 🚂📈","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/e/a8b319/{size}.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":136491,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-shell-auto-review-executable-content-could-not-be-bound-never-shows-approval-card/170727/19","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":496302,"name":"John Solly","username":"jsolly","avatar_template":"/user_avatar/forum.cursor.com/jsolly/{size}/33752_2.png","created_at":"2026-09-20T11:23:34.692Z","cooked":"\u003cp\u003e\u003ca class=\"mention\" href=\"/u/colin\"\u003e@Colin\u003c/a\u003e — checking in on status.\u003c/p\u003e\n\u003cp\u003eOn 2026-09-07 I posted a separate repro (\u003ccode\u003enode --experimental-strip-types\u003c/code\u003e on a \u003ccode\u003e.mts\u003c/code\u003e skill helper with an explicit working_directory) that still hit the same bind error with no approval card — different shape than the npm-in-path case.\u003c/p\u003e\n\u003cp\u003eSeparately, \u003ca class=\"mention\" href=\"/u/effective_autism\"\u003e@Effective_Autism\u003c/a\u003e reported (2026-09-14) their Python e