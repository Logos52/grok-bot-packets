3e@jsolly\u003c/a\u003e, thanks for checking in, and sorry for the wait.\u003c/p\u003e\n\u003cp\u003eYes, the fix has shipped. If you can retest both the npm command and the \u003ccode\u003e.mts\u003c/code\u003e one and report back, that would be great!\u003c/p\u003e","post_number":24,"post_type":1,"posts_count":9,"updated_at":"2026-09-21T17:13:18.732Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":3,"readers_count":2,"score":0.6,"yours":false,"topic_id":170727,"topic_slug":"grok-bot-shell-auto-review-executable-content-could-not-be-bound-never-shows-approval-card","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-shell-auto-review-executable-content-could-not-be-bound-never-shows-approval-card/170727/24","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":497422,"name":"John Solly","username":"jsolly","avatar_template":"/user_avatar/forum.cursor.com/jsolly/{size}/33752_2.png","created_at":"2026-09-21T19:45:13.918Z","cooked":"\u003cp\u003eThanks — retested on the shared Grok Bot computer after Computer Update.\u003c/p\u003e\n\u003cp\u003eVerified:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ccode\u003e/usr/bin/python3 -c \"print('exec-ok')\"\u003c/code\u003e → exit 0\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e/usr/bin/python3 -I -B /absolute/path/to/script.py\u003c/code\u003e → exit 0\u003c/li\u003e\n\u003cli\u003eAbsolute path containing \u003ccode\u003enpm\u003c/code\u003e got past Auto-review (no “executable content could not be bound” reject / no missing approval card)\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eFrom our side this can close. Happy to reopen if it regresses.\u003c/p\u003e\n\u003cp\u003e(The separate \u003ccode\u003e.mts\u003c/code\u003e / \u003ccode\u003e--experimental-strip-types\u003c/code\u003e shape from earlier is still TBD if anyone still needs it — not required for the original npm/python binders.)\u003c/p\u003e","post_number":26,"post_type":1,"posts_count":9,"updated_at":"2026-09-21T19:45:13.918Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":3,"readers_count":2,"score":0.6,"yours":false,"topic_id":170727,"topic_slug":"grok-bot-shell-auto-review-executable-content-could-not-be-bound-never-shows-approval-card","display_username":"John Solly","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":30025,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-shell-auto-review-executable-content-could-not-be-bound-never-shows-approval-card/170727/26","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answ