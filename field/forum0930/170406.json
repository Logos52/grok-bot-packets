{"post_stream":{"posts":[{"id":481712,"name":"AOConsulting","username":"ao212","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/a/258eb7/{size}.png","created_at":"2026-09-03T02:00:12.768Z","cooked":"\u003ch3\u003e\u003ca name=\"p-481712-feature-request-for-productservice-1\" class=\"anchor\" href=\"#p-481712-feature-request-for-productservice-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003eFeature request for product/service\u003c/h3\u003e\n\u003cp\u003eChat\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-481712-describe-the-request-2\" class=\"anchor\" href=\"#p-481712-describe-the-request-2\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDescribe the request\u003c/h3\u003e\n\u003cp\u003eIn my business (we provide help desk services to companies) we humans are constantly chatting in Microsoft Teams to resolve problems. Recently, I’ve created a separate virtual help desk team that only I have access to. Sometimes the (Grokbot) agent has questions that I can’t answer and i’d like for them to message my human tech team but I do not want them to message my human staff as me. What other ways can I get the (Grokbot) agent to talk to my human team so the agent has a 1:1 convo with human without my intervention?\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-03T02:00:20.836Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":22,"reads":6,"readers_count":5,"score":111.2,"yours":false,"topic_id":170406,"topic_slug":"ideas-for-grokbot-to-message-human-team-members","display_username":"AOConsulting","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":135835,"hidden":fal