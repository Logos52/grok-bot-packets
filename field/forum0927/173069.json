eply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":8,"readers_count":7,"score":6.6,"yours":false,"topic_id":173069,"topic_slug":"grok-bot-agent-computer-reset-stuck","display_username":"uai bot","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":139903,"hidden":true,"hidden_reason_id":1,"trust_level":1,"deleted_at":null,"user_deleted":true,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-agent-computer-reset-stuck/173069/3","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":501731,"name":"uai bot","username":"uparrowinc","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/u/848f3c/{size}.png","created_at":"2026-09-26T15:44:48.249Z","cooked":"\u003cp\u003edo you need the cursor email to my account\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":8,"updated_at":"2026-09-26T15:44:48.249Z","reply_count":0,"reply_to_post_number":3,"quote_count":0,"incoming_link_count":0,"reads":6,"readers_count":5,"score":1.2,"yours":false,"topic_id":173069,"topic_slug":"grok-bot-agent-computer-reset-stuck","display_username":"uai bot","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":139903,"username":"uparrowinc","name":"uai bot","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/u/848f3c/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":139903,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-agent-computer-reset-stuck/173069/5","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":501741,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-26T16:16:53.857Z","cooked":"\u003cp\u003eHey, thanks for the report. I’m happy to help, but there’s one catch: on the account you’re using on the forum, I don’t see a single Grok Bot Computer. Most likely you’re signing into Grok Bot with a different login.\u003c/p\u003e\n\u003cp\u003eTo find your computer, please send:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eThe email you use to sign into Grok Bot (and the sign-in method: Sign in with Apple, Google, X, or email)\u003c/li\u003e\n\u003cli\u003eWhat the screen shows right now (for example a percent, or a step name like “Transferring your data”), or a screenshot\u003c/li\u003e\n\u003cli\u003eWhether the Mac app shows the same thing\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eWhile we’re waiting, try this on iPhone:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eSwipe up and fully close the Grok Bot app.\u003c/li\u003e\n\u003cli\u003eOpen it again, go to Settings → Bot Computer.\u003c/li\u003e\n\u003cli\u003eIf you can tap “Reset Computer”, tap it once, confirm, then wait about 5 minutes without tapping anything else.\u003c/li\u003e\n\u003cli\u003eIf it says “Available when the update finishes”, don’t tap again, just send the details above.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eImportant: your bots, files, and logins will stay safe while we look into this. Let me know how it goes.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":8,"updated_at":"2026-09-26T16:16:53.857Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":7,"readers_count":6,"score":1.4,"yours":false,"topic_id":173069,"topic_slug":"grok-bot-agent-computer-reset-stuck","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-agent-computer-reset-stuck/173069/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":501743,"name":"uai bot","username":"uparrowinc","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/u/848f3c/{size}.png","created_at":"2026-09-26T16:20:39.849Z","cooked":"\u003cp\u003eYes, thank you very much for responding so fast.\u003c/p\u003e\n\u003cp\u003eApparently, it was me trying to use this on a Macintosh Silicon chip. It was an M3 version MacBook, and there was a hang there. I was trying to reset things, but it never finished.\u003c/p\u003e\n\u003cp\u003eToday, after all the trying through the phone, nobody could get to the computer. I did it again: I updated to the new version of the Mac version. I was able to do that finally, and then I was able to just kill the Mac app. I just overwrote it and reset it, even though it said our bots were doing work. None of them got to the agent or the shared computer, I guess that is what you call it.\u003c/p\u003e\n\u003cp\u003eI was able to finally reset it, and even though it looked like it was hung again, it finally did it, and it was really nice. I didn’t lose any data, thank goodness. I’ll do the backups now.\u003c/p\u003e\n\u003cp\u003eThis is a great tool, and I want to thank you all very much for this tool. It has solved a lot of problems in my professional and personal life. It’s been a great, great system. It’s working great now. Again, thank you for this wonderful system and for being quick to respond today.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":8,"updated_at":"2026-09-26T16:20:39.849Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":7,"readers_count":6,"score":56.4,"yours":false,"topic_id":173069,"topic_slug":"grok-bot-agent-computer-reset-stuck","display_username":"uai bot","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":139903,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-agent-computer-reset-stuck/173069/8","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":true,"topic_accepted_answer":true},{"id":501755,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-26T16:34:09.455Z","cooked":"\u003cp\u003eGlad everything’s working again and the data is still there. Looks like updating the Mac app plus a full restart fixed the freeze. Sometimes the screen can look stuck even though the reset is already running in the background, so your approach was the right one.\u003c/p\u003e\n\u003cp\u003eAnd thanks for the kind words, it’s nice to hear Grok Bot was so helpful. On backups, making them a habit is a great idea and it’s the best safety net for the future.\u003c/p\u003e\n\u003cp\u003eIf you run into something like this again, just message me and we’ll sort it out.\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":8,"updated_at":"2026-09-26T16:34:09.455Z","reply_count":0,"reply_to_post_number":8,"quote_count":0,"incoming_link_count":0,"reads":5,"readers_count":4,"score":1.0,"yours":false,"topic_id":173069,"topic_slug":"grok-bot-agent-computer-reset-stuck","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","reply_to_user":{"id":139903,"username":"uparrowinc","name":"uai bot","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/u/848f3c/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-agent-computer-reset-stuck/173069/10","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":501792,"name":"Mauricio A. Perez J.","username":"Mauricio_A_Perez_J","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/m/cc9497/{size}.png","created_at":"2026-09-26T19:15:56.568Z","cooked":"\u003cp\u003eMi computadora de Grok Bot está atascada en ‘transfiriendo tus datos’ desde esta mañana. Ya intenté cerrar la app por completo, reabrirla, y cambiar el DNS a 1.1.1.1 y 8.8.8.8, sin éxito. Por favor, hagan una recuperación manual del lado del servidor. Mis bots, chats y archivos están a salvo y no he vuelto a tocar Reset ni Update.\u003c/p\u003e","post_number":11,"post_type":1,"posts_count":8,"updated_at":"2026-09-26T19:57:19.349Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":3,"readers_count":2,"score":5.6,"yours":false,"topic_id":173069,"topic_slug":"grok-bot-agent-computer-reset-stuck","display_username":"Mauricio A. Perez J.","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":139934,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-agent-computer-reset-stuck/173069/11","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":501801,"name":"Mauricio A. Perez J.","username":"Mauricio_A_Perez_J","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/m/cc9497/{size}.png","created_at":"2026-09-26T20:16:22.240Z","cooked":"\u003cp\u003eHi Dean,\u003c/p\u003e\n\u003cp\u003eI have already tried the recommended troubleshooting steps, but Grok Bot is still unable to respond.\u003c/p\u003e\n\u003cp\u003eCurrent situation:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eGrok Bot Weekly Usage: 100%\u003c/li\u003e\n\u003cli\u003eOn-Demand Usage: enabled\u003c/li\u003e\n\u003cli\u003eMonthly On-Demand Limit: USD 500\u003c/li\u003e\n\u003cli\u003eCurrent On-Demand usage: USD 406.11 / USD 500\u003c/li\u003e\n\u003cli\u003eAll bots show: “The Bot couldn’t respond / Something went wrong generating the response”\u003c/li\u003e\n\u003cli\u003eThe problem also happens on my Mac\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eI have already restarted the app, signed out and back in, and tried the normal recovery steps.\u003c/p\u003e\n\u003cp\u003eSince On-Demand is enabled and I still have remaining capacity, could you please check whether my Grok Bot session, backend or Agent Computer is stuck?\u003c/p\u003e\n\u003cp\u003eIMPORTANT:\u003cbr\u003e\nPlease do not reset or wipe my bots, files, routines, logins or Agent Computer data unless absolutely necessary.\u003c/p\u003e\n\u003cp\u003eLogin email: [partial email, for example: \u003ca href=\"mailto:mau***@domain.com\"\u003emau***@domain.com\u003c/a\u003e]\u003c/p\u003e\n\u003cp\u003eI prefer not to post my full email publicly. Please let me know how I can provide the complete email privately to Cursor Support.\u003c/p\u003e\n\u003cp\u003eThank you.\u003c/p\u003e","post_number":12,"post_type":1,"posts_count":8,"updated_at":"2026-09-26T20:16:22.240Z","reply_count":0,"reply_to_post_number":11,"quote_count":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":0.8,"yours":false,"topic_id":173069,"topic_slug":"grok-bot-agent-computer-reset-stuck","display_username":"Mauricio A. Perez J.","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_d