ver button has appeared.\u003c/p\u003e\n\u003cp\u003eiOS only on this account — Grok Bot 1.6.0 (8025). Happy for you to clear those files / finish the load from your side.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":4,"updated_at":"2026-09-08T19:03:11.854Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":5,"readers_count":4,"score":1.0,"yours":false,"topic_id":171078,"topic_slug":"can-t-use-grok-bot-ios-app","display_username":"Charles Roe","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":136852,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/can-t-use-grok-bot-ios-app/171078/9","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[486723,486766,486772,486776]},"timeline_lookup":[[1,0]],"suggested_topics":[],"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"},{"id":408,"name":"networking","slug":"networking"}],"tags_descriptions":{},"fancy_title":"Can’t use Grok Bot iOS App","id":171078,"title":"Can’t use Grok Bot iOS App","posts_count":4,"created_at":"2026-09-08T17:57:46.349Z","views":27,"reply_count":1,"like_count":0,"last_posted_at":"2026-09-08T18:45:13.775Z","visible":true,"closed":false,"archived":false,"has_summary":false,"archetype":"regular","slug":"can-t-use-grok-bot-ios-app","category_id":6,"word_count":308,"deleted_at":null,"user_id":136852,"featured_link":null,"pinned_globally":false,"pinned_at":nu