ing_link_count":0,"reads":3,"readers_count":2,"score":0.6,"yours":false,"topic_id":170926,"topic_slug":"grok-bot-public-template-publish-fails-with-a-team-must-be-selected-to-share-a-team-template-on-personal-ultra","display_username":"system","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":-1,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"action_code":"visible.enabled","post_url":"/t/grok-bot-public-template-publish-fails-with-a-team-must-be-selected-to-share-a-team-template-on-personal-ultra/170926/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":486070,"name":"Mohit","username":"mohitjain","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png","created_at":"2026-09-08T08:21:35.179Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/idan_lin\"\u003e@idan_lin\u003c/a\u003e thanks for the detailed report. This isn’t something you misconfigured, and it isn’t intended behavior. A Public template export shouldn’t need a team at all, but right now the export flow trips up when your account is still attached to more than one team workspace, even on a personal Ultra plan (an account can stay attached to leftover workspaces from old invite links, trials, or canceled self-serve teams that have no seats or subscription).\u003c/p\u003e\n\u003cp\u003eWorkaround: open \u003ca href=\"http://cursor.com/dashboard\"\u003ecursor.com/dashboard\u003c/a\u003e and leave any team workspaces your account is still part of. Once it isn’t attached to more than one, ask the Bot to share itself as a Public template again and the review card + x.ai/bot link should appear.\u003c/p\u003e\n\u003cp\u003eIf you’d rather stay in those workspaces, there’s no in-app way around it today, so I’d sit tight. We’ve let the team know and this is an issue we’re tracking, and I’ll follow up here once it’s sorted.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":4,"updated_at":"2026-09-08T08:21:35.179Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":3,"readers_count":2,"score":5.6,"yours":false,"topic_id":170926,"topic_slug":"grok-bot-public-template-publish-fails-with-a-team-must-be-selected-to-share-a-team-template-on-personal-ultra","display_username":"Mohit","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"http://cursor.com/dashboard","internal":false,"reflection":false,"clicks":1}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":103596,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-public-template-publish-fails-with-a-team-must-be-selected-to-share-a-team-template-on-personal-ultra/170926/9","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":486185,"name":"idan lin","username":"idan_lin","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/i/ec9cab/{size}.png","created_at":"2026-09-08T09:41:16.024Z","cooked":"\u003cp\u003eThanks Mohit — that matches what I saw.\u003c/p\u003e\n\u003cp\u003eI checked \u003ca href=\"https://cursor.com/dashboard\" rel=\"noopener nofollow ugc\"\u003ehttps://cursor.com/dashboard\u003c/a\u003e on personal Ultra (idan lin). There’s no leftover Cursor team/workspace to leave: no team switcher, and Members shows “Upgrade to Teams” / “Create team” only. GitHub orgs (AIsa-team / eddiearc) show up under integrations, but those aren’t Cursor teams.\u003c/p\u003e\n\u003cp\u003eI retried Public template share after that and still get:\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003e[failed_precondition] A team must be selected to share a team template.\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003eHappy to retest again if there’s another place leftover teams hide, or if you want screenshots of the dashboard / the exact share error.\u003c/p\u003e\n\u003cp\u003e\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://us1.discourse-cdn.com/cursor1/original/3X/e/1/e1854098b406fef4daedbc8cca1caf32b601b7fb.png\" data-download-href=\"/uploads/short-url/wb2VcFH1e1h41jhZupZqLxgg1Zh.png?dl=1\" title=\"shot-call_yzwQuAirdtrnzjPvc49ePrBDfc_093479e89d0db40d\" rel=\"noopener nofollow ugc\"\u003e\u003cimg src=\"https://us1.discourse-cdn.com/cursor1/optimized/3X/e/1/e1854098b406fef4daedbc8cca1caf32b601b7fb_2_690x323.png\" alt=\"shot-call_yzwQuAirdtrnzjPvc49ePrBDfc_093479e89d0db40d\" data-base62-sha1=\"wb2VcFH1e1h41jhZupZqLxgg1Zh\" width=\"690\" height=\"323\" srcset=\"https://us1.discourse-cdn.com/cursor1/optimized/3X/e/1/e1854098b406fef4daedbc8cca1caf32b601b7fb_2_690x323.png, https://us1.discourse-cdn.com/cursor1/optimized/3X/e/1/e1854098b406fef4daedbc8cca1caf32b601b7fb_2_1035x484.png 1.5x, https://us1.discourse-cdn.com/cursor1/original/3X/e/1/e1854098b406fef4daedbc8cca1caf32b601b7fb.png 2x\" data-dominant-color=\"EEF2F1\"\u003e\u003cdiv