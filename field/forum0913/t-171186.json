rs_count":5,"score":21.2,"yours":false,"topic_id":171186,"topic_slug":"cant-reach-computer-grok-bot","display_username":"","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","reply_to_user":{"id":137241,"username":"glittle","name":"Glen Little","avatar_template":"/user_avatar/forum.cursor.com/glittle/{size}/120521_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":137238,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/cant-reach-computer-grok-bot/171186/13","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":488917,"name":"Mohit","username":"mohitjain","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png","created_at":"2026-09-11T11:55:19.486Z","cooked":"\u003cp\u003e\u003ca class=\"mention\" href=\"/u/robobobo\"\u003e@robobobo\u003c/a\u003e your computer has been reconnected on our side and it’s back. Fully close the app and reopen it, and your bots should load normally. Your bots and files are intact.\u003c/p\u003e\n\u003cp\u003e\u003ca class=\"mention\" href=\"/u/glittle\"\u003e@glittle\u003c/a\u003e \u003ca class=\"mention\" href=\"/u/roampt\"\u003e@RoamPT\u003c/a\u003e your case looks different from the original one here. On Windows a local antivirus (Kaspersky) is blocking Grok Bot’s connection, which is why the Android app works fine on the same account. Rather than turning protection off, add Grok Bot and Cursor to Kaspersky’s allowed or trusted apps so it stops blocking the connection, then relaunch.\u003c/p\u003e\n\u003cp\u003eIf it still fails after allowlisting, please open a new thread with your Network Debugger results so we can track the antivirus side separately from the computer issue above.\u003c/p\u003e","post_number":15,"post_type":1,"posts_count":10,"updated_at":"2026-09-11T11:55:19.486Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":7,"readers_count":6,"score":11.4,"yours":false,"topic_id":171186,"topic_slug":"cant-reach-computer-grok-bot","display_username":"Mohit","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":103596,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/cant-reach-computer-grok-bot/171186/15","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":489358,"name":"Bradandhaze","username":"bradandhaze","avatar_template":"/user_avatar/forum.cursor.com/bradandhaze/{size}/120645_2.png","created_at":"2026-09-12T07:29:17.468Z","cooked":"\u003cp\u003eI have the same issue on my mac and have been emailing for 4 days and no further forward. Can this please be looked at for me - on ultra plan and unable to work\u003c/p\u003e","post_number":17,"post_type":1,"posts_count":10,"updated_at":"2026-09-12T07:29:17.468Z","reply_count":0,"reply_to_post_number":15,"quote_count":0,"incoming_link_count":0,"