10T17:24:22.735Z","reply_count":0,"reply_to_post_number":29,"quote_count":0,"incoming_link_count":2,"reads":11,"readers_count":10,"score":12.2,"yours":false,"topic_id":171115,"topic_slug":"grok-bot-windows-0-44-0-authentication-error-persists-after-update-logout-login-and-cache-clear","display_username":"Paul Anderson","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":134135,"username":"Josh2","name":"Josh","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/j/4491bb/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":137204,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-windows-0-44-0-authentication-error-persists-after-update-logout-login-and-cache-clear/171115/35","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":488983,"name":"Никита Чиркин","username":"Nikita_Chirkin","avatar_template":"/user_avatar/forum.cursor.com/nikita_chirkin/{size}/120543_2.png","created_at":"2026-09-11T13:05:50.069Z","cooked":"\u003cp\u003eHi \u003ca class=\"mention\" href=\"/u/kevinn\"\u003e@kevinn\u003c/a\u003e \u003ca class=\"mention\" href=\"/u/deanrie\"\u003e@deanrie\u003c/a\u003e , sorry for pinging again, but I’m kind of stuck here and not sure what else I can try.\u003c/p\u003e\n\u003cp\u003eGrok Bot has been completely unusable for me for about a week now.\u003c/p\u003e\n\u003cp\u003eI’m on \u003cstrong\u003e0.47.0 / Windows 11 Home 25H2\u003c/strong\u003e. The browser login itself seems to work, it redirects me back to the app, but Grok Bot still stays on the sign-in screen and then shows:\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003e“Cursor sign-in was not completed. Please try again.”\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eI’ve already reinstalled the app, cleared AppData, cleared all browser cookies, tried incognito/private login, restarted Windows, and repeated the login flow multiple times. Nothing has changed.\u003c/p\u003e\n\u003cp\u003eThe tricky part is that I also can’t use \u003cstrong\u003eSettings / Reset / Recover\u003c/strong\u003e, because I never get past the initial login screen.\u003c/p\u003e\n\u003cp\u003eAt this point I’m out of things I can try locally. Could someone please take a look at my account on the backend and check whether the Grok Bot auth/session/machine state is stuck?\u003c/p\u003e\n\u003cp\u003eI’m happy to send my Cursor account email privately if that helps.\u003c/p\u003e\n\u003cp\u003eI’ve also emailed support more than once, but haven’t received a reply yet, so I’d really appreciate if someone from the Grok Bot team could take a look.\u003c/p\u003e","post_number":36,"post_type":1,"posts_count":27,"updated_at":"2026-09-11T13:05:50.069Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":3,"reads":4,"readers_count":3,"score":20.8,"yours":false,"topic_id":171115,"topic_slug":"grok-bot-windows-0-44-0-authentication-error-persists-after-update-logout-login-and-cache-clear","display_username":"Никита Чиркин","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":137107,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-windows-0-44-0-authentication-error-persists-after-update-logout-login-and-cache-clear/171115/36","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":true},{"id":489015,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-11T13:56:36.237Z","cooked":"\u003cp\u003e\u003ca class=\"mention\" href=\"/u/nikita_chirkin\"\u003e@Nikita_Chirkin\u003c/a\u003e, your case is different from the main issue in this thread, so the fixes shared here won’t work for you.\u003c/p\u003e\n\u003cp\u003eFor most users in this thread, the app stays logged in and only message sending fails. What helps them is Settings \u0026gt; Updates \u0026gt; Update Grok Bot’s Computer. Your issue is different: the login never finishes at all Cursor sign-in was not completed, and you’re stuck on the sign-in screen, so you can’t even reach Update/Reset/Recover.\u003c/p\u003e\n\u003cp\u003eYou’ve already tried all the local steps reinstall, clearing AppData, cookies, incognito, restart. There’s really nothing else to try on your side, and it’s not caused by your setup. We need to check the auth/session/machine state on the backend.\u003c/p\u003e\n\u003cp\u003ePlease send me the email for your Cursor account. I’ll check the session and the Grok Bot machine state and get back to you with an update. If you happen to have a Request ID from one of the sign-in attempts, please include it too, but it’s optional.\u003c/p\u003e","post_number":37,"post_type":1,"posts_count":27,"updated_at":"2026-09-11T13:56:36.237Z","reply_count":1,"reply_to_post_number":36,"quote_count":0,"incoming_link_count":1,"reads":6,"readers_count":5,"score":11.2,"yours":false,"topic_id":171115,"topic_slug":"grok-bot-windows-0-44-