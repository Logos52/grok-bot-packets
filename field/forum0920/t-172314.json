, thanks for sharing the results. Since switching networks fixed it and Android with the same account didn’t have the issue, that really points to the network side, not Grok Bot. If the flapping comes back on the same connection, you can check whether there’s a VPN, proxy, or corporate filter between you and the service. If needed, start a separate thread with details.\u003c/p\u003e\n\u003cp\u003eIf either of you starts seeing failures again, post here and we’ll take a look.\u003c/p\u003e","post_number":11,"post_type":1,"posts_count":7,"updated_at":"2026-09-19T17:21:36.931Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":172314,"topic_slug":"grok-bot-message-failed-to-send-in-agent-chat","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-message-failed-to-send-in-agent-chat/172314/11","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[495530,495532,495636,495646,495682,495708,495860]},"timeline_lookup":[[1,1],[6,0]],"suggested_topics":[],"tags":[{"id":272,"name":"chat","slug":"chat"},{"id":416,"name":"grok-bot","slug":"grok-bot"}],"tags_descriptions":{},"fancy_title":"Grok Bot: M