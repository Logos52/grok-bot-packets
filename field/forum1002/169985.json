ing-related query, and the forum isn’t the right channel for these. The forum team does not have access to account details or the ability to do things like process refunds or manage subscriptions. As such, we’ve unlisted this thread.\u003c/p\u003e\n\u003cp\u003ePlease email \u003ca href=\"mailto:hi@cursor.com\"\u003ehi@cursor.com\u003c/a\u003e for assistance. Our billing specialists are the experts in this domain and are best equipped to handle your request.\u003c/p\u003e\n\u003cp\u003eIf you’ve already emailed, hang tight. The team will get back to you as soon as they can!\u003c/p\u003e\n\u003cp\u003eAdditionally, it looks like you’re also blocked from completing the login/authentication process, which our support team needs to investigate directly since the forum team doesn’t have access to the authentication systems involved. Please include those details in the same email — what happens when you try to log in, any error messages you see, and the email address you’re using to sign in.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":4,"updated_at":"2026-08-30T14:01:00.438Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":8,"readers_count":7,"score":6.6,"yours":false,"topic_id":169985,"topic_slug":"grokbot-cursor-integration-with-ulta","display_username":"system","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":-1,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grokbot-cursor-integration-with-ulta/169985/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":478302,"name":"Rich Brandwein","username":"Rich_Brandwein","avatar_template":"/user_avatar/forum.cursor.com/rich_brandwein/{size}/117031_2.png","created_at":"2026-08-30T14:01:55.710Z","cooked":"\u003cp\u003ethis is NOT a billing issue.  Grokbot sent me here and it has no idea of how to send feedback to Cursor anymore.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":4,"updated_at":"2026-08-30T14:01:55.710Z","reply_count":0,"reply_to_post_number":4,"quote_count":0,"incoming_link_count":0,"reads":6,"readers_count":5,"score":1.2,"yours":false,"topic_id":169985,"topic_slug":"grokbot-cursor-integration-with-ulta","display_username":"Rich Brandwein","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":-1,"username":"system","name":"system","avatar_template":"/user_avatar/forum.cursor.com/system/{size}/99069_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":132017,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grokbot-cursor-integration-with-ulta/169985/5","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":478606,"name":"Mohit","username":"mohitjain","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png","created_at":"2026-08-31T05:13:44.544Z","cooked":"","post_number":6,"post_type":3,"posts_count":4,"updated_at":"2026-08-31T05:13:44.544Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":5,"readers_count":4,"score":1.0,"yours":false,"topic_id":169985,"topic_slug":"grokbot-cursor-integration-with-ulta","display_username":"Mohit","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":103596,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"action_code":"visible.enabled","post_url":"/t/grokbot-cursor-integration-with-ulta/169985/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":480314,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-01T17:29:21.738Z","cooked":"\u003cp\u003eHey, thanks for the report, and sorry about the routing confusion. Your post was automatically sent to the billing thread at first, but it’s a product report. We’ve moved it to the right category, so the team will see it.\u003c/p\u003e\n\u003cp\u003eHere’s a quick breakdown:\u003c/p\u003e\n\u003cp\u003eGoogle login inside the Grok Bot browser. What you’re seeing is a known limitation, not something in your setup. Login sharing works reliably for sites that keep sessions in cookies. Google and many app-style sites store part of the session elsewhere in the browser like localStorage or IndexedDB. Because of that, signing in inside the agent browser may fail or ask you to sign in again, and the session can drop after the computer is recreated. The team is working on improvements here, but I can’t share a timeline yet.\u003c/p\u003e\n\u003cp\u003eImport cookies from Chrome. You don’t see this option because it’s not broadly available yet. It’s the feature that should let you bring your local Chrome logins into the agent computer, and it’s still in development. I’ll reply here once there’s something you can try.\u003c/p\u003e\n\u003cp\u003eWeekly usage showing no numbers. We’ll need a bit more info to debug this. Please share a screenshot of the dashboard where usage shows without numbers, plus your Cursor and Grok Bot versions from Settings. Then we can check what exactly isn’t showing.\u003c/p\u003e\n\u003cp\u003eRelated thread about logins in the agent browser, if you’re curious: \u003ca href=\"https://forum.cursor.com/t/grok-bot-per-agent-browser-still-requires-separate-sign-in-despite-account-level-login-promise/168212\" class=\"inline-onebox\"\u003eGrok Bot: per-agent browser still requires separate sign-in despite account-level login promise\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eLet me know about the usage issue, and feel free to post again if anything else comes up.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":4,"updated_at":"2026-09-01T17:29:21.738Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":15.8,"yours":false,"topic_id":169985,"topic_slug":"grokbot-cursor-integration-with-ulta","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{