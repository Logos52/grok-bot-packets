{"post_stream":{"posts":[{"id":478298,"name":"Rich Brandwein","username":"Rich_Brandwein","avatar_template":"/user_avatar/forum.cursor.com/rich_brandwein/{size}/117031_2.png","created_at":"2026-08-30T14:00:36.152Z","cooked":"\u003ch3\u003e\u003ca name=\"p-478298-where-does-the-bug-appear-featureproduct-1\" class=\"anchor\" href=\"#p-478298-where-does-the-bug-appear-featureproduct-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003eWhere does the bug appear (feature/product)?\u003c/h3\u003e\n\u003cp\u003eGrok Bot\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-478298-describe-the-bug-2\" class=\"anchor\" href=\"#p-478298-describe-the-bug-2\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDescribe the Bug\u003c/h3\u003e\n\u003cp\u003eGrok Bot has awful integration with Cursor for something Cursor built. I’m very annoyed. Ultra weekly Grok Bot usage lives on the Cursor dashboard, but I can’t get Grok Bot into my Cursor account. Login is Google SSO only (no password), Google on Grok Bot’s computer always fails, and Settings → Computer has no Import cookies from Chrome row (only Current computer and Execution). So usage warnings have no numbers, and I can’t see whether more long-running background agents will blow the week.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":4,"updated_at":"2026-08-31T05:13:39.909Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":18,"reads":6,"readers_count":5,"score":91.2,"yours":false,"topic_id":169985,"topic_slug":"grokbot-cursor-integration-with-ulta","display_username":"Rich Brandwein","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":4,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":132017,"hidden":false,"trust_level