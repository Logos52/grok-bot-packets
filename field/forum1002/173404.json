{"post_stream":{"posts":[{"id":503973,"name":"Sam Smith","username":"Sam_Smith","avatar_template":"/user_avatar/forum.cursor.com/sam_smith/{size}/122447_2.png","created_at":"2026-09-30T13:58:25.086Z","cooked":"\u003cp\u003eIt’s great we have the existing Google Workspace connectors but we desperately need a Google Chat connector.\u003c/p\u003e\n\u003cp\u003eThis would be a massive benefit for our team. Is one coming along and if so - when?\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":6,"updated_at":"2026-09-30T14:00:43.063Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":10,"reads":6,"readers_count":5,"score":66.2,"yours":false,"topic_id":173404,"topic_slug":"feature-request-for-grokbot-google-chat-connector","display_username":"Sam Smith","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":6,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":135942,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/feature-request-for-grokbot-google-chat-connector/173404/1","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":true},{"id":504072,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-30T16:19:29.662Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/sam_smith\"\u003e@Sam_Smith\u003c/a\u003e, thanks for the suggestion!\u003c/p\u003e\n\u003cp\u003eA Google Chat connector for Grok Bot is something the team is looking at, so keep an eye on the Plugins page in upcoming releases.\u003c/p\u003e\n\u003cp\u003eTo make sure we pass along the right thing: do you want your bot to read and send messages in your Google Chat spaces (similar to how the Gmail connector works for email), or do you want to chat with your bot from inside Google Chat instead of the Grok Bot app?\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":6,"updated_at":"2026-09-30T16:19:29.662Z","reply_count":3,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":7,"readers_count":6,"score":51.4,"yours":false,"topic_id":173404,"topic_slug":"feature-request-for-grokbot-google-chat-connector","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/feature-request-for-grokbot-google-chat-connector/173404/4","reactions":[{"id":"heart","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":504189,"name":"Sam Smith","username":"Sam_Smith","avatar_template":"/user_avatar/forum.cursor.com/sam_smith/{size}/122447_2.png","created_at":"2026-09-30T18:26:16.219Z","cooked":"\u003cp\u003eThe second thing. We want to be able to set a team bot live on Google Chat so that people can converse with it and send it work. I am guessing like you do with Slack. If you have an idea of general timeframe that would be most helpful as we could start to build a workaround but we don’t want to sink lots of time into this unless the Google Chat connector is 6 months+ away. Thanks Colin.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":6,"updated_at":"2026-09-30T18:26:16.219Z","reply_count":1,"reply_to_post_number":4,"quote_count":0,"incoming_link_count":0,"reads":7,"readers_count":6,"score":21.4,"yours":false,"topic_id":173404,"topic_slug":"feature-request-for-grokbot-google-chat-connector","display_username":"Sam Smith","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":87436,"username":"Colin","name":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":135942,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/feature-request-for-grokbot-google-chat-connector/173404/6","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":505022,"name":"Cole Younger","username":"Cole_Younger","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/c/4491bb/{size}.png","created_at":"2026-10-01T20:21:25.562Z","cooked":"\u003cp\u003ePersonally being able to act as me in chat is the bigger feature. But being able to message it from chat in the future opens it up for more team collaboration.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":6,"updated_at":"2026-10-01T20:21:25.562Z","reply_count":0,"reply_to_post_number":4,"quote_count":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":15.8,"yours":false,"topic_id":173404,"topic_slug":"feature-request-for-grokbot-google-chat-connector","display_username":"Cole Younger","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":87436,"username":"Colin","name":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":140546,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/feature-request-for-grokbot-google-chat-connector/173404/7","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":505052,"name":"Anthony","username":"gatchan","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/g/b77776/{size}.png","created_at":"2026-10-01T21:08:56.133Z","cooked":"\u003cp\u003eFor our company it’s the first one, that is our bots to read and send messages in our Google Chat spaces (similar to how the Gmail connector works for email). Thank you.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":6,"updated_at":"2026-10-01T21:08:56.133Z","reply_count":0,"reply_to_post_number":4,"quote_co