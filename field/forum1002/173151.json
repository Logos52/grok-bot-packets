 along.\u003c/p\u003e","post_number":8,"post_type":1,"posts_count":5,"updated_at":"2026-09-28T08:26:12.450Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":8,"readers_count":7,"score":6.6,"yours":false,"topic_id":173151,"topic_slug":"plaid-multiple-banks","display_username":"Mohit","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":103596,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/plaid-multiple-banks/173151/8","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":504035,"name":"Chris Nystrom","username":"cnystrom","avatar_template":"/user_avatar/forum.cursor.com/cnystrom/{size}/122454_2.png","created_at":"2026-09-30T15:35:20.733Z","cooked":"\u003caside class=\"quote group-CursorStaff\" data-username=\"mohitjain\" data-display-name=\"Mohit\" data-post=\"8\" data-topic=\"173151\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://sea3.discourse-cdn.com/cursor1/user_avatar/forum.cursor.com/mohitjain/48/100229_2.png\" class=\"avatar\"\u003e Mohit:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eOn the Finance plugin page\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eHow do I get to the “Fina