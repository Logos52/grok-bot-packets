naccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":488555,"name":"Chris Moore","username":"crsmoore","avatar_template":"/user_avatar/forum.cursor.com/crsmoore/{size}/5076_2.png","created_at":"2026-09-11T05:28:00.948Z","cooked":"\u003cp\u003eYEEESSSSS!!! This is my \u003cem\u003enumber one\u003c/em\u003e feature request.\u003c/p\u003e\n\u003cp\u003eI’d love to have a Slack-like, multiplayer experience inside of Grok Bot, whereby I can share channels with human team members and my/their bots. The bot(s) would have awareness and context, and respond when @-mentioned in the channel, or action routines based on timing/triggers, etc.\u003c/p\u003e\n\u003cp\u003ePermissions would be nice too (like the ability to decide which bots are shared, which are private, etc.)\u003c/p\u003e\n\u003cp\u003eIn one sentence:\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eSlack-like channels with humans + bots, @-mention awareness, routines/triggers, shared-vs-private bot permissions.\u003c/strong\u003e\u003c/p\u003e","post_number":12,"post_type":1,"posts_count":12,"updated_at":"2026-09-11T05:36:44.963Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":18,"reads":18,"readers_count":17,"score":108.6,"yours":false,"topic_id":169904,"topic_slug":"shared-grok-bot-team-across-teammates-same-roster-separate-chats","display_username":"Chris Moore","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":7528,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/shared-grok-bot-team-across-teammates-same-roster-separate-chats/169904/12","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":493001,"name":"Sean Clark","username":"Sean_Clark","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/s/db5fbb/{size}.png","created_at":"2026-09-16T15:02:37.115Z","cooked":"\u003cp\u003eAgree 100%. Its great to have my own private ai team, but we’re a company, and my ai team really should belong to the COMPANY not ME. My whole COMPANY needs to be able to talk to the other staff members.\u003c/p\u003e","post_number":13,"post_type":1,"posts_count":12,"updated_at":"2026-09-16T15:02:37.115Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":13,"reads":17,"readers_count":16,"score":83.4,"yours":false,"topic_id":169904,"topic_slug":"shared-grok-bot-team-across-teammates-same-roster-separate-chats","display_username":"Sean Clark","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":138198,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/shared-grok-bot-team-across-teammates-same-roster-separate-chats/169904/13","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":495031,"name":"Joshua Delano","usern