20\"\u003e\n  \u003cheader class=\"source\"\u003e\n\n      \u003ca href=\"https://x.com/bot/status/2105373767568621895?s=20\" target=\"_blank\" rel=\"noopener\"\u003ex.com\u003c/a\u003e\n  \u003c/header\u003e\n\n  \u003carticle class=\"onebox-body\"\u003e\n    \u003cimg src=\"https://us1.discourse-cdn.com/cursor1/original/3X/5/f/5fc7f5ab399c0e2ee9fe1d7ba7539eb76e3b0d7f.jpeg\" class=\"thumbnail onebox-avatar\" alt=\"\" data-dominant-color=\"909090\" width=\"48\" height=\"48\"\u003e\n\u003ch4\u003e\u003ca href=\"https://x.com/bot/status/2105373767568621895?s=20\" target=\"_blank\" rel=\"noopener\"\u003eGrok Bot\u003c/a\u003e\u003c/h4\u003e\n\u003cdiv class=\"twitter-screen-name\"\u003e\u003ca href=\"https://x.com/bot/status/2105373767568621895?s=20\" target=\"_blank\" rel=\"noopener\"\u003e@bot\u003c/a\u003e\u003c/div\u003e\n\n\u003cdiv class=\"tweet\"\u003e\n  \u003cspan class=\"tweet-description\"\u003eGrok Bot is now more powerful for building software.\n\nBots can hand off coding tasks to Cursor, manage your PRs with GitHub and Origin plugins, and share video demos of what they build. \u003ca target=\"_blank\" href=\"https://x.com/bot/status/2105373767568621895/photo/1\" rel=\"noopener\"\u003epic.x.com/7LXiFvSZN2\u003c/a\u003e\u003cdiv class=\"aspect-image-full-size\" style=\"--aspect-ratio:690/462;\"\u003e\u003cimg class=\"tweet-image\" src=\"https://us1.discourse-cdn.com/cursor1/optimized/3X/b/f/bfbfe7f65043bc7a325b7d683057501eef1f54b7_2_690x462.jpeg\" data-dominant-color=\"C3D6EB\" width=\"690\" height=\"462\"\u003e\u003c/div\u003e\u003c/span\u003e\n\u003c/div\u003e\n\n\u003cdiv class=\"date\"\u003e\n  \u003ca href=\"https://x.com/bot/status/2105373767568621895?s=20\" class=\"timestamp\" target=\"_blank\" rel=\"noopener\"\u003e7:06 PM - 30 Sep 2026\u003c/a\u003e\n\n    \u003cspan class=\"like\"\u003e\n      \u003csvg viewBox=\"0 0 512 512\" width=\"14px\" height=\"16px\" aria-hidden=\"true\"\u003e\u003cpath d=\"M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z\"\u003e\u003c/path\u003e\u003c/svg\u003e\n      2.5K\n    \u003c/span\u003e\n\n    \u003cspan class=\"retweet\"\u003e\n      \u003csvg viewBox=\"0 0 640 512\" width=\"14px\" height=\"16px\" aria-hidden=\"true\"\u003e\u003cpath d=\"M629.657 343.598L528.971 444.284c-9.373 9.372-24.568 9.372-33.941 0L394.343 343.598c-9.373-9.373-9.373-24.569 0-33.941l10.823-10.823c9.562-9.562 25.133-9.34 34.419.492L480 342.118V160H292.451a24.005 24.005 0 0 1-16.971-7.029l-16-16C244.361 121.851 255.069 96 276.451 96H520c13.255 0 24 10.745 24 24v222.118l40.416-42.792c9.285-9.831 24.856-10.054 34.419-.492l10.823 10.823c9.372 9.372 9.372 24.569-.001 33.941zm-265.138 15.431A23.999 23.999 0 0 0 347.548 352H160V169.881l40.416 42.792c9.286 9.831 24.856 10.054 34.419.491l10.822-10.822c9.373-9.373 9.373-24.569 0-33.941L144.971 67.716c-9.373-9.373-24.569-9.373-33.941 0L10.343 168.402c-9.373 9.373-9.373 24.569 0 33.941l10.822 10.822c9.562 9.562 25.133 9.34 34.419-.491L96 169.881V392c0 13.255 10.745 24 24 24h243.549c21.382 0 32.09-25.851 16.971-40.971l-16.001-16z\"\u003e\u003c/path\u003e\u003c/svg\u003e\n      180\n    \u003c/span\u003e\n\u003c/div\u003e\n\n  \u003c/article\u003e\n\n  \u003cdiv class=\"onebox-metadata\"\u003e\n    \n    \n  \u003c/div\u003e\n\n  \u003cdiv style=\"clear: both\"\u003e\u003c/div\u003e\n\u003c/aside\u003e\n\n\u003cp\u003eOn Cloud environments: Grok Bot can already launch Cursor cloud agents into a saved environment from your \u003ca href=\"http://cursor.com\"\u003ecursor.com\u003c/a\u003e dashboard, and those runs use that environment’s setup along with your Cloud Agent secrets. What your bot can’t do yet is browse your saved environments on its own, which is why it told you the environment wasn’t set up.\u003c/p\u003e\n\u003cp\u003eTry giving it the environment’s exact name, for example: “run the tests in a cloud agent using my saved Cloud Agents environment called ”.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":2,"updated_at":"2026-09-30T22:32:15.447Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":4,"readers_count":3,"score":5.6,"yours":false,"topic_id":172777,"topic_slug":"grok-bot-dev-team-orchestration-feedback","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://x.com/bot/status/2105373767568621895?s=20","internal":false,"reflection":false,"title":"Grok Bot on X: \"Grok Bot is now more powerful for building software. Bots can hand off coding tasks to Cursor, manage your PRs with GitHub and Origin plugins, and share video demos of what they build.\" / X","clicks":0},{"url":"http://cursor.com","internal":false,"reflection":false,"title":"AI Coding Agent for Building Ambitious Software | Cursor","clicks":0}],"read":true,"user_title":"Community Support Engineer","title_is_group":false,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":87436,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-dev-team-orchestration-feedback/172777/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[499057,504396]},"timeline_lookup":[[1,8],[2,1]],"suggested_topics":[],"tags":[{"id":312,"name":"cloud-agents","slug":"cloud-agents"},{"id":416,"name":"gr