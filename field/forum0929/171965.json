readers_count":2,"score":0.6,"yours":false,"topic_id":171965,"topic_slug":"cursor-agent-requests-randomly-blocked-by-model-provider","display_username":"David Defoe","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":140154,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/cursor-agent-requests-randomly-blocked-by-model-provider/171965/8","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":502950,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-28T18:29:28.001Z","cooked":"\u003cp\u003eHey, thanks for reaching out. What you’re seeing is the same model-side content filter that’s been incorrectly flagging some normal dev prompts over the last few days like pasted logs, stack traces, hostnames, and DB status or field logic as sensitive. It’s not anything in your project or setup. We’re aware of the issue and tracking it with the provider, but I can’t share an ETA yet.\u003c/p\u003e\n\u003cp\u003eWhat should unblock you right now:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eIn the model picker at the bottom of the chat, switch from Auto or Grok to a specific non-Grok model like Claude or GPT for these requests. You can switch back later.\u003c/li\u003e\n\u003cli\u003eIf you want to stay on the current model, trim the pasted logs and error output down to one or two key lines, and remove hostnames and ports before sending.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eIf this happens again on a specific non-Grok model not via Auto, send a fresh Request ID from the error block using the top-right chat menu \u0026gt; Copy Request ID, and we’ll take a closer look.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":5,"updated_at":"2026-09-28T18:29:28.001Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":171965,"topic_slug":"cursor-agent-requests-randomly-blocked-by-model-provider","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/cursor-agent-requests-randomly-blocked-by-model-provider/171965/9","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[493512,495666,502709,502797,502950]},"timeline_lookup":[[1,12],[2,10],[3,0]],"suggested_topics":[],"tags":[{"id":272,"name":"chat","slug":"chat"}],"tags_descriptions":{},"fancy_title":"Cursor Agent Requests Randomly Blocked by Model Provider","id":171965,"title":"Cursor Agent Requests Randomly Blocked by Model Provider","posts_count":5,"created_at":"2026-09-17T06:10:31.630Z","views":134,"reply_count":0,"like_count":0,"last_posted_at":"