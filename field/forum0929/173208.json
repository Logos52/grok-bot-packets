aff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}}]},{"fancy_title":"Bugbot - Team MCP shows Connected and Team Rules load, but MCP is never called","id":173040,"title":"Bugbot - Team MCP shows Connected and Team Rules load, but MCP is never called","slug":"bugbot-team-mcp-shows-connected-and-team-rules-load-but-mcp-is-never-called","posts_count":1,"reply_count":0,"highest_post_number":1,"image_url":null,"created_at":"2026-09-26T08:02:02.124Z","last_posted_at":"2026-09-26T08:02:02.180Z","bumped":true,"bumped_at":"2026-09-26T08:02:02.180Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"Where does the bug appear (feature/product)?\nBugbot / Security Review Agent \nDescribe the Bug\nBugbot (Team plan). \nTeam MCP shows as Connected. \nRequired Team Rules that tell Bugbot to call that MCP are included in bugbo\u0026hellip;","visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"thumbnails":null,"tags":[{"id":47,"name":"mcp","slug":"mcp"},{"id":295,"name":"rules","slug":"rules"},{"id":311,"name":"bugbot","slug":"bugbot"}],"tags_descriptions":{},"like_count":0,"views":15,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":"latest single","description":"Original Poster, Most Recent Poster","user":{"id":139867,"username":"CM_distilled","name":"","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/c/0ea827/{size}.png","trust_level":0}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":502631,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-28T13:17:40.138Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/jsolly\"\u003e@jsolly\u003c/a\u003e, thanks for the report!\u003c/p\u003e\n\u003cp\u003eThis was a server-side issue on our end, not anything in your setup. A change that went out early this morning caused some scheduled and background tasks to start without access to any connectors, so Inkbox (and every other connector) looked missing to those runs even though it was installed and signed in. That is also why the status check still said connected and restarting didn’t help: the connector itself was fine, the run just wasn’t being given access to it.\u003c/p\u003e\n\u003cp\u003eA fix rolled out around 6:15 AM ET, shortly before your iMessage alert went through at 7:17. Nothing needs to change on your side.\u003c/p\u003e\n\u003cp\u003eIf a connector goes missing like this again, reply here with the time and the conversation ID and we’ll take a look.\u003c/p\u003e","post_number":5,"topic_id":173208,"url":"/t/grok-bot-inkbox-mcp-shows-connected-with-51-tools-but-agent-gets-mcp-server-not-found/173208/5","accepter_name":"John Solly","accepter_username":"jsolly"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":30025,"username":"jsolly","name":"John Solly","avatar_template":"/user_avatar/forum.cursor.com/jsolly/{size}/33752_2.png","post_count":2,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":2},{"id":87436,"username":"Colin","name":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","post_count":1,"primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"http