3\u003e\u003ca name=\"p-493797-does-this-stop-you-from-using-cursor-8\" class=\"anchor\" href=\"#p-493797-does-this-stop-you-from-using-cursor-8\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDoes this stop you from using Cursor\u003c/h3\u003e\n\u003cp\u003eSometimes - I can sometimes use Cursor\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":3,"updated_at":"2026-09-17T10:51:27.632Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":13,"reads":9,"readers_count":8,"score":66.8,"yours":false,"topic_id":172001,"topic_slug":"grok-bot-one-bot-tlc-outbounds-failed-to-send-others-ok-please-restart-runner-only","display_username":"Adam Purslow","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://forum.cursor.com/t/some-of-the-bots-became-unresponsive-failed-to-send-on-my-messages-to-them/171858/169","internal":true,"reflection":true,"title":"Some of the bots became unresponsive (failed to send on my messages to them)","clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":138359,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-one-bot-tlc-outbounds-failed-to-send-others-ok-please-restart-runner-only/172001/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":493834,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-17T11:01:49.553Z","cooked":"\u003cp\u003eHey, thanks for the report. First off, your computer is fine. No need to restart or reset it. Reset/Update won’t help here and could lose recent changes on the bot, so please don’t touch those.\u003c/p\u003e\n\u003cp\u003eWhat happened: one turn on TLC Outbounds got stuck on our side around 1:43 PM Dubai time, and the “Testing” message you sent at 2:10 PM ended up queued behind it. Other bots kept working normally, which matches what’s in the screenshot. Hospo, Client news, TLC General, etc. reply, only TLC Outbounds stays silent.\u003c/p\u003e\n\u003cp\u003eWe’re tracking this issue. Usually these stuck turns clear on their own within a couple of hours, and then the bot replies to the queued message. So TLC Outbounds should come back by itself.\u003c/p\u003e\n\u003cp\u003eIf it’s still silent after that, reply here with the time of your last message to it, and we’ll clear the queue manually.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":3,"updated_at":"2026-09-17T11:01:49.553Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":6,"readers_count":5,"score":6.2,"yours":false,"topic_id":172001,"topic_slug":"grok-bot-one-bot-tlc-outbounds-failed-to-send-others-ok-please-restart-runner-only","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-one-bot-tlc-outbounds-failed-to-send-others-ok-