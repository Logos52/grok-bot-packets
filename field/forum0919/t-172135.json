c/h3\u003e\n\u003cp\u003eAccount: \u003ca href=\"mailto:vlk34vlk34@gmail.com\"\u003evlk34vlk34@gmail.com\u003c/a\u003e (\u003cspan class=\"mention\"\u003e@volkanjs\u003c/span\u003e)\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-494916-does-this-stop-you-from-using-cursor-11\" class=\"anchor\" href=\"#p-494916-does-this-stop-you-from-using-cursor-11\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDoes this stop you from using Cursor\u003c/h3\u003e\n\u003cp\u003eNo - Cursor works, but with this issue\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-18T11:12:01.151Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":4,"reads":6,"readers_count":5,"score":21.2,"yours":false,"topic_id":172135,"topic_slug":"cant-reach-your-computer-on-macos-recover-and-reset-both-fail-at-50","display_username":"Volkan Erdogan","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"http://cursorvm.com","internal":false,"reflection":false,"clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":138617,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/cant-reach-your-computer-on-macos-recover-and-reset-both-fail-at-50/172135/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":494963,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-18T11:39:50.627Z","cooked":"\u003cp\u003eHey, thanks for the detailed report, and for ruling out DNS, network, hotspot, VPN, and privacy upfront. You were looking in the right direction. This isn’t on your Mac or in your setup.\u003c/p\u003e\n\u003cp\u003eWhat’s happening is that your Grok Bot computer never finished the very first initialization, so Recover and Reset can’t complete from the app. They both get stuck on the same server-side step. There’s nothing you can do on your side to change this, so for now please don’t run Reset again. It won’t finish anyway.\u003c/p\u003e\n\u003cp\u003eThis is a known issue we’re tracking, and it needs to be fixed on our side. I’ve passed your case to the team to investigate.\u003c/p\u003e\n\u003cp\u003eYour account and the chat you already created with the bot are safe. The chat runs on our servers, which is why it can keep replying while the computer is unavailable.\u003c/p\u003e\n\u003cp\u003eOnce I have an update on your computer, We’ll reply here. After that, you’ll just need to fully quit Grok Bot menu bar icon → Quit and open it again.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":2,"updated_at":"2026-09-18T11:40:10.769Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":6,"readers_count":5,"score":1.2,"yours":false,"topic_id":172135,"topic_slug":"cant-reach-your-computer-on-macos-recover-and-reset-both-fail-at-50","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":fal