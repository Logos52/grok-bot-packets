NA\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-494502-additional-information-8\" class=\"anchor\" href=\"#p-494502-additional-information-8\" aria-label=\"Heading link\"\u003e\u003c/a\u003eAdditional Information\u003c/h3\u003e\n\u003cp\u003eNA\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-494502-does-this-stop-you-from-using-cursor-9\" class=\"anchor\" href=\"#p-494502-does-this-stop-you-from-using-cursor-9\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDoes this stop you from using Cursor\u003c/h3\u003e\n\u003cp\u003eNo - Cursor works, but with this issue\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-18T01:16:09.745Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":10,"reads":3,"readers_count":2,"score":50.6,"yours":false,"topic_id":172087,"topic_slug":"grok-bot-briefly-shows-creating-grok-bot-s-computer-then-the-main-window-goes-fully-white-blank","display_username":"August Su - TW (SR)","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":138536,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-briefly-shows-creating-grok-bot-s-computer-then-the-main-window-goes-fully-white-blank/172087/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":494725,"name":"Mohit","username":"mohitjain","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png","created_at":"2026-09-18T08:14:51.971Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/august_su_tw_sr\"\u003e@August_Su_TW_SR\u003c/a\u003e! On our side your account and Grok Bot’s computer are healthy, and your Windows app is now connecting to it normally. So nothing’s stuck, and no need to use Update or Reset. Is it working for you now?\u003c/p\u003e\n\u003cp\u003eA fully white window like that on Windows is almost always local antivirus or a proxy doing “HTTPS scanning” and intercepting the app’s secure connection (Grok Bot trusts a narrower set of certificates than your browser, so it fails and shows blank instead of an error).\u003c/p\u003e\n\u003cp\u003eIf it comes back: open \u003ccode\u003ehttps://api2.cursor.sh\u003c/code\u003e in your browser, check the certificate’s Issued by - it should be Amazon. If it shows an antivirus/proxy/company name, turn off its HTTPS/encrypted-connections scanning (or add Grok Bot to exclusions), then fully quit Grok Bot from the tray and reopen. More here: \u003ca href=\"https://cursor.com/help/troubleshooting/network\"\u003eNetwork troubleshooting\u003c/a\u003e.\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":2,"updated_at":"2026-09-18T08:14:51.971Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":172087,"topic_slug":"grok-bot-briefly-shows-creating-grok-bot-s-computer-then-the-main-window-goes-fully-white-blank","display_username":"Mohit","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://cursor.com/help/troubleshooting/network","internal":false,"reflection":false,"title":"