n’t something in your setup. Switching to a redirect Zoom accepts, like \u003ccode\u003e127.0.0.1\u003c/code\u003e, is the direction we’re looking at.\u003c/p\u003e\n\u003cp\u003eAs soon as I have something to share, I’ll reply right here in the thread.\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":7,"updated_at":"2026-09-04T17:57:54.445Z","reply_count":0,"reply_to_post_number":7,"quote_count":0,"incoming_link_count":1,"reads":5,"readers_count":4,"score":6.0,"yours":false,"topic_id":169991,"topic_slug":"grok-bot-zoom-plugin-oauth-hardcodes-http-localhost-8787-callback-zoom-rejects-hostname-localhost-error-4700","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","reply_to_user":{"id":136158,"username":"Bluetogold","name":"Anthomy","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/b/6f9a4e/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-zoom-plugin-oauth-hardcodes-http-localhost-8787-callback-zoom-rejects-hostname-localhost-error-4700/169991/9","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":486948,"name":"Ryan Allen","username":"Ryan_Allen","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/r/43a26b/{size}.png","created_at":"2026-09-09T02:07:28.887Z","cooked":"\u003cp\u003eAlso having the same issue. Let me know when it’s fixed. Has anybody found a workaround here?\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":7,"updated_at":"2026-09-09T02:07:28.887Z","reply_count":1,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":5.8,"yours":false,"topic_id":169991,"topic_slug":"grok-bot-zoom-plugin-oauth-hardcodes-http-localhost-8787-callback-zoom-rejects-hostname-localhost-error-4700","display_username":"Ryan Allen","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":136923,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-zoom-plugin-oauth-hardcodes-http-localhost-8787-callback-zoom-rejects-hostname-localhost-error-4700/169991/10","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":487239,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-09T10:49:18.128Z","cooked":"\u003cp\u003eHey, yeah, this is the same issue described in the thread above. Sign-in for the Zoom plugin currently uses \u003ccode\u003ehttp://localhost:8787/callback\u003c/code\u003e as the redirect, and Zoom no longer accepts the \u003ccode\u003elocalhost\u003c/code\u003e hostname for OAuth redirects, which causes error 4700.\u003c/p\u003e\n\u003cp\u003eUnfortunately, there’s no workaround on your side. The redirect isn’t configurable in the app, so you can’t fix it via Zoom app settings. This isn’t anything in your setup.\u003c/p\u003e\n\u003cp\u003eWe’re aware of the issue. Switching to a redirect that Zoom accepts, like \u003ccode\u003e127.0.0.1\u003c/code\u003e, is the direction we’re looking at. I can’t share an exact timeline yet, but as soon as there’s an update I’ll reply here in the thread.\u003c/p\u003e","post_number":11,"post_type":1,"posts_count":7,"updated_at":"2026-09-09T10:49:18.128Z","reply_count":0,"reply_to_post_number":10,"quote_count":0,"incoming_link_count":1,"reads":3,"readers_count":2,"score":5.6,"yours":false,"topic_id":169991,"topic_slug":"grok-bot-zoom-plugin-oauth-hardcodes-http-localhost-8787-callback-zoom-rejects-hostname-localhost-error-4700","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","reply_to_user":{"id":136923,"username":"Ryan_Allen","name":"Ryan Allen","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/r/43a26b/{size}.png"},"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-zoom-plugin-oauth-hardcodes-http-localhost-8787-callback-zoom-rejects-hostname-localhost-error-4700/169991/11","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":487760,"name":"Garrett LaBorde","username":"Garrett_LaBorde","avatar_template":"http