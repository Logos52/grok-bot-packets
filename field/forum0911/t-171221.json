leghuman","avatar_template":"/user_avatar/forum.cursor.com/olegdater/{size}/957_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":77332,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-ultra-users-how-do-you-make-the-weekly-allowance-last-mine-reached-99-in-three-days/171221/7","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":488106,"name":"David Stredansky","username":"David_Stredansky","avatar_template":"/user_avatar/forum.cursor.com/david_stredansky/{size}/117231_2.png","created_at":"2026-09-10T11:56:24.051Z","cooked":"\u003cp\u003efresh conversation per task on grok bot? How is that even possible and doesn’t that defeat the purpose? In Cursor this makes sense but not in Bot\u003c/p\u003e","post_number":9,"post_type":1,"posts_count":8,"updated_at":"2026-09-10T11:56:24.051Z","reply_count":0,"reply_to_post_number":5,"quote_count":0,"incoming_link_count":0,"reads":16,"readers_count":15,"score":3.2,"yours":false,"topic_id":171221,"topic_slug":"grok-bot-ultra-users-how-do-you-make-the-weekly-allowance-last-mine-reached-99-in-three-days","display_username":"David Stredansky","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":103596,"username":"mohitjain","name":"Mohit","avatar_template":"/user_avatar/forum.cursor.com/mohitjain/{size}/100229_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":132292,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-ultra-users-how-do-you-make-the-weekly-allowance-last-mine-reached-99-in-three-days/171221/9","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":488126,"name":"Oleghuman","username":"olegdater","avatar_template":"/user_avatar/forum.cursor.com/olegdater/{size}/957_2.png","created_at":"2026-09-10T12:56:50.894Z","cooked":"\u003cp\u003eOMG, where did you learn it? and where I can learn all the tricks like this\u003c/p\u003e\n\u003cp\u003eI did not expect you could have multi chats with same Bot, it does not fit human pattern so I did not get it, thanks for pointing out\u003c/p\u003e","post_number":10,"post_type":1,"posts_count":8,"updated_at":"2026-09-10T12:57:34.887Z","reply_count":0,"reply_to_post_number":7,"quote_count":0,"incoming_link_count":0,"reads":15,"readers_count":14,"score":3.0,"yours":false,"topic_id":171221,"topic_slug":"grok-bot-ultra-users-how-do-you-make-the-weekly-allowance-last-mine-reached-99-in-three-days","display_username":"Oleghuman","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","reply_to_user":{"id":77332,"username":"alanbaljeu","name":"Alan Baljeu","avatar_template":"/user_avatar/forum.cursor.com/alanbaljeu/{size}/92948_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":536,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-ultra-users-how-do-you-make-the-weekly-allowance-last-mine-reached-99-in-three-days/171221/10","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":488257,"name":"Julius","username":"julis","avatar_template":"/user_avatar/forum.cursor.com/julis/{size}/120485_2.png","created_at":"2026-09-10T16:21:02.863Z","cooked":"\u003cp\u003eOleg, that Day 1 65% spike then creeping to 99% is brutal. One pattern that helps: treat long-lived bots like leaky sessions. Cap routine frequency, force a fresh chat when context is mostly cache reads, and move heavy implementation to short-lived Cursor Agents so the bot only coordinates. Happy to compare what your day-2/3 export looked like if useful.\u003c/p\u003e","post_number":11,"post_type":1,"posts_count":8,"updated_at":"2026-09-10T16:21:02.863Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":12,"readers_count":11,"score":2.4,"yours":false,"topic_id":171221,"topic_slug":"grok-bot-ultra-users-how-do-you-make-the-weekly-allowance-last-mine-reached-99-in-three-days","display_username":"Julius","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":137194,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-ultra-users-how-do-you-make-the-weekly-allowance-last-mine-reached-99-in-three-days/171221/11","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answe