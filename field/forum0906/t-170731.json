r / Update / Reset Agent Computer.\u003c/p\u003e\n\u003cp\u003eAndroid (Grok Bot mobile app)\u003c/p\u003e\n\u003cp\u003eGrok Bot Android 1.5.0 (120)\u003c/p\u003e\n\u003cp\u003eNot Cursor IDE — this is the Grok Bot app.\u003c/p\u003e\n\u003cp\u003eNo Request ID shown in the Android app.\u003c/p\u003e\n\u003cp\u003eAccount name: Ah Ah\u003c/p\u003e\n\u003cp\u003eLogin / email: \u003ca href=\"mailto:chechuchka67@proton.me\"\u003echechuchka67@proton.me\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003eBot: Chief of Staff\u003c/p\u003e\n\u003cp\u003eTimezone in app: Europe/Moscow\u003c/p\u003e\n\u003cp\u003eAlready tried: force-stop app, clear cache, sign out/in, “Stop now”, creating a new bot.\u003c/p\u003e\n\u003cp\u003ePlease recover or rebuild the Agent Computer for this account on the backend.\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":3,"updated_at":"2026-09-05T23:59:19.396Z","reply_count":0,"reply_to_post_number":2,"quote_count":0,"incoming_link_count":0,"reads":1,"readers_count":0,"score":0,"yours":false,"topic_id":170731,"topic_slug":"grok-bot-android-bot-failed-to-respond-cannot-create-bot","display_username":"Ah Ah","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":-1,"username":"system","name":"system","avatar_template":"/user_avatar/forum.cursor.com/system/{size}/99069_2.png"},"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":136365,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-android-bot-failed-to-respond-cannot-create-bot/170731/4","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false