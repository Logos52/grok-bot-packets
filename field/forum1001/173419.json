{"post_stream":{"posts":[{"id":504034,"name":"","username":"Danick","avatar_template":"/user_avatar/forum.cursor.com/danick/{size}/122453_2.png","created_at":"2026-09-30T15:35:19.558Z","cooked":"\u003cp\u003eHey guys, while i was on a personal plan, whenever grokbot started a cloud agent to work (on a pr), it would use my personal usage, but ever since moving to our team organisation, they now use the team cloud credits, how can i make it go back to using my personal cursor usage?\u003c/p\u003e\n\u003cp\u003ewe use our grokbots a lot with cloud agents to review prs, or other misc stuff where we tag them\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-30T15:35:27.687Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":6,"reads":3,"readers_count":2,"score":30.6,"yours":false,"topic_id":173419,"topic_slug":"cloud-agents-by-grokbot-using-team-cloud-credits-instead-of-personal-usage","display_username":"","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":140399,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/cloud-agents-by-grokbot-using-team-cloud-credits-instead-of-personal-usage/173419/1","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":504093,"name":"Colin","username":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","created_at":"2026-09-30T16:26:36.004Z","cooked":"\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/danick\"\u003e@Danick\u003c/a\u003e, thanks for the question!\u003c/p\u003e\n\u003cp\u003eOnce you’re on a team, everything you run, including the cloud agents your Grok Bot starts, is billed through your team seat instead of a personal plan. There isn’t a setting that sends a team member’s usage to a separate personal subscription.\u003c/p\u003e\n\u003cp\u003eThe “team cloud credits” you’re seeing are a one-time promotional credit your team got for setting up a cloud agent environment. They only apply to cloud agents, and they’re used before your seat’s own included usage, so right now they’re saving your included usage rather than replacing it.\u003c/p\u003e\n\u003cp\u003eOnce those credits run out or expire, cloud agents will draw from your seat’s included usage automatically, the same as your other usage. As an admin you can see the credit balance and each member’s usage on the team dashboard under Usage and Billing.\u003c/p\u003e\n\u003cp\u003eIf you really want cloud agents billed to a separate personal plan, the only way is to run Grok Bot from a different Cursor account that isn’t a member of the team.\u003c/p\u003e","post_number":5,"post_type":1,"posts_count":2,"updated_at":"2026-09-30T16:26:36.004Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":2,"readers_count":1,"score":0.4,"yours":false,"topic_id":173419,"topic_slug":"cloud-agents-by-grokbot-using-team-cloud-credits-instead-of-personal-usage","display_username":"Colin","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"Community Support Engineer","title_is_group":