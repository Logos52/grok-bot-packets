{"post_stream":{"posts":[{"id":504010,"name":"CSM Tile Co. Inc","username":"CSM_Tile_Co_Inc","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/c/439d5e/{size}.png","created_at":"2026-09-30T14:57:42.148Z","cooked":"\u003ch3\u003e\u003ca name=\"p-504010-feature-request-for-productservice-1\" class=\"anchor\" href=\"#p-504010-feature-request-for-productservice-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003eFeature request for product/service\u003c/h3\u003e\n\u003cp\u003e– Other –\u003c/p\u003e\n\u003ch3\u003e\u003ca name=\"p-504010-describe-the-request-2\" class=\"anchor\" href=\"#p-504010-describe-the-request-2\" aria-label=\"Heading link\"\u003e\u003c/a\u003eDescribe the request\u003c/h3\u003e\n\u003cp\u003eI’d like the voice I choose saved as a lasting preference, so every call on the phone app starts with it. Right now each new phone call starts on the default voice, and I have to pick my voice again in every call. The desktop app already remembers the choice between calls, so it would be great if the phone app did the same.\u003c/p\u003e\n\u003cp\u003ePlease also make the preference per account or per admin rather than one shared default. My main account uses Leo, and I’ve added an admin who should be able to pick a different voice for themselves without changing mine.\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-09-30T21:03:33.396Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":8,"reads":4,"readers_count":3,"score":40.8,"yours":false,"topic_id":173412,"topic_slug":"remember-each-users-chosen-voice-on-the-grok-bot-phone-app","display_username":"CSM Tile Co. Inc","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":2,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summar