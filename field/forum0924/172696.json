":"grok-bot"},{"id":408,"name":"networking","slug":"networking"},{"id":373,"name":"computer-use","slug":"computer-use"}],"tags_descriptions":{},"like_count":0,"views":58,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":"latest","description":"Original Poster, Most Recent Poster","user":{"id":135088,"username":"ethan-pacifica","name":"Ethan","avatar_template":"/user_avatar/forum.cursor.com/ethan-pacifica/{size}/119137_2.png","trust_level":0}},{"extras":null,"description":"Recent Poster","user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}}]},{"fancy_title":"Grok Bot: Reset failed / computer stuck in partial state — can\u0026rsquo;t connect","id":170430,"title":"Grok Bot: Reset failed / computer stuck in partial state — can't connect","slug":"grok-bot-reset-failed-computer-stuck-in-partial-state-cant-connect","posts_count":2,"reply_count":0,"highest_post_number":5,"image_url":null,"created_at":"2026-09-03T07:11:48.723Z","last_posted_at":"2026-09-03T07:43:18.076Z","bumped":true,"bumped_at":"2026-09-03T07:43:18.076Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"Where does the bug appear (feature/product)?\nGrok Bot \nDescribe the Bug\nGrok Bot version: 0.36.0 \nOS: macOS, Apple Silicon (M1) \nPlan: Cursor Pro (Grok Bot access confirmed via the Pro rollout email; Usage \u0026amp; Billing show\u0026hellip;","visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"thumbnails":null,"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"},{"id":408,"name":"networking","slug":"networking"}],"tags_descriptions":{},"like_count":1,"views":70,"category_id":6,"featured_link":null,"op_like_count":1,"has_accepted_answer":false,"posters":[{"extras":null,"description":"Original Poster","user":{"id":135860,"username":"shubham_chaturvedi","name":"shubham chaturvedi","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/s/73ab20/{size}.png","trust_level":0}},{"extras":"latest","description":"Most Recent Poster","user":{"id":87436,"username":"Colin","name":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":3}}]},{"fancy_title":"Grok Bot (macOS): persistent \u0026ldquo;Can\u0026rsquo;t reach your computer\u0026rdquo;","id":171170,"title":"Grok Bot (macOS): persistent \"Can't reach your computer\"","slug":"grok-bot-macos-persistent-cant-reach-your-computer","posts_count":3,"reply_count":0,"highest_post_number":9,"image_url":null,"created_at":"2026-09-09T14:41:14.563Z","last_posted_at":"2026-09-09T16:09:18.764Z","bumped":true,"bumped_at":"2026-09-09T16:09:18.764Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"Where does the bug appear (feature/product)?\nGrok Bot \nDescribe the Bug\nI created a new account and cannot Grok bot keeps failing trying to set up the computer. I have tried on both desktop and mobile. I’ve tried switchi\u0026hellip;","visible":true,"closed":true,"archived":false,"bookmarked":null,"liked":null,"thumbnails":null,"visibility_reason_id":4,"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"},{"id":408,"name":"networking","slug":"networking"},{"id":373,"name":"computer-use","slug":"computer-use"}],"tags_descriptions":{},"like_count":1,"views":130,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":true,"posters":[{"extras":"latest","description":"Original Poster, Most Recent Poster","user":{"id":137029,"username":"Teddy1","name":"Teddy","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/t/71c47a/{size}.png","trust_level":0}},{"extras":null,"description":"Recent Poster, Accepted Answer","user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"primary_group_name":"CursorStaff","admin":true,"moderator":true,"trust_level":4}},{"extras":null,"description":"Recent Poster","user":{"id":-1,"username":"system","name":"system","avatar_template":"/user_avatar/forum.cursor.com/system/{size}/99069_2.png","admin":true,"moderator":true,"trust_level":4}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":498735,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-23T04:33:16.746Z","cooked":"\u003cp\u003eHey, thanks for the detailed report and the screenshots.\u003c/p\u003e\n\u003cp\u003eGood news first. The Grok Bot computer on our side is working fine. Each Recover and Reset did create a new computer, and it came up in about a minute. The problem is that your Mac’s network can’t resolve the address the app uses to connect to it. This lookup happens on your side, so Recover and Reset won’t fix it. For now, it’s best not to press Reset again.\u003c/p\u003e\n\u003cp\u003eTry switching your Mac to public DNS:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eSystem Settings → Network.\u003c/li\u003e\n\u003cli\u003eSelect your active connection (Wi-Fi or Ethernet) → Details.\u003c/li\u003e\n\u003cli\u003eDNS tab.\u003c/li\u003e\n\u003cli\u003eUnder DNS Servers, click + and add \u003ccode\u003e1.1.1.1\u003c/code\u003e, then click + again and add \u003ccode\u003e8.8.8.8\u003c/code\u003e.\u003c/li\u003e\n\u003cli\u003eOK.\u003c/li\u003e\n\u003cli\u003eFully quit Grok Bot (menu bar icon → Quit, or \u003ccode\u003eCmd+Q\u003c/code\u003e). Just closing the window isn’t enough.\u003c/li\u003e\n\u003cli\u003eOpen Grok Bot again and wait about 2 minutes.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eIf you want to test the lookup directly, open Terminal and run:\u003c/p\u003e\n\u003cpre\u003e\u003ccode class=\"lang-auto\"\u003enslookup test.us12.cursorvm.com\nnslookup test.us12.cursorvm.com 1.1.1.1\n\u003c/code\u003e\u003c/pre\u003e\n\u003cp\u003eIf the first command fails but the second returns an address, that confirms it’s a DNS issue.\u003c/p\u003e\n\u003cp\u003eIf you can’t change DNS, switching to a different ISP can help. A hotspot from the same provider usually won’t help. After switching networks, fully quit and reopen the app again.\u003c/p\u003e\n\u003cp\u003eLet me know if the Can’t reach your computer banner disappears after step 7. If not, please send the output of both commands.\u003c/p\u003e","post_number":5,"topic_id":172696,"url":"/t/can-t-reach-your-computer-on-macos/172696/5","accepter_name":"Vikas Dakshi","accepter_username":"Vikas_Dakshi"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","post_count":1,"primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_color":"","flair_bg_color":"","flair_group_id":42,"admin":true,"moderator":true,"trust_level":4},{"id":139277,"username":"Vikas_Dakshi","name":"Vikas Dakshi","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/v/e19adc/{size}.png","post_count":1,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":0}],"created_by":{"id":139277,"username":"Vikas_Dakshi","name":"Vikas Dakshi","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/v/e19adc/{size}.png"},"last_poster":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png"}},"bookmarks":[]}