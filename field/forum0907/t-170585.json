display_username":"Oleje32","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"http://cursorvm.com","internal":false,"reflection":false,"clicks":1}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":false,"admin":false,"staff":false,"user_id":136424,"hidden":false,"trust_level":0,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/windows-11-grok-bot-cant-reach-computer-cursorvm-com/170585/6","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":484659,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-06T16:48:31.490Z","cooked":"\u003cp\u003eThanks for the details and screenshots. I can see the curl output and the DNS lookup for \u003ca href=\"http://cursorvm.com\"\u003ecursorvm.com\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eGood news: your tests show that your direct network connection is working. \u003ccode\u003ecurl.exe -sI https://api2.cursor.sh\u003c/code\u003e returned \u003ccode\u003eHTTP/1.1 200 OK\u003c/code\u003e, and \u003ccode\u003ecurl.exe -sI https://test.us8.cursorvm.com\u003c/code\u003e returned \u003ccode\u003e404 Not Found\u003c/code\u003e from \u003ccode\u003eawselb/2.0\u003c/code\u003e. That means the request reached our servers just fine. The 404 on that path is expected. So it doesn’t look like your firewall or DNS is blocking anything.\u003c/p\u003e\n\u003cp\u003eAbout \u003ccode\u003eone.one.one.one can't find cursorvm.com: Not implemented\u003c/code\u003e, that’s normal and not the cause. The \u003ccode\u003ecursorvm.com\u003c/code\u003e root domain doesn’t have an A record. You can also see that in the second screenshot where it says it has no A records. Grok Bot only uses subdomains like \u003ccode\u003etest.us8.cursorvm.com\u003c/code\u003e, and those resolve fine for you.\u003c/p\u003e\n\u003cp\u003eSince the direct network path looks fine, we should look at the app side. Could you please share:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eYour Grok Bot version (Settings → Updates).\u003c/li\u003e\n\u003cli\u003eDoes the same account work on your phone or another device right now?\u003c/li\u003e\n\u003cli\u003eWindows Settings → Network \u0026amp; Internet → Proxy: is Use a proxy server or Use setup script enabled? If yes, which tool set it up (v2ray, Clash, etc.).\u003c/li\u003e\n\u003cli\u003eConnect your PC to your phone hotspot for a minute and try signing into Grok Bot again. Did it help or not?\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eWith that info, I can narrow down exactly where the connection is failing.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":4,"updated_at":"2026-09-06T16:48:31.490Z","reply_count":0,"reply_to_post_number":6,"quote_count":0,"incoming_link_count":0,"reads":3,"readers_count":2,"score":0.6,"yours":false,"topic_id":170585,"topic_slug":"windows-11-grok-bot-cant-reach-computer-cursorvm-com","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"http://cursorvm.com","internal":false,"reflection":false,"clicks":0}],"read":true,"user_title":"","reply_to_user":{"id":136424,"username":"oleje32","name":"Oleje32","avatar_template":"/us