":0,"incoming_link_count":0,"reads":4,"readers_count":3,"score":0.8,"yours":false,"topic_id":170745,"topic_slug":"grok-bot-windows-one-chat-can-send-but-replies-never-render-in-main-pane-sidebar-preview-ok-mobile-ok","display_username":"system","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":-1,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"action_code":"visible.enabled","post_url":"/t/grok-bot-windows-one-chat-can-send-but-replies-never-render-in-main-pane-sidebar-preview-ok-mobile-ok/170745/5","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null},{"id":484437,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-06T08:24:34.519Z","cooked":"\u003cp\u003eHey, thanks for the detailed report. What you’re describing matches a known issue we’re tracking.\u003c/p\u003e\n\u003cp\u003eQuick summary of what’s happening: in a chat where the bot recently asked for a key or password (secret card), the Windows desktop app stops showing new replies in the main panel. Your messages still reach the bot, and the sidebar preview and mobile app show everything normally. Your computer and the bot are fine, so you don’t need to Reset or Recover, reinstall the app, or clear data. It won’t change anything here.\u003c/p\u003e\n\u003cp\u003eA fix is already rolling out automatically on our side. You don’t need to update the app. Once your computer picks it up, within 24 hours max, this chat will load normally again on Windows, including the replies that aren’t visible right now.\u003c/p\u003e\n\u003cp\u003eFor now, the chat is fully readable on mobile, and other chats on PC should keep working.\u003c/p\u003e\n\u003cp\u003eIf replies still don’t show up on Windows after 24 hours, reply here and include the time you tried, and we’ll take another look.\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":2,"updated_at":"2026-09-06T08:24:34.519Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":1,"reads":3,"readers_count":2,"score":5.6,"yours":false,"topic_id":170745,"topic_slug":"grok-bot-windows-one-chat-can-send-but-replies-never-render-in-main-pane-sidebar-preview-ok-mobile-ok","display_username":"Dean Rie","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_bg_color":"","flair_color":"","flair_group_id":42,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":true,"admin":true,"staff":true,"user_id":750,"hidden":false,"trust_level":4,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":false,"wiki":false,"post_url":"/t/grok-bot-windows-one-chat-can-send-but-replies-never-render-in-main-pane-sidebar-preview-ok-mobile-ok/170745/7","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[484337,484338,484387,484437]},"timeline_lookup":[[1,1]],"suggested_topics":[],"tags":[{"id":272,"name":"chat","slug":"chat"},{"id":416,"name":"grok-bot","slug":"grok-bot"}],"tags_descriptions":{},"fa