sor1/optimized/3X/6/d/6d94a96ea910783540950d82f672df6999a81237_2_92x200.jpeg"}],"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"}],"tags_descriptions":{},"like_count":0,"views":26,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":null,"description":"Original Poster","user":{"id":136448,"username":"Steve_Grayt","name":"Steve Clements","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/s/82dd89/{size}.png","trust_level":0}},{"extras":"latest","description":"Most Recent Poster","user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"admin":true,"moderator":true,"trust_level":4}}]},{"fancy_title":"Grok Bot 0.39.0 macOS — can\u0026rsquo;t reach computer","id":170536,"title":"Grok Bot 0.39.0 macOS — can't reach computer","slug":"grok-bot-0-39-0-macos-cant-reach-computer","posts_count":5,"reply_count":2,"highest_post_number":9,"image_url":null,"created_at":"2026-09-04T06:39:12.439Z","last_posted_at":"2026-09-05T08:42:15.261Z","bumped":true,"bumped_at":"2026-09-05T08:42:15.261Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"excerpt":"Where does the bug appear (feature/product)?\nGrok Bot \nDescribe the Bug\nGrok Bot desktop 0.39.0 on macOS cannot reach its cloud computer. It shows “Can’t Reach Grok Bot’s Computer” and tells IT to allow *.cursorrm.com; R\u0026hellip;","visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"thumbnails":null,"tags":[{"id":416,"name":"grok-bot","slug":"grok-bot"},{"id":408,"name":"networking","slug":"networking"},{"id":308,"name":"privacy-mode","slug":"privacy-mode"}],"tags_descriptions":{},"like_count":0,"views":91,"category_id":6,"featured_link":null,"op_like_count":0,"has_accepted_answer":false,"posters":[{"extras":null,"description":"Original Poster","user":{"id":136084,"username":"mblabs.io","name":"MB","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/m/dec6dc/{size}.png","trust_level":0}},{"extras":"latest","description":"Most Recent Poster","user":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"admin":true,"moderator":true,"trust_level":4}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":484517,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-06T11:54:40.739Z","cooked":"\u003cp\u003eHey, thanks for the detailed report. Good news: your Grok Bot computer and Bots are fine, they’re working on our side and nothing is lost. You don’t need Reset, Recover, or Update here.\u003c/p\u003e\n\u003cp\u003eThis is a known issue on 0.43.0: if your Cursor password was recently changed or reset, or you signed out on another device, it signs out all devices. The 0.43.0 desktop app keeps the old session and, instead of asking you to sign in again, shows Couldn’t Reach Grok Bot’s Computer. For the same reason, Update, Recover, and Reset fail too.\u003c/p\u003e\n\u003cp\u003eFix: just sign out and sign back in in the desktop app.\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eIn Grok Bot on Mac, click your name or avatar at the bottom left of the sidebar.\u003c/li\u003e\n\u003cli\u003eChoose Sign out and confirm.\u003c/li\u003e\n\u003cli\u003eSign in again with the same Cursor account you used to create your Bots, using your new password. If you have multiple Cursor accounts, make sure you pick the right one.\u003c/li\u003e\n\u003cli\u003eWait about a minute. Your Bots should load.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eIf you don’t see Sign out in the menu, right-click the Grok Bot icon in the menu bar, choose Quit, reopen the app, and try again.\u003c/p\u003e\n\u003cp\u003eLet me know if it still won’t connect after signing in again.\u003c/p\u003e","post_number":5,"topic_id":170775,"url":"/t/grok-bot-lost-connection-with-its-computer-and-cant-update-recover-reset/170775/5","accepter_name":"Panda","accepter_username":"grokpanda"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","post_count":1,"primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_color":"","flair_bg_color":"","flair_group_id":42,"admin":true,"moderator":true,"trust_level":4},{"id":136423,"username":"grokpanda","name":"Panda","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/g/53a042/{size}.png","post_count":1,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":0}],"created_by":{"id":136423,"username":"grokpanda","name":"Panda","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/g/53a042/{size}.png"},"last_poster":{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png"}},"