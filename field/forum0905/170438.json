xtras":"latest","description":"Most Recent Poster","user":{"id":87436,"username":"Colin","name":"Colin","avatar_template":"/user_avatar/forum.cursor.com/colin/{size}/90452_2.png","primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_group_id":42,"admin":true,"moderator":true,"trust_level":3}}]}],"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","crossed_fingers","clap","laughing","open_mouth","confetti_ball","hugs","heavy_plus_sign","heart_eyes","sunglasses","cursor"],"accepted_answers":[{"id":482069,"name":"Dean Rie","username":"deanrie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","created_at":"2026-09-03T09:44:37.012Z","cooked":"\u003cp\u003eHey, thanks for the report. Good news: your computer and bots are OK and reachable. The issue isn’t with them or with your network.\u003c/p\u003e\n\u003cp\u003eWhat happened: the Grok Bot desktop app is still using a login session from before you changed your Cursor password on September 2. Changing your password ends all existing sessions, so every request from the app gets rejected after that, and it shows it as “Can’t reach your computer”. The update to 0.36.0 just installed on top of that and isn’t the cause. Your DNS is fine too.\u003c/p\u003e\n\u003cp\u003eTo fix it, sign out in the desktop app and sign back in:\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003eIn Grok Bot, click your name or avatar in the bottom left of the sidebar.\u003c/li\u003e\n\u003cli\u003eSelect Sign out and confirm.\u003c/li\u003e\n\u003cli\u003eSign in again with your Cursor account using the new password.\u003c/li\u003e\n\u003cli\u003eWait about a minute after signing in. The bots should load.\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003eIf you don’t see Sign out in that menu, right-click the Grok Bot icon in the system tray, choose Quit, reopen the app, and try again. You don’t need Recover computer or Reset here. The computer itself is fine.\u003c/p\u003e\n\u003cp\u003eLet me know if it still won’t connect after you sign in again.\u003c/p\u003e","post_number":7,"topic_id":170438,"url":"/t/grokbot-fails-after-update-cant-reach-your-computer/170438/7","accepter_name":"","accepter_username":"_Remi"}],"has_accepted_answer":true,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":135741,"username":"_Remi","name":"","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/_/a9adbd/{size}.png","post_count":2,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":0},{"id":750,"username":"deanrie","name":"Dean Rie","avatar_template":"/user_avatar/forum.cursor.com/deanrie/{size}/1263_2.png","post_count":1,"primary_group_name":"CursorStaff","flair_name":"CursorStaff","flair_url":"https://us1.discourse-cdn.com/cursor1/original/3X/a/d/ad08adc640929ae1e98be69dab1ad0844cee99a0.png","flair_color":"","flair_bg_color":"","flair_group_id":42,"admin":true,"moderator":true,"trust_level":4}],"created_by":{"id":135741,"username":"_Remi","name":"","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/_/a9adbd/{size}.png"},"last_poster":{"id":135741,"username":"_Remi","name":"","avatar_template":"https://avatars.discourse-cdn.com/v4/letter/_/a9adbd/{size}.png"}},"bookmarks":[]}